# smallest - design d180351903 of forth-vm-evolution. Generated by lab/evolve/export-designs.py; do not edit.
# `make` builds ./forth (8-byte cells, x86-64 Linux - the build the lab measured, no C library: its own
# runtime, src/rt-linux-*.c); `make forth32` the 4-byte-cell engine (needs 32-bit support: gcc-multilib);
# `make forth-libc` the same design with the C library, for any other host (not the JIT designs: x86 code).
# Run: ./forth image.img   (or ./forth32 image32.img). Names are upper case; BYE leaves. `make tight`: the
# file exactly as measured (python3; the same loaded bytes, no section headers). Compiler and linker warnings
# `make forth-arm` 4-byte cells for 32-bit ARM Linux (ARMv7, hard float), no C library (srcarm/rt-linux-armv7.c): cross-built by clang and lld from any host - the bytes the Tegra ran. Run: ./forth-arm image32.img
CC32 = clang
# about attributes and an RWX segment are expected.

CC = clang
SRC = src/rt-linux-x86_64.c src/vm-fold-bodies.h src/vm-fold-table.h src/vm-ops10-table.h src/vm-super-bodies.h src/vm-super-table.h src/vm.c
SRC32 = src32/rt-linux-i386.c src32/rt-linux-x86_64.c src32/vm-fold-bodies.h src32/vm-fold-table.h src32/vm-ops10-table.h src32/vm-super-bodies.h src32/vm-super-table.h src32/vm.c
CCARM = clang --target=arm-linux-gnueabihf -march=armv7-a -mfloat-abi=hard -fuse-ld=lld
SRCARM = srcarm/rt-linux-armv7.c srcarm/rt-linux-x86_64.c srcarm/vm-fold-bodies.h srcarm/vm-fold-table.h srcarm/vm-ops10-table.h srcarm/vm-super-bodies.h srcarm/vm-super-table.h srcarm/vm.c

all: forth

forth: $(SRC)
	$(CC) -Oz -falign-functions=1 -falign-loops=1 -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=1 -DDSKEW=2048 -DFSYS=3 -DREGPIN=2 -DHOTCALLS=1 -DFBUFSZ=1024 -DOPS10=1 -DX_CMOVE=1 -DX_FILL=1 -DX_ZLTBR=1 -DSUPER=1 -o forth src/vm.c -fno-asynchronous-unwind-tables -static -no-pie -nostdlib -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wl,-N -Wl,-z,norelro -Wl,--build-id=none -DRTLIB=1 src/rt-linux-x86_64.c -lgcc -ffunction-sections -fdata-sections -Wl,--gc-sections

forth32: $(SRC32)
	$(CC32) -m32 -fno-pie -no-pie -Oz -falign-functions=1 -falign-loops=1 -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=1 -DDSKEW=2048 -DFSYS=3 -DREGPIN=2 -DHOTCALLS=1 -DFBUFSZ=1024 -DOPS10=1 -DX_CMOVE=1 -DX_FILL=1 -DX_ZLTBR=1 -DSUPER=1 -o forth32 src32/vm.c -fno-asynchronous-unwind-tables -static -no-pie -nostdlib -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wl,-N -Wl,-z,norelro -Wl,--build-id=none -DRTLIB=1 src32/rt-linux-i386.c -lgcc -ffunction-sections -fdata-sections -Wl,--gc-sections

forth-arm: $(SRCARM)
	$(CCARM) -Oz -falign-functions=1 -falign-loops=1 -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=1 -DDSKEW=2048 -DFSYS=3 -DREGPIN=2 -DHOTCALLS=1 -DFBUFSZ=1024 -DOPS10=1 -DX_CMOVE=1 -DX_FILL=1 -DX_ZLTBR=1 -DSUPER=1 -o forth-arm srcarm/vm.c -fno-asynchronous-unwind-tables -static -no-pie -nostdlib -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wl,-N -Wl,-z,norelro -Wl,--build-id=none -Wl,-u,raise -DRTLIB=1 srcarm/rt-linux-armv7.c -lgcc -ffunction-sections -fdata-sections -Wl,--gc-sections

forth-libc: $(SRC)
	$(CC) -Oz -falign-functions=1 -falign-loops=1 -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=1 -DDSKEW=2048 -DFSYS=3 -DREGPIN=2 -DHOTCALLS=1 -DFBUFSZ=1024 -DOPS10=1 -DX_CMOVE=1 -DX_FILL=1 -DX_ZLTBR=1 -DSUPER=1 -o forth-libc src/vm.c -fno-asynchronous-unwind-tables

tight: forth
	python3 ../elf_tight.py forth   # optional: the file exactly as measured - no section headers or symbols

run: forth
	./forth image.img

clean:
	rm -f forth forth32 forth-arm forth-libc forth.tight

.PHONY: all tight run clean
