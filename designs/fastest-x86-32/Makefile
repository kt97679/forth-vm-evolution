# fastest-x86-32 - design 4ef851fd8e of forth-vm-evolution. Generated by lab/evolve/export-designs.py; do not edit.
# `make` builds ./forth (8-byte cells, x86-64 Linux - the build the lab measured, no C library: its own
# runtime, src/rt-linux-*.c); `make forth32` the 4-byte-cell engine (needs 32-bit support: gcc-multilib);
# `make forth-libc` the same design with the C library, for any other host (not the JIT designs: x86 code).
# Run: ./forth image.img   (or ./forth32 image32.img). Names are upper case; BYE leaves. `make tight`: the
# file exactly as measured (python3; the same loaded bytes, no section headers). Compiler and linker warnings
CC32 = clang
# about attributes and an RWX segment are expected.

CC = clang
SRC = src/jit.c src/rt-linux-x86_64.c src/spn-abi.h src/spn-markers.c src/spn-stencils.c src/vm-fold-bodies.h src/vm-fold-table.h src/vm-jit-ops.h src/vm-ops10-esc.h src/vm-ops10-table.h src/vm-tag2-esc.h src/vm-tag2-one.h src/vm.c
SRC32 = src32/jit.c src32/rt-linux-i386.c src32/rt-linux-x86_64.c src32/spn-abi.h src32/spn-markers.c src32/spn-stencils.c src32/vm-fold-bodies.h src32/vm-fold-table.h src32/vm-jit-ops.h src32/vm-ops10-esc.h src32/vm-ops10-table.h src32/vm-tag2-esc.h src32/vm-tag2-one.h src32/vm.c

all: forth

forth: $(SRC)
	$(CC) -O3 -fcf-protection=none -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=0 -DFSYS=2 -DSPEC=1 -DTAG2=1 -DT2WIDE=1 -DX_JIT=1 -DBFIND=1 -DJITX=1 -DJITLOOP=1 -DJITINL=1 -DJITMUL=1 -DJITFUSE=1 -DJITTAIL=1 -DESCAPE=2 -DOPS10=1 -DX_FILL=1 -DX_FIND=1 -DX_HASH=1 -DX_NUMBERQ=1 -DX_PARSE=1 -DX_PLACE=1 -DX_SCAN=1 -DX_SKIP=1 -DX_SWAPADDI=1 -DX_TONUMBER=1 -o forth src/vm.c -I src -I src src/spn-stencils.c src/spn-markers.c -fno-asynchronous-unwind-tables -static -no-pie -nostdlib -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wl,-N -Wl,-z,norelro -Wl,--build-id=none -DRTLIB=1 src/rt-linux-x86_64.c -lgcc -ffunction-sections -fdata-sections -Wl,--gc-sections

forth32: $(SRC32)
	$(CC32) -m32 -fno-pie -no-pie -O3 -fcf-protection=none -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=0 -DFSYS=2 -DSPEC=1 -DTAG2=1 -DT2WIDE=1 -DX_JIT=1 -DBFIND=1 -DJITX=1 -DJITLOOP=1 -DJITINL=1 -DJITMUL=1 -DJITFUSE=1 -DJITTAIL=1 -DESCAPE=2 -DOPS10=1 -DX_FILL=1 -DX_FIND=1 -DX_HASH=1 -DX_NUMBERQ=1 -DX_PARSE=1 -DX_PLACE=1 -DX_SCAN=1 -DX_SKIP=1 -DX_SWAPADDI=1 -DX_TONUMBER=1 -o forth32 src32/vm.c -I src32 -I src32 src32/spn-stencils.c src32/spn-markers.c -fno-asynchronous-unwind-tables -static -no-pie -nostdlib -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wl,-N -Wl,-z,norelro -Wl,--build-id=none -DRTLIB=1 src32/rt-linux-i386.c -lgcc -ffunction-sections -fdata-sections -Wl,--gc-sections

forth-libc: $(SRC)
	$(CC) -O3 -fcf-protection=none -DENC=3 -DREG=1 -DFOLD=1 -DSCALE=0 -DVARSLOT=0 -DFSYS=2 -DSPEC=1 -DTAG2=1 -DT2WIDE=1 -DX_JIT=1 -DBFIND=1 -DJITX=1 -DJITLOOP=1 -DJITINL=1 -DJITMUL=1 -DJITFUSE=1 -DJITTAIL=1 -DESCAPE=2 -DOPS10=1 -DX_FILL=1 -DX_FIND=1 -DX_HASH=1 -DX_NUMBERQ=1 -DX_PARSE=1 -DX_PLACE=1 -DX_SCAN=1 -DX_SKIP=1 -DX_SWAPADDI=1 -DX_TONUMBER=1 -o forth-libc src/vm.c -I src -I src src/spn-stencils.c src/spn-markers.c -fno-asynchronous-unwind-tables

tight: forth
	python3 ../elf_tight.py forth   # optional: the file exactly as measured - no section headers or symbols

run: forth
	./forth image.img

clean:
	rm -f forth forth32 forth-libc forth.tight

.PHONY: all tight run clean
