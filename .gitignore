build/
*.o

# RESULTS.md is GENERATED by tools/collect-results.sh and is different on
# every machine, so it is not tracked - it would conflict on every pull.
# To publish a particular run, save it under a name that says where it
# came from:
#     tools/collect-results.sh report --save results/ryzen-8840hs.md
# Those are tracked; the working copy is not.
RESULTS.md

# Interpreter caches: regenerated per machine and Python version
# (prompts/07-git-handoff). Importing the evolver (scan.py) makes them.
__pycache__/
*.py[co]

# What a background run leaves at the top: nohup's output, and the
# evolution logs RUNNING.md writes there (evolve.log, evolve2.log).
/nohup.out
/evolve*.log
# And what RUNNING.md's commands wrote at the top before Iteration 16 (now
# under build/evolve/), and lscpu's output for sending back. A run's
# records live in build/ or runs/, never in git;
# lab/evolve/next-run.sh moves anything untracked at the top there.
/sample*.md
/knockout*.md
/lscpu*.txt

# Editor and patch debris, and a core dump at the top (anchored: a bare
# `core` also matched tests/core/, three tracked test files).
*~
.*.swp
*.orig
*.rej
/core

# The runs directory (Iteration 84 - the owner: all development in one
# place, not ~/forth-vm-evolution-runs): logs, archived records, and the
# pack tarballs to send back. lab/evolve/next-run.sh writes it and cleans
# it (tools/clean-runs.sh). In the clone, never in git.
/runs/
