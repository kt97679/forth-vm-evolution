+    (void)b;
     struct sigaction sa;
     stack_t ss;
     ss.ss_sp = g_altstack; ss.ss_size = sizeof g_altstack; ss.ss_flags = 0;
@@ -748,6 +773,11 @@ static void load_image(const char *name) {
             hot_tab[i] = b_[0] | (UNS64)b_[1] << 8;
