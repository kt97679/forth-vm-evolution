index 0000000..ef0a1ce
--- /dev/null
+++ b/tools/arm-cross-check.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""tools/arm-cross-check.py RESULTS.md [--n K] [--ids ID,...] [--gcc CC] - the ARM engines checked here (Iteration 570).
+
+The designs of a front (RESULTS.md's {"bin" lines) that the Tegra can be sent from the laptop - cv8, clang, no JIT -
+cross-built for ARMv7 by evolve.py's own build at 4-byte cells (EVOLVE_TARGET=armv7: clang, lld,
+engine/rt-linux-armv7.c - no C library). The ARM engine must pass evolve.alive under qemu-arm - the corpus, the kernel,
+far, full - and give a 32-bit x86 engine's output on fib and apps (the first design's, built as the laptop builds its
+4-byte engines: a correct design's output is every design's). qemu runs outside evolve.py's jail (it starts a
+thread), so only on designs the laptop already ran. --n K: K of them spread evenly by speed, the fastest and the
+slowest among them. Prints a line a design and the totals: built, alive, identical, the engines' sizes.
+
+--gcc CC (the Tegra's side, simulated): the GCC designs instead - the hand-made stages (s6 among them; cell, cpt16
+and the like: relf.c and build_other), then the front's without clang and the JIT - built by CC (arm-linux-gnueabihf-gcc) as on an ARM host (evolve.ARM32): the ARM runtime, and the ARM
+build of a GCC design, which the laptop never makes. Needs gcc-arm-linux-gnueabihf, which removes gcc-multilib:
+its x86 reference comes from a run before (/tmp/arm-cross-x86.json, written by a run without --gcc - so run
+without --gcc first, at the same commit).
+
+Needs `CROSS=1 sh tools/setup-sandbox.sh` (lld, qemu-user, libc6-dev-armhf-cross, libgcc-13-dev-armhf-cross).
+"""
+import json, os, shutil, subprocess, sys
+A = sys.argv[1:]
+def opt(name, default=None):
+    if name not in A: return default
+    i = A.index(name); v = A[i + 1]; del A[i:i + 2]; return v
+n = int(opt('--n', '0')); ids = [x for x in (opt('--ids') or '').split(',') if x]; gcc = opt('--gcc')
+if len(A) != 1: sys.exit(__doc__)
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+os.environ['EVOLVE_CELL'] = '4'; os.environ.setdefault('EVOLVE_CC', 'gcc -m32 -fno-pie -no-pie')
+if gcc: os.environ['EVOLVE_CC'] = gcc
+sys.argv = ['x']; sys.path.insert(0, os.path.join(ROOT, 'lab', 'evolve')); import evolve as E
+if gcc: E.ARM32 = True                             # as on the Tegra: ccflags drops alignhot, rt() is ARM's
+E.setup()
+REF = '/tmp/arm-cross-x86.json'
+
+_sh = E.sh
+def qsh(cmd, cwd=None, inp=None, timeout=300, env=None, cpu=60):
+    """evolve.sh, an ARM engine run under qemu-arm and outside the jail - its wall-clock limit 4x."""
+    if cmd and str(cmd[0]).endswith('/engine') and '/arm-' in str(cmd[0]):
+        return subprocess.run(['qemu-arm'] + list(cmd), cwd=cwd, input=inp, capture_output=True, timeout=4 * timeout)
+    return _sh(cmd, cwd=cwd, inp=inp, timeout=timeout, env=env, cpu=cpu)
+E.sh = qsh
+
+recs = [json.loads(l) for l in open(A[0]) if l.startswith('{"bin"')]
+if gcc:
+    pick = [{'id': k, 'genome': v, 'speed': 0} for k, v in sorted(E.HUMAN.items()) if not E.express(E.canon(v)).get('jit')] + [r for r in recs if not E.express(E.canon(r['genome'])).get('compiler')
+            and not E.express(E.canon(r['genome'])).get('jit')]
+else:
+    pick = [r for r in recs if r['genome'].get('enc', 'cv8') == 'cv8' and E.express(E.canon(r['genome'])).get('compiler')
+            and not E.express(E.canon(r['genome'])).get('jit')]
+pick.sort(key=lambda r: r.get('speed') or 9)
+if ids: pick = [r for r in pick if r['id'] in ids]
+if n and len(pick) > n: pick = [pick[int(j * (len(pick) - 1) / max(1, n - 1))] for j in range(n)]
+print('arm-cross-check: %d designs of %d (%s)' % (len(pick), len(recs), 'GCC, by ' + gcc if gcc else 'cv8, clang, no JIT'), flush=True)
+tot = dict(built=0, alive=0, same=0); sizes = []
+for k, r in enumerate(pick, 1):
+    g = E.canon(r['genome']); i = r['id']
+    if not gcc and k == 1:                           # the reference: the first design as a 32-bit x86 engine
+        dx = os.path.join(E.EV, 'x86-' + i)
+        try:
+            ex, ix = E.build(g, dx); px = E.private_work(dx)
+            out = {w: E.sh([ex, ix], cwd=px, inp=E.program(w), timeout=120, cpu=30).stdout.decode('latin-1') for w in ('fib', 'apps')}
+            json.dump(out, open(REF, 'w')); print('arm-cross-check: the x86-32 reference from %s (%d bytes)' % (i, os.path.getsize(ex)), flush=True)
+        except Exception as ex_:
+            sys.exit('arm-cross-check: %s x86-32: %s' % (i, str(ex_)[:80]))
+        shutil.rmtree(dx, ignore_errors=True)
+    if not os.path.exists(REF): sys.exit('arm-cross-check: no x86 reference (%s) - run without --gcc first' % REF)
+    out = json.load(open(REF)); da = os.path.join(E.EV, 'arm-' + i)
+    if not gcc: os.environ['EVOLVE_TARGET'] = 'armv7'
+    try: ea, ia = E.build(g, da)
+    except Exception as ex_: print('%3d %s ARM build: %s' % (k, i, str(ex_)[:100]), flush=True); continue
+    finally: os.environ.pop('EVOLVE_TARGET', None)
+    tot['built'] += 1; pa = E.private_work(da); sizes.append(os.path.getsize(ea))
+    try: E.alive(ea, ia, pa); tot['alive'] += 1; v = 'alive'
+    except Exception as ex_: v = 'DEAD (%s)' % str(ex_)[:60]
+    same = [w for w in ('fib', 'apps') if E.sh([ea, ia], cwd=pa, inp=E.program(w), timeout=120).stdout.decode('latin-1') == out[w]]
+    tot['same'] += len(same) == 2
+    print('%3d %s %-5s speed %.3f: ARM %d bytes, %s, fib+apps %s' % (k, i, g['enc'], r.get('speed') or 0, os.path.getsize(ea), v, 'IDENTICAL' if len(same) == 2 else 'DIFFER (%s same)' % ','.join(same) or 'none'), flush=True)
+    shutil.rmtree(da, ignore_errors=True)
