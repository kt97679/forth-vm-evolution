+\ far.fth - code and data far from the image base (Iteration 158). Words
+\ compiled past 64 KB take tag2's three-byte calls; past 8 MB more, its
+\ four-byte calls, beyond the reach of cv8's far form and its links. Line k
+\ prints k*100000 plus its answer. Each answer must be right; a missing one
+\ must be refused out loud ("out of reach") - nothing computed otherwise.
+VARIABLE V
+: NEAR ( x --- x' ) V @ EXECUTE ;
+65536 ALLOT
+: F1 ( n --- n' ) 1+ ;
+: FIB ( n --- f ) DUP 2 < IF EXIT THEN DUP 1- RECURSE SWAP 2 - RECURSE + ;
+: F2 ( n --- n' ) F1 F1 ;
+12 FIB 100000 + . CR
+5 F2 200000 + . CR
+: CONST CREATE , DOES> @ ;
+42 CONST K1
+K1 300000 + . CR
+' F2 V ! 10 NEAR 400000 + . CR
+8388608 ALLOT
+: G1 ( n --- n' ) 2 + ;
+: GFIB ( n --- f ) DUP 2 < IF EXIT THEN DUP 1- RECURSE SWAP 2 - RECURSE + ;
+: G2 ( n --- n' ) G1 G1 F2 ;
+CREATE BUF 4 CELLS ALLOT
+: G3 ( --- n ) 7 BUF ! BUF @ 1+ ;
+13 GFIB 500000 + . CR
+5 G2 600000 + . CR
+G3 700000 + . CR
+: CONST2 CREATE , DOES> @ 1+ ;
+43 CONST2 K2
+K2 800000 + . CR
+' G2 V ! 10 NEAR 900000 + . CR
diff --git a/tools/farcheck.py b/tools/farcheck.py
new file mode 100644
index 0000000..0510f59
--- /dev/null
+++ b/tools/farcheck.py
@@ -0,0 +1,18 @@
+"""tests/core/far.fth's verdict (Iteration 158): line k prints k*100000 plus its
+answer; every answer right, and any missing one refused out loud - never
+something else computed. Used by run-tests.sh and the evolution's gate."""
+import sys, re
+WANT = {1: 144, 2: 7, 3: 42, 4: 12, 5: 233, 6: 11, 7: 8, 8: 44, 9: 16}
+def verdict(out, code):
+    """'all' | 'refused N' | a failure - right or refused out loud, never else."""
+    out = out.replace('\r', ''); got = {}
+    for l in out.split('\n'):
+        if re.fullmatch(r'[0-9]+ ', l):
+            n = int(l); k, v = divmod(n, 100000)
+            if WANT.get(k) != v or k in got: return 'WRONG line %d: %d' % (k, v)
+            got[k] = v
+    if code not in (0,): return 'died (exit %s) after %d answers' % (code, len(got))
+    if len(got) == len(WANT): return 'all'
+    if re.search(r'out of reach|beyond', out): return 'refused %d of %d' % (len(WANT) - len(got), len(WANT))
+    return 'MISSING %d answers, no refusal' % (len(WANT) - len(got))
+if __name__ == '__main__': print(verdict(sys.stdin.read(), int(sys.argv[1])))
