+def machine():
+    """Iteration 701: what the machine was doing, beside each progress line - seed 94's stall (93 minutes at generation
+    44: runs timed out, compiles past cc's 60 s CPU limit, the 300 s ticks 25-70 s late) left no trace of why. The load,
+    the memory free and the swap used, the cores' mean clock, the hottest zone, AC or battery - each where Linux has it."""
+    import glob
+    def rd(p):
+        try:
+            with open(p) as f: return f.read()
+        except OSError: return None
+    out = []
+    l = rd('/proc/loadavg')
+    if l: out.append('load %s' % l.split()[0])
+    try:
+        m = {k: int(v.split()[0]) for k, v in (x.split(':', 1) for x in (rd('/proc/meminfo') or '').splitlines() if ':' in x)}
+        out.append('%.1f GB free, swap %.1f GB' % (m['MemAvailable'] / 1048576, (m['SwapTotal'] - m['SwapFree']) / 1048576))
+    except (KeyError, ValueError): pass
+    f = [int(x) for x in map(rd, glob.glob('/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq')) if x and x.strip().isdigit()]
+    if f: out.append('%.2f GHz' % (sum(f) / len(f) / 1e6))
+    t = [int(x) for x in map(rd, glob.glob('/sys/class/thermal/thermal_zone*/temp')) if x and x.strip().lstrip('-').isdigit()]
+    if t: out.append('%d C' % (max(t) // 1000))
+    for d in sorted(glob.glob('/sys/class/power_supply/*')):
+        if (rd(d + '/type') or '').strip() == 'Mains' and rd(d + '/online') is not None:
+            out.append('AC' if rd(d + '/online').strip() == '1' else 'battery'); break
+    return ', '.join(out)
+
