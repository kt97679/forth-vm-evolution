+        if _demoted: print('opcall: %d X;CALL written plain - their codes outside the base band' % _demoted)
     G['TAG2'][0] = T2MAP
     print('tag 2: %d operations, %d one-byte, %d escaped; %d escaped uses in the image (a byte each)'
