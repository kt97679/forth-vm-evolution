+    if G.get('OPCALL'):
+        _base = lambda L: L in T2MAP['one'] and T2MAP['one'][L] < 0x3F
+        _demoted = 0
+        for w in order:
+            if kind[w['s']] != 'code': continue
+            _o = info[w['s']]
+            for _j in range(len(_o)):
+                if _o[_j][0] == 'OC' and not _base(G['OPCALL'][_o[_j][1]]):
