diff --git a/forth/cv8t.4 b/forth/cv8t.4
index a29bf31..0e91b56 100644
--- a/forth/cv8t.4
+++ b/forth/cv8t.4
@@ -136,12 +136,45 @@ ALIGN
   LOOP 0 ;
 
 \ ---- calls ----------------------------------------------------------
+VARIABLE CV8-CALLREL-V ( --- a-addr )
+\ What a call's field holds - 0 the offset from the image base, 1 the
+\ distance from the byte after the call, 2 either, the low bit saying which
+\ (the gene callrel; the converter writes it - Iteration 164).
+0 CV8-CALLREL-V !
+VARIABLE CV8-T2WIDE-V ( --- a-addr )
+\ True under t2wide: no 3-byte call (the converter writes it).
+0 CV8-T2WIDE-V !
+: T2CALL! ( field k --- )
+\ A call of k more bytes after the first, its field cut to 6+8k bits.
+  >R 1 R@ 3 LSHIFT 6 + LSHIFT 1- AND R>
+  2DUP 3 LSHIFT RSHIFT OVER 6 LSHIFT OR C,
+  BEGIN DUP WHILE 1- 2DUP 3 LSHIFT RSHIFT 255 AND C, REPEAT 2DROP ;
+: T2FIT? ( d bits --- f )
+\ -2^(bits-1) <= d < 2^(bits-1)
+  1- 1 SWAP LSHIFT DUP >R + R> 2* U< ;
+: T2CALL-REL ( a-addr --- )
+\ The first form - 2, 3 or 4 bytes - that holds the call: by distance from
+\ the byte after it (1), or (2) the base offset when that is as short, else
+\ the distance, the low bit saying which.
+  4 1 DO I 2 = CV8-T2WIDE-V @ AND 0= IF
+    CV8-CALLREL-V @ 2 = IF
+      DUP START @ - DUP 1 I 3 LSHIFT 5 + LSHIFT U< IF 2* SWAP DROP I T2CALL! UNLOOP EXIT THEN DROP
+      DUP HERE I + 1+ - DUP I 3 LSHIFT 5 + T2FIT? IF 2* 1 OR SWAP DROP I T2CALL! UNLOOP EXIT THEN DROP
+    ELSE
+      DUP HERE I + 1+ - DUP I 3 LSHIFT 6 + T2FIT? IF SWAP DROP I T2CALL! UNLOOP EXIT THEN DROP
+    THEN
+  THEN LOOP -1 ABORT" call out of reach" ;
+VARIABLE CALLREL-XT ( --- a-addr )
+\ 0, or the offset of T2CALL-REL: the converter writes it for a design with
+\ the gene callrel and leaves the encoder out of every other (Iteration 167).
+0 CALLREL-XT !
 : CALL, ( a-addr --- )
 \ Append a call to the body at a-addr: its byte offset from the image base
 \ in the shortest form that reaches - 01 + 14 bits, 10 + 22, 11 + 30: k
 \ more bytes after the first, the first holding k and the top bits. The
 \ engine holds at most 1 GB (vm-lab.c, TAG2), so every offset fits.
   0 LAST-OP !
+  CALLREL-XT @ ?DUP IF START @ + EXECUTE EXIT THEN
   START @ -  DUP 16384 < IF 1 ELSE DUP 4194304 < IF 2 ELSE 3 THEN THEN   ( v k )
   2DUP 3 LSHIFT RSHIFT OVER 6 LSHIFT OR C,
   BEGIN DUP WHILE 1- 2DUP 3 LSHIFT RSHIFT 255 AND C, REPEAT 2DROP ;
@@ -299,6 +332,7 @@ VARIABLE LOOP-ALIGN ( --- a-addr )
   \ tag 2: always the 4-byte form, 11 + 30 bits, high byte first, in the 4
   \ bytes CREATE reserved (the engine's DODOES reads exactly that)
   START @ -                         ( a-addr v )
+  CALLREL-XT @ IF 2* THEN                            \ the gene callrel: the base form, its low bit 0 (Iteration 167)
   2DUP 255 AND SWAP 3 + C!
   2DUP 8 RSHIFT 255 AND SWAP 2 + C!
   2DUP 16 RSHIFT 255 AND SWAP 1+ C!
