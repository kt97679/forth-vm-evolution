\ file-sysc3.4 - with file-sysc.4 and file-sysc2.4, the terminal and line
\ words over SYSCALL: WRITE, READ, READ-LINE, BYE (Iteration 206, fsys 3 -
\ the single-SYSCALL family, stage B). The owner: no buffer for output, and no
\ read-ahead from stdin, pipes or anything else that cannot seek - bytes read
\ past the line there are gone for good. So WRITE is one write(2) a call (EMIT
\ one a character); READ is the engine's t_read (a seekable stdin: a block,
\ the rest after the line given back by lseek(2); otherwise a byte at a time,
\ up to an editing character); READ-LINE reads into the caller's own buffer
\ and seeks back after the line on a file that can seek, a byte at a time on
\ one that cannot - no state kept between calls. The kernel's compiled uses
\ (EMIT, TYPE, KEY, ACCEPT, REFILL, INCLUDE-FILE) are rebound to these by the
\ converter. NIP and TUCK written out: the cell system has neither.

: WRITE ( c-addr u --- )  1 FS-WRITE DROP ;      \ stdout, all of it
: BYE ( --- )  0 60 FS1 ;                        \ exit(2); SYSCALL flushes first

VARIABLE FS-P                                    \ the buffer being read into
: FS-EDIT? ( c --- f )  DUP 10 = OVER 13 = OR OVER 8 = OR SWAP 127 = OR ;
\ Iteration 208: whether a file can seek, remembered for descriptors 0-63 -
\ two cells of bits, known and seekable; OPEN-FILE and CLOSE-FILE forget a
\ descriptor, whose number is used again. READ-LINE's lseek(2) a line gone.
CREATE FS-SK 0 , 0 ,
: FS-BIT ( fid --- mask )  1 SWAP LSHIFT ;
: FS-SEEKS? ( fid --- f )                        \ lseek(fid, 0, SEEK_CUR) works - asked once
  DUP 64 U< 0= IF 0 1 8 FS3 0< 0= EXIT THEN
  DUP FS-BIT FS-SK @ AND IF FS-BIT FS-SK CELL+ @ AND 0= 0= EXIT THEN
  DUP 0 1 8 FS3 0< 0= DUP IF OVER FS-BIT FS-SK CELL+ @ OR FS-SK CELL+ ! THEN
  SWAP FS-BIT FS-SK @ OR FS-SK ! ;
: FS-FORGET ( fid --- )
  DUP 64 U< IF FS-BIT INVERT DUP FS-SK @ AND FS-SK ! FS-SK CELL+ @ AND FS-SK CELL+ ! ELSE DROP THEN ;
: OPEN-FILE ( c-addr u fam --- fid ior )  OPEN-FILE OVER FS-FORGET ;
: CLOSE-FILE ( fid --- ior )  DUP FS-FORGET CLOSE-FILE ;
: FS-BACK ( fid got k --- k )                    \ the bytes read past k given back
  2DUP > IF 2DUP - NEGATE >R ROT R> 1 8 FS3 DROP SWAP DROP ELSE SWAP DROP SWAP DROP THEN ;

: FS-UPTO-EDIT ( got --- k )                     \ just past the first editing character, or got
  0 BEGIN 2DUP > WHILE
    DUP FS-P @ + C@ FS-EDIT? IF 1+ SWAP DROP EXIT THEN 1+
  REPEAT DROP ;
: READ ( c-addr u --- u2 )                       \ what input there is, 0 at its end
  DUP 0= IF SWAP DROP EXIT THEN
  OVER FS-P !
  0 FS-SEEKS? IF                                 \ Iteration 226: asked once, as for any file - FS-SEEK0 went
    0 ROT ROT 0 FS3 DUP 0> 0= IF DROP 0 EXIT THEN
    0 SWAP DUP FS-UPTO-EDIT FS-BACK EXIT
  THEN
  SWAP DROP 0                                    ( u k )
  BEGIN 2DUP > WHILE
    0 FS-P @ 2 PICK + 1 0 FS3 1 = 0= IF SWAP DROP EXIT THEN
    DUP FS-P @ + C@ SWAP 1+ SWAP FS-EDIT? IF SWAP DROP EXIT THEN
  REPEAT SWAP DROP ;

VARIABLE FS-ANY                                  \ READ-LINE: a character read
: FS-LF ( got --- k )                            \ the first LF's place in FS-P's bytes, or got
  FS-P @ OVER 10 SCAN SWAP DROP - ;              \ Iteration 208: SCAN - native under kinput - not a loop here
: FS-CR ( u --- u' )                             \ a trailing CR is the line's end too
  DUP IF DUP 1- FS-P @ + C@ 13 = IF 1- THEN THEN ;
: READ-LINE ( c-addr u1 fid --- u2 flag ior )
  OVER 0= IF DROP 2DROP 0 -1 0 EXIT THEN         \ zero characters: not the end of the file
  >R OVER FS-P ! 0 FS-ANY !
  R@ FS-SEEKS? IF                                ( c u1 )
    R@ ROT ROT 0 FS3                             ( got )
    DUP 0< IF DROP R> DROP 0 0 -200 EXIT THEN
    DUP 0> IF -1 FS-ANY ! THEN
    DUP FS-LF                                    ( got k )
    2DUP > IF 1+ R> ROT ROT FS-BACK 1- ELSE SWAP DROP R> DROP THEN
    FS-CR FS-ANY @ 0 EXIT
  THEN
  SWAP DROP 0                                    ( u1 k )
  BEGIN 2DUP > WHILE
    R@ FS-P @ 2 PICK + 1 0 FS3                   ( u1 k n )
    DUP 0< IF DROP 2DROP R> DROP 0 0 -200 EXIT THEN
    0= IF SWAP DROP R> DROP FS-CR FS-ANY @ 0 EXIT THEN
    -1 FS-ANY !
    DUP FS-P @ + C@ 10 = IF SWAP DROP R> DROP FS-CR -1 0 EXIT THEN
    1+
  REPEAT SWAP DROP R> DROP FS-CR FS-ANY @ 0 ;
