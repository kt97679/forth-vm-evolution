\ file-sysc5.4 - fsys 5: fsys 4 with READ-LINE reading ahead where the file
\ can seek (Iteration 211). The owner's rule: no read-ahead from stdin, pipes
\ or anything else that cannot seek - bytes read past the line there are gone;
\ where a file can seek they can be given back. So a seekable descriptor (1-63,
\ never 0) reads 4 KB at a time into a buffer on the heap, as the native
\ engine's t_fgetc did, and every other use of the file first gives back what
\ was read ahead - lseek(2) by the unread count, as t_fdrop did: READ-FILE,
\ REPOSITION-FILE, FILE-POSITION, FILE-SIZE, WRITE-FILE, WRITE-LINE and
\ CLOSE-FILE are wrapped so; OPEN-FILE clears a number used again. The state
\ is on the heap too - a table of [next, end, buffer] for 64 descriptors, made
\ on first use; the dictionary holds its address alone. Iteration 214: next
\ and end are addresses, equal when nothing is read ahead; a line already in
\ the buffer is taken at once, the rest goes the general way.

CREATE FS-RT 0 ,                                 \ the table's address, 0 until first used
4096 CONSTANT FS-RSIZE
: FS-RE ( fid --- a-addr )  [ 3 CELLS ] LITERAL * FS-RT @ + ;   \ the descriptor's [next, end, buffer]
: FS-RESET ( fid --- )                           \ nothing read ahead
  DUP 1- 63 U< FS-RT @ AND IF FS-RE 0 0 ROT 2! ELSE DROP THEN ;
: FS-GIVEBACK ( fid --- )                        \ what was read ahead, given back
  DUP 1- 63 U< FS-RT @ AND 0= IF DROP EXIT THEN
  DUP FS-RE 2@ SWAP -                            ( fid next-end )
  ?DUP IF OVER SWAP 1 8 FS3 DROP THEN            \ lseek(fid, next-end, SEEK_CUR)
  FS-RESET ;
: READ-FILE ( c-addr u1 fid --- u2 ior )  DUP FS-GIVEBACK READ-FILE ;
: REPOSITION-FILE ( ud fid --- ior )  DUP FS-GIVEBACK REPOSITION-FILE ;
: FILE-POSITION ( fid --- ud ior )  DUP FS-GIVEBACK FILE-POSITION ;
: FILE-SIZE ( fid --- ud ior )  DUP FS-GIVEBACK FILE-SIZE ;
: WRITE-FILE ( c-addr u fid --- ior )  DUP FS-GIVEBACK WRITE-FILE ;
: WRITE-LINE ( c-addr u fid --- ior )  DUP FS-GIVEBACK WRITE-LINE ;
: CLOSE-FILE ( fid --- ior )  DUP FS-GIVEBACK CLOSE-FILE ;
: OPEN-FILE ( c-addr u fam --- fid ior )  OPEN-FILE OVER FS-RESET ;

VARIABLE FS-E  VARIABLE FS-LIM                   \ READ-LINE's entry; the end of its caller's buffer
: FS-FILL ( fid --- n )                          \ the buffer refilled: what came, 0 at the end, <0 an error
  FS-E @ 2 CELLS + DUP @ 0= IF FS-RSIZE FS-MMAP OVER ! THEN @   ( fid buf )
  SWAP OVER FS-RSIZE 0 FS3                       ( buf n )   \ read(fid, buf, 4 KB)
  DUP 0> IF 2DUP + ROT FS-E @ 2! ELSE SWAP DROP THEN ;
: FS-MOVE ( src dst u --- )                      \ CMOVE a cell at a time, the rest by CMOVE: never overlapping here
  BEGIN [ 1 CELLS 1- ] LITERAL OVER U< WHILE
    >R OVER @ OVER ! [ 1 CELLS ] LITERAL DUP D+ R> [ -1 CELLS ] LITERAL +
  REPEAT CMOVE ;
: FS-TAKE ( c --- c' f )                         \ from the buffer to c, up to an LF or FS-LIM: f true when an LF ended the line
  DUP FS-LIM @ SWAP -  FS-E @ 2@ SWAP OVER -  ROT MIN    ( c next w )
  OVER SWAP 10 SCAN                              ( c next a r )
  >R OVER - >R  OVER R@ FS-MOVE  R@ +              ( c' ) ( R: r k )
  R> R> IF 1+ -1 ELSE 0 THEN  SWAP FS-E @ +! ;   \ the entry's next moved on, past an LF taken
: READ-LINE ( c-addr u1 fid --- u2 flag ior )
  DUP 1- 63 U< FS-RT @ AND IF                     \ the line may be read ahead already
    DUP FS-RE >R  OVER R@ 2@ SWAP OVER - ROT MIN  ( c u1 fid next w ) ( R: e )
    2DUP 10 SCAN IF                               \ its LF there, within u1: taken at once
      SWAP DROP OVER -  2DUP + 1+ R> !            ( c u1 fid next k )  \ next: past the LF
      DUP IF 2DUP + 1- C@ 13 = IF 1- THEN THEN    \ a CR before the LF ends the line too
      >R >R 2DROP R> SWAP R@ FS-MOVE R> -1 0 EXIT
    THEN 2DROP DROP R> DROP
  THEN
  DUP 1- 63 U< 0= IF READ-LINE EXIT THEN          \ stdin, or past the table: as fsys 3
  FS-RT @ 0= IF FS-RSIZE FS-MMAP FS-RT ! THEN     \ the table, made on first use
  DUP FS-RE DUP 2@ = IF                           \ nothing read ahead: can the file seek?
    OVER FS-SEEKS? 0= IF DROP READ-LINE EXIT THEN \ no: as fsys 3, no read-ahead
  THEN
  FS-E ! >R  OVER FS-P !  OVER + FS-LIM !         ( c ) ( R: fid )
  BEGIN
    DUP FS-LIM @ = IF -1 0 -1 ELSE                \ the caller's buffer full: the line goes on next time
      FS-E @ 2@ = IF R@ FS-FILL ELSE 1 THEN       \ the buffer empty: refilled
      DUP 1 < IF 0< IF -200 ELSE 0 THEN OVER FS-P @ = 0= SWAP -1   \ the end of the file, or an error
      ELSE DROP FS-TAKE IF -1 0 -1 ELSE 0 THEN THEN
    THEN
  UNTIL                                           ( c flag ior )
  R> DROP ROT FS-P @ - FS-CR ROT ROT ;
