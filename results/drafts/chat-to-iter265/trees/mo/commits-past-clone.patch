Subject: [PATCH 1/5] scratch: faulttrap

---
 engine/rt-linux-i386.c   |  6 ++++++
 engine/rt-linux-x86_64.c |  9 +++++++++
 engine/vm-lab.c          | 34 ++++++++++++++++++++++++++++++++++
 lab/evolve/evolve.py     |  2 +-
 tools/engine-rt.sh       |  4 ++--
 5 files changed, 52 insertions(+), 3 deletions(-)

diff --git a/engine/rt-linux-i386.c b/engine/rt-linux-i386.c
index 3ab77bd..c705981 100644
--- a/engine/rt-linux-i386.c
+++ b/engine/rt-linux-i386.c
@@ -112,6 +112,12 @@ __asm__(".text\n.globl rt_restorer\n.type rt_restorer,@function\nrt_restorer:\n"
 void rt_restorer(void);
 struct k_sigaction { void *handler; unsigned long flags; void *restorer; unsigned long mask[2]; };
 int sigemptyset(sigset_t *s) { unsigned char *p = (unsigned char *)s; for (size_t i = 0; i < sizeof *s; i++) p[i] = 0; return 0; }
+/* Iteration 252: the fault handler's installation in the fewest bytes (see
+ * rt-linux-x86_64.c); i386's rt_sigaction is 174. */
+void rt_fault(void (*h)(int)) {
+    struct k_sigaction k = { (void *)h, 0x04000000UL, (void *)rt_restorer, { 0, 0 } };
+    sc(174, 11, (long)&k, 0, 8, 0, 0);
+}
 int sigaction(int sig, const struct sigaction *restrict act, struct sigaction *restrict old)
 {
     struct k_sigaction k, ko;
diff --git a/engine/rt-linux-x86_64.c b/engine/rt-linux-x86_64.c
index d063875..e5189fe 100644
--- a/engine/rt-linux-x86_64.c
+++ b/engine/rt-linux-x86_64.c
@@ -146,6 +146,15 @@ int sigaction(int sig, const struct sigaction *restrict act, struct sigaction *r
     }
     return (int)r;
 }
+/* Iteration 252: the fault handler's installation in the fewest bytes - the
+ * kernel's struct filled in place, no old action, no mask, SIGSEGV alone (the
+ * engine maps no file, so no SIGBUS). The restorer stays: x86-64 delivers no
+ * signal without SA_RESTORER, though the handler (vm-lab.c's fault_trap)
+ * never returns. */
+void rt_fault(void (*h)(int)) {
+    struct k_sigaction k = { (void *)h, 0x04000000UL, (void *)rt_restorer, 0 };
+    sc(13, 11, (long)&k, 0, 8, 0, 0);
+}
 /* Iteration 119: the stack guard's handler runs on its own stack (a C-stack
  * overflow - the JIT's native recursion - leaves it none) */
 int sigaltstack(const stack_t *restrict ss, stack_t *restrict old) { return (int)ok(sc(131, (long)ss, (long)old, 0, 0, 0, 0)); }
diff --git a/engine/vm-lab.c b/engine/vm-lab.c
index 0a70704..00f2828 100644
--- a/engine/vm-lab.c
+++ b/engine/vm-lab.c
@@ -618,6 +618,39 @@ static void install_guards(UNS8 *b) {
 }
 #endif
 
+#if !GUARD
+/*  Iteration 252: a fault handler in every engine, not only the guard gene's.
+ *  A runaway pointer (0 @) killed 114 of seed 46's 127 front designs with a
+ *  bare SIGSEGV, and those whose output waited in a buffer for a pipe or a
+ *  file lost it. This one flushes it (t_flush: the engine's buffer and, at
+ *  fsys 4-5, the Forth side's), reports, and exits 70 as guard_trap does; the
+ *  guard gene adds the guard pages, the handler's own stack, and the messages
+ *  that say which stack.  */
+static void t_flush(void);
+static void fault_trap(int sig) {
+    (void)sig;
+    t_flush();
+    write_str(2, "relf: segmentation fault\n");
+    exit(70);
+}
+#if RTLIB
+/*  Without the C library (engine/rt-linux-*.c): the runtime's rt_fault fills the
+ *  kernel's struct itself - sigaction's general conversion cost ~300 bytes.  */
+void rt_fault(void (*h)(int));
+#define install_fault_trap() rt_fault(fault_trap)
+#else
+#include <signal.h>
+static void install_fault_trap(void) {
+    struct sigaction sa;
+    sa.sa_handler = fault_trap;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGSEGV, &sa, (struct sigaction *)0);
+    sigaction(SIGBUS, &sa, (struct sigaction *)0);
+}
+#endif
+#endif
+
 static void stack_fault(int which) {
     write_str(2, which ? "relf: return stack overflow\n"
                        : "relf: data stack overflow\n");
@@ -2561,6 +2594,7 @@ int main(int argc, char **argv) {
                                     the guard ("Stack error DROP"); only a
                                     runaway one reaches the guard page */
 #else
+    install_fault_trap();
     g_dsp = STK_END - RSTACK_BYTES - CELL_BYTES - DSKEW;
 #endif
     g_rp_limit  = STK_END - RSTACK_BYTES;
diff --git a/lab/evolve/evolve.py b/lab/evolve/evolve.py
index c515629..c8f84f6 100644
--- a/lab/evolve/evolve.py
+++ b/lab/evolve/evolve.py
@@ -533,7 +533,7 @@ def rt():
     # static engine has no dynamic relocations, and their padding made the
