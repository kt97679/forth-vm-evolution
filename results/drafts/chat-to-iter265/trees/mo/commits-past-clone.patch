                  '-ffunction-sections', '-fdata-sections', '-Wl,--gc-sections']
     # --gc-sections (Iteration 113): the runtime is one object file, so code
     # nothing calls came along - vsnprintf, snprintf, execvp, syscall,
diff --git a/tools/engine-rt.sh b/tools/engine-rt.sh
index ff4da75..ebe27fb 100644
--- a/tools/engine-rt.sh
+++ b/tools/engine-rt.sh
@@ -18,8 +18,8 @@ case "${ENGINE_RT:-nolibc}" in
         if [ "$(uname -s)-$(uname -m)" = Linux-x86_64 ]; then
             RT_FLAGS="-static -no-pie -nostdlib -fno-stack-protector"
