 create mode 100644 forth/file-sysc5.4

diff --git a/forth/file-sysc5.4 b/forth/file-sysc5.4
new file mode 100644
index 0000000..0c3382e
--- /dev/null
+++ b/forth/file-sysc5.4
@@ -0,0 +1,59 @@
+\ file-sysc5.4 - fsys 5: fsys 4 with READ-LINE reading ahead where the file
+\ can seek (Iteration 211). The owner's rule: no read-ahead from stdin, pipes
+\ or anything else that cannot seek - bytes read past the line there are gone;
+\ where a file can seek they can be given back. So a seekable descriptor (1-63,
+\ never 0) reads 4 KB at a time into a buffer on the heap, as the native
+\ engine's t_fgetc did, and every other use of the file first gives back what
+\ was read ahead - lseek(2) by the unread count, as t_fdrop did: READ-FILE,
+\ REPOSITION-FILE, FILE-POSITION, FILE-SIZE, WRITE-FILE, WRITE-LINE and
+\ CLOSE-FILE are wrapped so; OPEN-FILE clears a number used again. The state
+\ is on the heap too - a table of [buffer, position, length] for 64
+\ descriptors, made on first use; the dictionary holds its address alone.
+
+CREATE FS-RT 0 ,                                 \ the table's address, 0 until first used
+4096 CONSTANT FS-RSIZE
+: FS-RE ( fid --- a-addr )                       \ the descriptor's [buffer, position, length]
+  FS-RT @ 0= IF 4096 FS-MMAP FS-RT ! THEN  3 CELLS * FS-RT @ + ;
+: FS-RESET ( fid --- )  DUP 64 U< IF FS-RE CELL+ 0 OVER ! CELL+ 0 SWAP ! ELSE DROP THEN ;
+: FS-GIVEBACK ( fid --- )                        \ what was read ahead, given back
+  DUP 64 U< 0= FS-RT @ 0= OR IF DROP EXIT THEN
+  DUP FS-RE CELL+ DUP @ SWAP CELL+ @ -           ( fid pos-len )
+  DUP IF OVER SWAP 1 8 FS3 DROP ELSE DROP THEN    \ lseek(fid, pos-len, SEEK_CUR)
+  FS-RESET ;
+: READ-FILE ( c-addr u1 fid --- u2 ior )  DUP FS-GIVEBACK READ-FILE ;
+: REPOSITION-FILE ( ud fid --- ior )  DUP FS-GIVEBACK REPOSITION-FILE ;
+: FILE-POSITION ( fid --- ud ior )  DUP FS-GIVEBACK FILE-POSITION ;
+: FILE-SIZE ( fid --- ud ior )  DUP FS-GIVEBACK FILE-SIZE ;
+: WRITE-FILE ( c-addr u fid --- ior )  DUP FS-GIVEBACK WRITE-FILE ;
+: WRITE-LINE ( c-addr u fid --- ior )  DUP FS-GIVEBACK WRITE-LINE ;
+: CLOSE-FILE ( fid --- ior )  DUP FS-GIVEBACK CLOSE-FILE ;
+: OPEN-FILE ( c-addr u fam --- fid ior )  OPEN-FILE OVER FS-RESET ;
+
+VARIABLE FS-CNT  VARIABLE FS-MAX  VARIABLE FS-E  VARIABLE FS-ERR
+: FS-FILL ( fid --- n )                          \ the buffer refilled: what came, 0 at the end, <0 an error
+  FS-E @ @ 0= IF FS-RSIZE FS-MMAP FS-E @ ! THEN
+  FS-E @ @ FS-RSIZE 0 FS3                        ( n )   \ read(fid, buffer, 4 KB)
+  DUP 0> IF 0 FS-E @ CELL+ ! DUP FS-E @ 2 CELLS + ! THEN ;
+: FS-TAKE ( --- f )                              \ from the buffer up to an LF or the caller's room: the line ended
+  FS-E @ @ FS-E @ CELL+ @ +                      ( src )
+  FS-E @ 2 CELLS + @ FS-E @ CELL+ @ -            ( src avail )
+  FS-MAX @ FS-CNT @ - MIN                        ( src window )
+  2DUP 10 SCAN SWAP DROP OVER SWAP -             ( src window k )
+  >R OVER FS-P @ FS-CNT @ + R@ CMOVE             ( src window )  \ copied to the caller
+  R@ FS-CNT +!  R@ FS-E @ CELL+ +!
+  SWAP DROP R> > IF 1 FS-E @ CELL+ +! -1 ELSE 0 THEN ;   \ an LF in the window: consumed, the line ended
+: READ-LINE ( c-addr u1 fid --- u2 flag ior )
+  DUP 0= OVER 64 U< 0= OR IF READ-LINE EXIT THEN  \ stdin, or past the table: as fsys 3
+  DUP FS-SEEKS? 0= IF READ-LINE EXIT THEN          \ cannot seek: no read-ahead
+  OVER 0= IF DROP 2DROP 0 -1 0 EXIT THEN
+  DUP FS-RE FS-E !  >R FS-MAX ! FS-P !  0 FS-CNT !  0 FS-ANY !  0 FS-ERR !
+  BEGIN
+    FS-E @ CELL+ @ FS-E @ 2 CELLS + @ < 0= IF       \ the buffer empty
+      R@ FS-FILL DUP 0< IF DROP -1 FS-ERR ! ELSE 0= IF ELSE -1 FS-ANY ! THEN THEN
+    THEN
+    FS-ERR @ 0= FS-E @ CELL+ @ FS-E @ 2 CELLS + @ < AND
+  WHILE
+    -1 FS-ANY !
+    FS-TAKE  FS-CNT @ FS-MAX @ = OR
+  UNTIL THEN
+  R> DROP FS-CNT @ FS-CR FS-ANY @ FS-ERR @ IF -200 ELSE 0 THEN ;
