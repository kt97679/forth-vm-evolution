From e845899f59ab455f6251c0b06603bab9a9692f62 Mon Sep 17 00:00:00 2001
From: Kirill Timofeev <kt97679@gmail.com>
Date: Mon, 12 Oct 2026 03:51:59 +0000
Subject: [PATCH 3/3] scratch: guard-after-seed43.patch applied

---
 lab/evolve/README.md | 15 ++++++++++
 lab/evolve/evolve.py | 70 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 85 insertions(+)

diff --git a/lab/evolve/README.md b/lab/evolve/README.md
index 651ae5a..6c747ff 100644
--- a/lab/evolve/README.md
+++ b/lab/evolve/README.md
@@ -554,3 +554,18 @@ fsys 4. Also Iteration 211: the converter's --rebind took the OLDEST
 redefinition (the dump lists words newest first), so fsys 4's buffered WRITE
 was never bound and INCLUDED used fsys 2's OPEN-FILE and CLOSE-FILE, not fsys
 3's forgetting wrappers - now the newest, by address.
+
+## The dump guard (Iteration 212, the owner)
+
+A library that does not load whole stops the run at setup, rather than
+letting an older definition of the same name stand in and every gate pass -
+as file-sysc5.4 once did, at a remark outside a comment, with fsys 3's
+READ-LINE answering for fsys 5's. Each dump is checked as it is made: its load
+messages hold none of the kernel's load errors (Undefined word, dictionary
+full, name too long, Incomplete control structure, compile only, Not found,
+Error reading file); every name each loaded file defines is in the dump; and
+each such name is there as often as the bare kernel (one extra load) and the
+loaded files define it - by count, so a failed REdefinition shows though an
+older one of its name stands. Tested: the original remark - stopped, FS-FILL
+and FS-TAKE missing; READ-LINE alone broken - stopped, READ-LINE 2 of 3. All
+2,666 dumps pass (22 files, 286 names).
diff --git a/lab/evolve/evolve.py b/lab/evolve/evolve.py
index 2e8b306..74fcf5a 100644
--- a/lab/evolve/evolve.py
+++ b/lab/evolve/evolve.py
@@ -142,6 +142,73 @@ RTLOOP_INTERNAL = ('X10-OP', 'W@', 'CHAIN16?', 'RESOLVE-LEAVE16', 'RESOLVE-LEAVE
 # the eight workloads. A design without it builds from the dumps it always did.
 FSYS_INTERNAL = ('FS-BLK', 'FS0', 'FS1', 'FS2', 'FS3', 'FS4', 'FS-DROP', 'FS-WRITE', 'FS-NL', 'FS-MMAP')   # called by file-sysc.4's words only
 THREADS_N = {1: 64, 2: 128, 3: 16}   # Iteration 204, the gene threads: 0 as built (32 chains)
+# Iteration 212 (the owner): a library that does not load whole must stop the
+# run, not fall back. file-sysc5.4 once failed at a remark outside a comment;
+# the definitions before it stood, fsys 3's READ-LINE stood in for fsys 5's
+# under the same name, and every gate passed. So each dump is checked as it is
+# made: (1) its load messages hold no error the kernel prints while loading;
+# (2) every name each loaded file defines is among the dump's words - an error
+# part-way through a file leaves its later names out.
+DUMP_ERRORS = ('Undefined word', 'dictionary full', 'name too long', 'Incomplete control structure',
+               'compile only', 'Not found', 'Error reading file')
+DEFINERS = (':', 'CREATE', 'VARIABLE', 'CONSTANT', '2VARIABLE', '2CONSTANT', 'VALUE', 'DEFER')
