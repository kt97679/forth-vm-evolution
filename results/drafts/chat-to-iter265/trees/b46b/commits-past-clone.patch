diff --git a/forth/sod16.4 b/forth/sod16.4
index 4208ffe..a4ade14 100644
--- a/forth/sod16.4
+++ b/forth/sod16.4
@@ -93,9 +93,10 @@ VARIABLE SOD16-TA  ( --- a-addr )
 \ 319 and up, past the end of a table with 319 entries, and the engine
 \ jumped through whatever followed it in memory.
 
-\ PRIOR-NFA - the previous word in the chain, or 0 at the end - is the
-\ kernel's since Iteration 233: the link cell sits before the name's area,
-\ the count byte at its end.
+: NEXT-NFA ( nfa --- nfa' )
+\ The previous word in the chain, or 0 at the end. The link is stored
+\ RELATIVE to its own cell, exactly as the engine reads it.
+  1 CELLS - DUP @ DUP 0= IF 2DROP 0 EXIT THEN + ;
 
 : SOD16-COLLECT ( --- )
 \ Every eligible word, from every thread, in whatever order the chains
@@ -109,7 +110,7 @@ VARIABLE SOD16-TA  ( --- a-addr )
         SOD16-TAB @ SOD16-N @ CELLS + !
         1 SOD16-N +!
       ELSE DROP THEN
-      SOD16-NFA @ PRIOR-NFA SOD16-NFA !
+      SOD16-NFA @ NEXT-NFA SOD16-NFA !
     REPEAT
   LOOP ;
 
@@ -182,7 +183,7 @@ VARIABLE SOD16-TA  ( --- a-addr )
   THEN ;
 
 : COMPILE,16 ( xt --- )
-  DUP >NAME C@ 32 AND IF
+  DUP PRIMITIVE? IF
     W@ OP,
   ELSE
     CALL,
diff --git a/forth/spn-cv8-decode.4 b/forth/spn-cv8-decode.4
index b84ac37..4723cfb 100644
--- a/forth/spn-cv8-decode.4
+++ b/forth/spn-cv8-decode.4
@@ -145,7 +145,7 @@ VARIABLE PREV-NFA  VARIABLE #WORDS  VARIABLE #FAIL  VARIABLE #DATA
   PREV-NFA @ ?DUP IF
     NAME> WALK                                       ( nfa end )
     OVER DUP LINK-BYTES - > BAD @ OR TARGETS-OK 0= OR IF
-      1 #FAIL +!  #FAIL @ 8 < IF PREV-NFA @ DUP C@ 31 AND SWAP OVER - SWAP TYPE SPACE THEN
+      1 #FAIL +!  #FAIL @ 8 < IF PREV-NFA @ COUNT 31 AND TYPE SPACE THEN
     THEN
     OP-K @ K-DOVAR = OP-K @ K-DODOES = OR IF 1 #DATA +! THEN
     1 #WORDS +!
diff --git a/forth/spn-full.4 b/forth/spn-full.4
index 0d8a40f..be91755 100644
--- a/forth/spn-full.4
+++ b/forth/spn-full.4
@@ -642,12 +642,10 @@ VARIABLE UNDO  VARIABLE #UNDO  0 #UNDO !
 \ map upward: that is definition order, with no sort. Callees are
 \ defined before callers, so callers find them already native.
 VARIABLE MARKS  VARIABLE MBASE  VARIABLE MSIZE
-\ Iteration 233: the count byte is the header's last byte, right before the
-\ body - marked by the BODY (cell-aligned), walked by the kernel's PRIOR-NFA.
-: MARK ( nfa --- )  1+ MBASE @ - 3 RSHIFT MARKS @ + 1 SWAP C! ;
+: MARK ( nfa --- )  MBASE @ - 3 RSHIFT MARKS @ + 1 SWAP C! ;
 : MARK-THREAD ( nfa --- )
   BEGIN ?DUP WHILE
-    DUP MARK  PRIOR-NFA
+    DUP MARK  CELL- DUP @ DUP IF + ELSE 2DROP 0 THEN
   REPEAT ;
 : TRANSLATE-ALL ( --- )
   START @ MBASE !  HERE MBASE @ - 3 RSHIFT 1+ 7 + -8 AND MSIZE !
@@ -655,12 +653,12 @@ VARIABLE MARKS  VARIABLE MBASE  VARIABLE MSIZE
   MARKS @ MSIZE @ 3 RSHIFT 0 CFILL
   FORTH-WORDLIST @ 1+ 1 DO FORTH-WORDLIST I CELLS + @ MARK-THREAD LOOP
   MSIZE @ 0 DO
-    MARKS @ I + C@ IF  I CELLS MBASE @ + TRY-TRANSLATE  THEN
+    MARKS @ I + C@ IF  I CELLS MBASE @ + NAME> TRY-TRANSLATE  THEN
   LOOP
   MARKS @ FREE DROP ;
 
 \ ---- reporting ----
-: .NAME ( xt --- )  >NAME DUP C@ 31 AND SWAP OVER - SWAP TYPE ;   \ the name before its count byte (233)
+: .NAME ( xt --- )  >NAME COUNT 31 AND TYPE ;
 : SPN-WHY ( xt --- )   \ why is this word not native?
   DUP @ TOK-ENTER = IF DROP ." native" EXIT THEN
   DUP SHAPE-OK? 0= IF DROP ." not a translatable shape" EXIT THEN
diff --git a/tools/dict-dump-addr.4 b/tools/dict-dump-addr.4
index f5ca5b9..6af2c93 100644
--- a/tools/dict-dump-addr.4
+++ b/tools/dict-dump-addr.4
@@ -33,10 +33,6 @@ VARIABLE TA
 : INIT-NFATAB 8192 CELLS ALLOCATE ABORT" dict-dump: out of memory" NFATAB ! ;
 INIT-NFATAB
 
-\ Iteration 233: [link][zeros][name][count byte] - the link cell is before
-\ the name's area, the area len+1 rounded up to cells, ending at the nfa.
-: LINKC ( nfa --- a )  DUP C@ 31 AND 1+ ALIGNED - 1+ CELLB - ;
-
 : COLLECT ( --- )
 \ Every nfa in every thread, in whatever order the chains give them.
   0 #NFA !
@@ -45,7 +41,7 @@ INIT-NFATAB
     BEGIN NFA @ WHILE
       NFA @ NFATAB @ #NFA @ CELLS + !
       1 #NFA +!
-      NFA @ LINKC DUP @ ?DUP IF + NFA ! ELSE DROP 0 NFA ! THEN
+      NFA @ CELLB - DUP @ ?DUP IF + NFA ! ELSE DROP 0 NFA ! THEN
     REPEAT
   LOOP ;
 
@@ -69,16 +65,16 @@ INIT-NFATAB
   COLLECT SORTNFA
   #NFA @ 0 DO
     NFATAB @ I CELLS + @ NFA !
-    NFA @ 1+ BP !                       \ the body follows the count byte
+    NFA @ DUP C@ 31 AND 1+ ALIGNED + BP !
     \ The body ends where the next word by ADDRESS begins its link cell.
     \ The newest word - first in this descending order - ends at HERE.
-    I 0= IF HERE ELSE NFATAB @ I 1- CELLS + @ LINKC THEN BE !
+    I 0= IF HERE ELSE NFATAB @ I 1- CELLS + @ CELLB - THEN BE !
     \ The raw count byte carries flag bits above the length - bit 5 is
     \ the MACRO flag cross.4's PRIMITIVE sets. TYPE below masks them
     \ off, so without this line an image rebuilt from this dump would
     \ silently lose every flag.
     S" H " TYPE NFA @ . NFA @ C@ . CR
-    S" N " TYPE BP @ . BE @ . NFA @ DUP C@ 31 AND SWAP OVER - SWAP TYPE CR
+    S" N " TYPE BP @ . BE @ . NFA @ 1+ NFA @ C@ 31 AND TYPE CR
     BEGIN BP @ BE @ < WHILE
       S" B " TYPE BP @ . BP @ @ . CR
       BP @ CELLB + BP !
diff --git a/tools/gen-msc.py b/tools/gen-msc.py
index 120f7ed..6ade63b 100644
--- a/tools/gen-msc.py
+++ b/tools/gen-msc.py
@@ -125,10 +125,10 @@ SPECS = {
     'L_x_duplti':       (['a'], ['a', 'c'], 'c = -(UNS64)((INT64)a < (INT64)(int8_t)BYTE(ip)); ip += 1;'),
     # Iteration 50
     'L_x_fill':         (['a', 'u', 'c'], [], '{ UNS64 a_ = a, u_ = u; while (u_) { BYTE(a_) = (UNS8)c; a_++; u_--; } }'),
-    'L_x_threadfind':   (['a', 'nb'], ['r'], '{ UNS64 a_ = a, nb_ = nb; UNS8 n_ = BYTE(nb_); while (a_) {     if ((BYTE(a_) & 31) == n_) { UNS64 k_ = 0; while (k_ < n_ && BYTE(a_ - n_ + k_) == BYTE(nb_ + 1 + k_)) k_++; if (k_ == n_) break; }     a_ = PREVNFA(a_); } r = a_; }'),
