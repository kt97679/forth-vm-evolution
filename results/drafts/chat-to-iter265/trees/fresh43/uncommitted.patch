+    bad = [l.strip() for l in pre.split('\n') if any(e in l for e in DUMP_ERRORS)]
+    have = collections.Counter(n.strip().upper() for n in re.findall(r'^N -?\d+ -?\d+ (.*)$', body, re.M))
