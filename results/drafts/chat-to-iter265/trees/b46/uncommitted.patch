diff --git a/forth/kernel.4 b/forth/kernel.4
index 17ff784..09aa5fd 100644
--- a/forth/kernel.4
+++ b/forth/kernel.4
@@ -1125,14 +1125,30 @@ VARIABLE DICT-MAX ( --- a-addr)
 \ Add as many bytes to the dictionary as needed to align dictionary pointer.
   BEGIN HERE CELLBYTES-TOK 1- AND WHILE 0 C, REPEAT ;
 
-: >NAME ( addr1 --- addr2 )
-\ Convert execution token addr1 (address of code) to address of name.
-  BEGIN 1- DUP C@ 128 AND UNTIL ;
 
 : NAME> ( addr1 --- addr2 )
 \ Convert address of name to address of code.
   COUNT 31 AND + ALIGNED ;
 
+VARIABLE >NAME-XT
+: >NAME ( xt --- nfa | 0 )
+\ The header whose code is xt (Iteration 244): looked for along every thread of
+\ every word list in the search order - not by scanning back for a marked byte,
+\ since a name's bytes may be anything (UTF-8). So the count byte's bit 7 marks
+\ nothing and is free. 0 where xt has no header there (a :NONAME, a word list
+\ not searched). No compiler asks it (PRIMITIVE?, Iteration 242): tools do.
+  >NAME-XT !
+  #ORDER @ BEGIN DUP WHILE 1-
+    DUP CELLS CONTEXT + @  DUP @                 ( i wid k )
+    BEGIN DUP WHILE
+      2DUP CELLS + @                             ( i wid k nfa )
+      BEGIN DUP WHILE
+        DUP NAME> >NAME-XT @ = IF >R 2DROP DROP R> EXIT THEN
+        CELLBYTES-TOK - DUP @ DUP IF + ELSE SWAP DROP THEN
+      REPEAT DROP 1-
+    REPEAT 2DROP
+  REPEAT DROP 0 ;
+
 : HEADER ( --- )
 \ Create a header for a new definition without a code field.
   ALIGN
@@ -1147,7 +1163,7 @@ VARIABLE DICT-MAX ( --- a-addr)
   DUP COUNT CURRENT @ @ HASH 1+ CELLS CURRENT @ + @
   ?DUP IF R@ - R@ ! THEN    \ link, relative to the link cell itself
   R> DROP
-  C@ 1+ HERE C@ 128 + HERE C! ALLOT ALIGN
+  C@ 1+ ALLOT ALIGN     \ bit 7 no longer marks the count byte (Iteration 244)
                        \ Allot the name and set bit 7 in length byte.
 ;
 
@@ -1220,10 +1236,12 @@ VARIABLE 'LEAVE ( --- a-addr)
   ?COMP EXIT-TOK , [ ?CSP REVEAL ; IMMEDIATE
 
 : (POSTPONE) ( --- )
-\ Runtime for POSTPONE.
-\ has inline argument.
+\ Runtime for POSTPONE of a word that is not immediate: compile it.
+\ has inline argument. (Iteration 244: POSTPONE decides immediacy when it
+\ compiles, by FIND's flag; this asked >NAME every time it ran - a scan back
+\ across the name, which a UTF-8 name broke.)
   R> DUP DUP @ + SWAP CELL+ >R
-  DUP >NAME C@ 64 AND IF EXECUTE ELSE COMPILE, THEN
+  COMPILE,
 ;
 
 : : ( "ccc" --- )
@@ -1365,10 +1383,11 @@ VARIABLE POCKET ( --- a-addr )
   -1 THROW ;
 
 : POSTPONE ( "ccc" --- )
-\ Parse the next word delimited by spaces and compile the following runtime.
-\ Runtime: depending on immediateness EXECUTE or compile the execution
-\ semantics of the parsed word.
-  POSTPONE (POSTPONE) ' HERE - , ; IMMEDIATE
+\ Parse the next word and append its compilation semantics: an immediate
+\ word is compiled to run when this definition runs, any other to be
+\ compiled then - by (POSTPONE). Decided here, by FIND's flag (Iteration 244).
+  32 WORD FIND DUP 0= ABORT" Not found"
+  1 = IF COMPILE, ELSE POSTPONE (POSTPONE) HERE - , THEN ; IMMEDIATE
 
 : IMMEDIATE ( --- )
 \ Make last definition immediate, so that it will be executed even in
