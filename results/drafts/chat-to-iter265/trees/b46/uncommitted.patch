diff --git a/lab/evolve/names-check.py b/lab/evolve/names-check.py
index 4af3290..5223b62 100644
--- a/lab/evolve/names-check.py
+++ b/lab/evolve/names-check.py
@@ -34,8 +34,11 @@ PROG = '\n'.join([
     ': суп 8 . ;  обед суп CR',
     "' café EXECUTE CR",
     "' обед EXECUTE ' voilà EXECUTE CR",
+    "' суп >NAME C@ 31 AND . ' café >NAME 1+ C@ . ' суп >NAME C@ 128 AND . CR",   # >NAME exact, bit 7 free (Iteration 244)
+    ': ёж2 12 . ; IMMEDIATE  : w9 POSTPONE ёж2 ;  : w10 w9 ;  w10 CR',             # POSTPONE of an immediate UTF-8 word
+    ': w11 POSTPONE суп ; IMMEDIATE  : w12 w11 w11 ;  w12 CR',                    # ... and of one that is not
     'BYE', '']).encode()
-WANT = ['5 5', '9', '3 3', '4', '6 6', '1', '2', '11', '5 5 8', '9', '5 5 3']
+WANT = ['5 5', '9', '3 3', '4', '6 6', '1', '2', '11', '5 5 8', '9', '5 5 3', '6 99 0', '12', '8 8']
 def run(eng, img, pw):
     r = subprocess.run([eng, img], cwd=pw, input=PROG, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
     out = r.stdout.replace(b'\r', b'').decode(errors='replace')
diff --git a/tools/layout.py b/tools/layout.py
index e530358..5d1a6ba 100644
--- a/tools/layout.py
+++ b/tools/layout.py
@@ -1065,7 +1065,7 @@ def emit(path):
             if BYTEHDR: img += linkbytes(linkval[s0], LINKLEN[s0])
             else:       img += cel(linkval[s0])
             nm = w['n'].encode('latin-1')
-            img += bytes([flag.get(w['nfa'], 0x80 | len(nm))]) + nm
+            img += bytes([flag.get(w['nfa'], len(nm)) & 0x7F]) + nm      # Iteration 244: bit 7 free, no marker
         # pad to the body: a cell boundary in the classic layout, or only
