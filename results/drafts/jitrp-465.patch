+S(st_tor)    { RPDECL ucell r = RP - sizeof(cell);
+               *(cell *)r = tos; RP = r; GO(sp + 1, *sp); }
+S(st_fromr)  { RPDECL ucell r = RP; cell v = *(cell *)r;
+               RP = r + sizeof(cell); *--sp = tos; GO(sp, v); }
+S(st_rfetch) { RPDECL cell v = *(cell *)RP;
