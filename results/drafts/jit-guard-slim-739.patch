+#include <sys/mman.h>
+#include <signal.h>
+static char g_altstack[16384];   /* .bss.big's (engine/data-layout.ld) */
+static void jit_guard(void) {
+    stack_t ss;
+    ss.ss_sp = g_altstack; ss.ss_size = sizeof g_altstack; ss.ss_flags = 0;
+    sigaltstack(&ss, (stack_t *)0);
+    mprotect((void *)(uintptr_t)(STK_END - RSTACK_BYTES - DSTACK_BYTES), PAGE, PROT_NONE);
+}
