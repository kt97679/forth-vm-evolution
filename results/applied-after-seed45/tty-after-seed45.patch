     while (n) {
         UNS64 k;
@@ -1232,6 +1236,8 @@ NOINLINE_IO static void t_write(const UNS8 *p, UNS64 n) {
         memcpy(t_obuf + t_olen, p, (size_t)k);
         t_olen += (int)k; p += k; n -= k;
     }
+    if (t_otty < 0) t_otty = isatty(1) == 1;
+    if (t_otty) t_flush();
 }
 
