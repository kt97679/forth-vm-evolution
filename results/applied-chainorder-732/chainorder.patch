diff --git a/engine/vm-lab.c b/engine/vm-lab.c
index cf0786d1..4bd6561f 100644
--- a/engine/vm-lab.c
+++ b/engine/vm-lab.c
@@ -186,6 +186,17 @@ static char **g_argv;
 /*  A byte-header link, read backwards from the name: the byte before it
  *  carries the tag - 00 one byte (6 bits; 0 ends the thread), 01 two (14
  *  bits), 10 three (22), 11 four (30) - the bytes below it high to low.  */
+#ifdef CHAINORDER   /* Iteration 732: the gene chainorder - E0-FF a forward link, three bytes (forth/cv8t-chainorder.4) */
+#define PREVNFA(a) ({ UNS64 a__ = (a); UNS8 t__ = BYTE(a__ - 1); UNS64 d__;                  \
+    switch (t__ >> 6) {                                                                   \
+    case 0: d__ = t__; break;                                                             \
+    case 1: d__ = ((UNS64)(t__ & 63) << 8) | BYTE(a__ - 2); break;                        \
+    case 2: d__ = ((UNS64)(t__ & 63) << 16) | ((UNS64)BYTE(a__ - 2) << 8) | BYTE(a__ - 3); break; \
+    default: if (t__ & 32) { d__ = 0; a__ += ((UNS64)(t__ & 31) << 16) | ((UNS64)BYTE(a__ - 2) << 8) | BYTE(a__ - 3); break; } \
+             d__ = ((UNS64)(t__ & 31) << 24) | ((UNS64)BYTE(a__ - 2) << 16)                \
+                   | ((UNS64)BYTE(a__ - 3) << 8) | BYTE(a__ - 4); }                        \
+    (t__ >= 224) ? a__ : d__ ? a__ - d__ : 0; })
+#else
 #define PREVNFA(a) ({ UNS64 a__ = (a); UNS8 t__ = BYTE(a__ - 1); UNS64 d__;                  \
     switch (t__ >> 6) {                                                                   \
     case 0: d__ = t__; break;                                                             \
@@ -194,10 +205,20 @@ static char **g_argv;
     default: d__ = ((UNS64)(t__ & 63) << 24) | ((UNS64)BYTE(a__ - 2) << 16)                \
                    | ((UNS64)BYTE(a__ - 3) << 8) | BYTE(a__ - 4); }                        \
     d__ ? a__ - d__ : 0; })
+#endif
 #else
 /*  A byte-header link in CV8 (cv8b.4's NEXT-NFA8): its last byte, the one
  *  before the name - below 0x80 seven bits (0 ends the thread), below 0xC0
  *  fourteen, else twenty-two.  */
+#ifdef CHAINORDER   /* Iteration 732: the gene chainorder - F0-FF a forward link, three bytes (forth/cv8-chainorder.4) */
+#define PREVNFA(a) ({ UNS64 a__ = (a); UNS8 t__ = BYTE(a__ - 1);                               \
+    t__ < 128 ? (t__ ? a__ - t__ : 0)                                                     \
+    : t__ < 192 ? a__ - (((UNS64)(t__ & 63) << 8) | BYTE(a__ - 2))                        \
+    : t__ < 224 ? a__ - (((UNS64)(t__ & 31) << 16) | ((UNS64)BYTE(a__ - 2) << 8) | BYTE(a__ - 3)) \
+    : t__ < 240 ? a__ - (((UNS64)(t__ & 15) << 24) | ((UNS64)BYTE(a__ - 2) << 16)                 \
+             | ((UNS64)BYTE(a__ - 3) << 8) | BYTE(a__ - 4))                                 \
+    : a__ + (((UNS64)(t__ & 15) << 16) | ((UNS64)BYTE(a__ - 2) << 8) | BYTE(a__ - 3)); })   /* 732: F0-FF forward */
+#else
 #define PREVNFA(a) ({ UNS64 a__ = (a); UNS8 t__ = BYTE(a__ - 1);                               \
     t__ < 128 ? (t__ ? a__ - t__ : 0)                                                     \
     : t__ < 192 ? a__ - (((UNS64)(t__ & 63) << 8) | BYTE(a__ - 2))                        \
@@ -205,6 +226,7 @@ static char **g_argv;
     : a__ - (((UNS64)(t__ & 31) << 24) | ((UNS64)BYTE(a__ - 2) << 16)                     \
              | ((UNS64)BYTE(a__ - 3) << 8) | BYTE(a__ - 4)); })   /* 416: a fourth form, 29 bits */
 #endif
+#endif
 /*  The call form is variable: 10xxxxxx takes one more byte (14-bit payload), 11xxxxxx takes two
  *  (22-bit), decoded once on the shared call path (do_call). The fixed 15-bit form (VARCALL=0) and the
  *  per-handler call path (SHAREDCALL=0) were retired with s4, frozen (Iteration 592).  */
@@ -361,12 +383,18 @@ static inline uint32_t bf_ld32(UNS64 a) { uint32_t x; memcpy(&x, (const void *)(
 #if TAG2
 static inline UNS64 bf_prev(UNS64 a) {          /* tag t: t+1 bytes, the top one's 6 bits */
     uint32_t w = bf_ld32(a - 4); UNS64 d = (UNS64)((w & 0x3FFFFFFFu) >> (8 * (3 - (w >> 30))));
+#ifdef CHAINORDER
+    if ((w >> 29) == 7) return a + ((w >> 8) & 0x1FFFFFu);   /* Iteration 732: E0-FF a forward link, three bytes */
+#endif
     return d ? a - d : 0;
 }
 #else
 static inline UNS64 bf_prev(UNS64 a) {          /* below 0x80 one byte, 7 bits; below 0xC0 two, 14; below 0xE0 three, 21; else four, 29 (416) */
     static const uint32_t bf_mask[5] = { 0, 0x7F, 0x3FFF, 0x1FFFFF, 0x1FFFFFFF };
     uint32_t w = bf_ld32(a - 4); unsigned t = w >> 24, l = 1 + (t >= 128) + (t >= 192) + (t >= 224);
+#ifdef CHAINORDER
+    if (t >= 240) return a + ((w >> 8) & 0xFFFFFu);          /* Iteration 732: F0-FF a forward link, three bytes */
+#endif
     UNS64 d = (UNS64)(w >> (8 * (4 - l))) & bf_mask[l];
     return (d || l > 1) ? a - d : 0;
 }
diff --git a/forth/cv8-chainorder.4 b/forth/cv8-chainorder.4
new file mode 100644
index 00000000..2b37182f
--- /dev/null
+++ b/forth/cv8-chainorder.4
@@ -0,0 +1,21 @@
+\ forth/cv8-chainorder.4 - the gene chainorder's link words for cv8b.4's byte headers (Iteration 732; results/drafts/
+\ demoscene-ioccc-727.md, chainorder-margin-731.txt). With the gene each chain starts with its most looked-up names
+\ (tools/layout.py --chainorder lab/evolve/chainorder-use.txt: those looked up at least --chainorder-min times in the
+\ held-out programs, most first), the rest newest first as before - so a link may point forward. A backward link is as
+\ before; a forward one is its own form, three bytes with the tag F0-FF (20 bits up), carved from the four-byte form,
+\ which keeps E0-EF (28 bits back). Loaded into every dump with cv8b.4, before the dump tool (lab/evolve/evolve.py):
+\ with --chainorder the converter makes each X8's body its X's (LINK, is unchanged: a run-time header links back to its
+\ chain's head), without it drops them - the images with the gene off are byte for byte the old ones. The engine's
+\ PREVNFA by -DCHAINORDER.
+: LINK-LEN8 ( d --- n )
+  DUP 128 U< IF DROP 1 EXIT THEN
+  DUP 268435456 U< 0= IF -1 ABORT" link out of reach" THEN
+  DUP 16384 U< IF DROP 2 EXIT THEN  2097152 U< IF 3 ELSE 4 THEN ;
+
+: NEXT-NFA88 ( nfa --- nfa' )
+  DUP 1- C@                                    ( nfa tag )
+  DUP 128 U< IF DUP IF - ELSE 2DROP 0 THEN EXIT THEN
+  DUP 192 U< IF 63 AND 8 LSHIFT OVER 2 - C@ OR - EXIT THEN
+  DUP 224 U< IF 31 AND 16 LSHIFT OVER 2 - C@ 8 LSHIFT OR OVER 3 - C@ OR - EXIT THEN
+  DUP 240 U< IF 15 AND 24 LSHIFT OVER 2 - C@ 16 LSHIFT OR OVER 3 - C@ 8 LSHIFT OR OVER 4 - C@ OR - EXIT THEN
+  15 AND 16 LSHIFT OVER 2 - C@ 8 LSHIFT OR OVER 3 - C@ OR + ;   \ forward
diff --git a/forth/cv8t-chainorder.4 b/forth/cv8t-chainorder.4
new file mode 100644
index 00000000..cbcfca1b
--- /dev/null
+++ b/forth/cv8t-chainorder.4
@@ -0,0 +1,16 @@
+\ forth/cv8t-chainorder.4 - the gene chainorder's link words for cv8bt.4's tag-2 byte headers (Iteration 732): as
+\ forth/cv8-chainorder.4 - a forward link its own form, three bytes with the tag E0-FF (21 bits up), carved from the
+\ four-byte form, which keeps C0-DF (29 bits back). Loaded into every dump with cv8bt.4; swapped in by
+\ tools/layout.py --chainorder, dropped without.
+: LINK-LEN8 ( d --- n )
+  DUP 64 U< IF DROP 1 EXIT THEN
+  DUP 536870912 U< 0= IF -1 ABORT" link out of reach" THEN
+  DUP 16384 U< IF DROP 2 EXIT THEN
+  4194304 U< IF 3 ELSE 4 THEN ;
+
+: NEXT-NFA88 ( nfa --- nfa' )
+  DUP 1- C@ 224 U< IF
+    DUP 1- DUP C@ DUP 63 AND SWAP 6 RSHIFT                 ( nfa a d k )
+    BEGIN DUP WHILE >R 8 LSHIFT SWAP 1- SWAP OVER C@ OR R> 1- REPEAT DROP SWAP DROP
+    ?DUP IF - ELSE DROP 0 THEN EXIT THEN
+  DUP 1- C@ 31 AND 16 LSHIFT OVER 2 - C@ 8 LSHIFT OR OVER 3 - C@ OR + ;   \ forward
