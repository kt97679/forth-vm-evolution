diff -ruN rp0/forth/kernel.4 rp/forth/kernel.4
--- a/forth/kernel.4	2026-10-17 16:23:07.749659810 +0000
+++ b/forth/kernel.4	2026-10-17 16:23:07.811904170 +0000
@@ -1718,6 +1718,14 @@
   ?COMP
   [OP] BRANCH BRANCH8-TOK BACK, ; IMMEDIATE
 
+: IF-BRANCH, ( --- )
+\ IF's branch (and WHILE's: POSTPONE IF). A 0= just compiled - the last foldable operation, at
+\ HERE - 1 - and this ?BRANCH become one opcode, 0=?BRANCH (96), which branches when its flag is not
+\ zero; 106 is 0='s opcode (forth-vm-evolution, for relf's ledger 716 - its RELF.md has the budget).
+  LAST-OP @ ?DUP IF DUP HERE 1- = SWAP C@ 106 = AND ELSE 0 THEN
+  IF LAST-OP @ REWIND NO-PEEP 96 OP, EXIT THEN
+  NO-PEEP [OP] ?BRANCH OP, ;
+
 : IF    ( --- x)
 \ Start an IF THEN or IF ELSE THEN construction.
 \ Runtime: At IF a flag is taken from
@@ -1725,7 +1733,7 @@
 \ otherwise the part between ELSE and THEN. If there is no ELSE, the part
 \ between IF and THEN is executed only if flag is true.
   ?COMP
-  NO-PEEP [OP] ?BRANCH OP, >MARK ; IMMEDIATE
+  IF-BRANCH, >MARK ; IMMEDIATE
 
 : THEN ( x ---)
 \ End an IF THEN or IF ELSE THEN construction.
