diff -ruN rp0/engine/cv8.c rp/engine/cv8.c
--- a/engine/cv8.c	2026-10-17 16:23:07.748859268 +0000
+++ b/engine/cv8.c	2026-10-17 16:23:07.809843425 +0000
@@ -1058,6 +1058,7 @@
 L_branch8:  ip += (int8_t)BYTE(ip); NEXT();
 L_0branch8: t = tos; POPT(); if (t) ip += 1; else ip += (int8_t)BYTE(ip); NEXT();
 L_0branch: t = tos; POPT(); if (t) ip += 2; else ip += BROFF(ip); NEXT();
+L_zeq0branch: t = tos; POPT(); if (!t) ip += 2; else ip += BROFF(ip); NEXT();  /* `0= ?BRANCH` as one: branches when the flag is not zero (forth-vm-evolution, for relf's ledger 716) */
 L_drop: POPT(); NEXT();
 L_dup: PUSHT(tos); NEXT();
 L_swap: t = NOS; NOS = tos; tos = t; NEXT();
