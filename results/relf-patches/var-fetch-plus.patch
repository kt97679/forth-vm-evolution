--- a/engine/cv8.c	2026-10-17 16:40:28.564445917 +0000
+++ b/engine/cv8.c	2026-10-17 16:40:28.577952726 +0000
@@ -932,6 +932,7 @@
 L_lit1: PUSHT(1); NEXT();
 L_litm1: PUSHT(~(UNS64)0); NEXT();
 L_vf: { UNS64 a = SLOT(); PUSHT(CELL(a)); } NEXT();
+L_vfplus: { UNS64 a = SLOT(); tos += CELL(a); } NEXT();  /* `var @ +` as one (forth-vm-evolution, for relf's ledger 716) */
