diff -ruN rq0/forth/kernel.4 rq/forth/kernel.4
--- a/forth/kernel.4	2026-10-17 16:40:28.565126223 +0000
+++ b/forth/kernel.4	2026-10-17 16:40:28.591610399 +0000
@@ -1389,6 +1389,10 @@
 \ Where the last literal starts, or 0...
 VARIABLE LAST-LITV ( --- a-addr )
 \ ...and its value.
+VARIABLE LAST-VF ( --- a-addr )
+\ Where the last VAR@ starts, or 0 - VAR@+'s (forth-vm-evolution, for relf's ledger 716)...
+VARIABLE LAST-VF-END ( --- a-addr )
+\ ...and where its slot ends.
 VARIABLE LAST-CALL ( --- a-addr )
 \ Where the last call starts, or 0...
 VARIABLE LAST-CALLXT ( --- a-addr )
@@ -1403,7 +1407,7 @@
 \ not one of the halves, calls NO-PEEP. `;` folds a final operation and
 \ its EXIT into one opcode under the same rule.
 : NO-PEEP ( --- )
-  0 LAST-OP ! 0 LAST-LIT ! 0 LAST-CALL ! ;
+  0 LAST-OP ! 0 LAST-LIT ! 0 LAST-CALL ! 0 LAST-VF ! ;
 
 : REWIND ( a-addr --- )
 \ Discard everything compiled from a-addr to HERE.
@@ -1497,7 +1501,17 @@
   DUP [OP] @ = IF DROP 100 ELSE
   [OP] ! = IF 101 ELSE 0 EXIT THEN THEN
   LAST-CALL @ REWIND LAST-CALLXT @ >R NO-PEEP
-  OP, R> 4 + ALIGNED SLOT, -1 ;   \ >BODY, which is defined later
+  DUP 100 = IF HERE LAST-VF ! THEN
+  OP, R> 4 + ALIGNED SLOT, HERE LAST-VF-END ! -1 ;   \ >BODY, which is defined later
+
+: PEEP-VFPLUS ( op --- f )
+\ `var @ +`: a + right after a VAR@ - nothing between, no branch landing there (NO-PEEP forgets
+\ the VAR@) - becomes VAR@+ (113): the VAR@'s opcode rewritten in place, its slot kept, a slot being
+\ an offset from itself (forth-vm-evolution, for relf's ledger 716).
+  [OP] + = 0= IF 0 EXIT THEN
+  LAST-VF @ 0= IF 0 EXIT THEN
+  LAST-VF-END @ HERE = 0= IF 0 EXIT THEN
+  113 LAST-VF @ C! NO-PEEP -1 ;
 
 : DOES-FETCH? ( xt --- f )
 \ Is xt a `CREATE ... DOES> @ ;` word - a buffer from pool.4's BUFFER:,
@@ -1544,7 +1558,7 @@
   DUP 26 = IF DROP 5 + EXIT THEN                     \ LIT32
   DUP 125 = IF DROP 9 + EXIT THEN                    \ LIT64
   DUP 29 = OVER 121 = OR OVER 123 = OR IF DROP 2 + EXIT THEN   \ LIT8 ADDI EQI
-  DUP 100 = OVER 101 = OR IF                         \ VAR@ VAR!: a slot of two bytes, or three
+  DUP 100 = OVER 101 = OR OVER 113 = OR IF           \ VAR@ VAR! VAR@+: a slot of two bytes, or three
     DROP DUP 1+ C@ 128 AND IF 4 ELSE 3 THEN + EXIT THEN
   DUP 126 = IF                                       \ ESC: any selector but RP@ and RP!
     DROP DUP 1+ C@ DUP 72 = SWAP 73 = OR IF DROP 0 ELSE 2 + THEN EXIT THEN
@@ -1585,7 +1599,7 @@
   OVER + SWAP
   BEGIN 2DUP SWAP U< WHILE
     DUP INL-OP
-    OVER C@ DUP 100 = SWAP 101 = OR IF
+    OVER C@ DUP 100 = OVER 101 = OR SWAP 113 = OR IF   \ VAR@+ too (forth-vm-evolution): a slot, re-aimed
       OVER C@ C,  OVER 1+ SLOT@ SLOT,
     ELSE
       2DUP SWAP - >R  OVER HERE R@ MOVE  R> ALLOT
@@ -1604,6 +1618,7 @@
     ELSE
       C@ DUP PEEP-IMM IF DROP EXIT THEN
       DUP PEEP-VAR IF DROP EXIT THEN
+      DUP PEEP-VFPLUS IF DROP EXIT THEN
       NO-PEEP HERE LAST-OP ! OP,
     THEN
   ELSE
