     1                                  ; nasm SnailForth.asm -fbin -l SnailForth.lst -o SnailForth && chmod +x SnailForth
     2                                  
     3                                  %define link 0
     4                                  %define immediate 080h
     5                                  
     6                                  %macro head 3       ; macro with 3 arguments: 1 - name for forth dictionary, 2 - name for nasm label, 3 - additional flags
     7                                  %%link dd link      ; %% defines label local to macro
     8                                  %define link %%link ; link is redefined (to be used in next word definition)
     9                                  %strlen %%count %1  ; length of the word name goes to 'count'
    10                                  db %3 + %%count, %1 ; %3 contains flags value (e.g. for immediate words)
    11                                  xt_ %+ %2:          ; %+ concatenates strings
    12                                  %endmacro
    13                                  
    14                                  ; primitive and colon macros are the same
    15                                  ; primitives are distinguished from colons by their location in the code
    16                                  ; all primitives are in the beginning of the file before docolon label
    17                                  
    18                                  %macro primitive 2-3 0 ; 0 - default value for the 3rd paramseter (no flags)
    19                                  head %1, %2, %3
    20                                  %endmacro
    21                                  
    22                                  %macro colon 2-3 0
    23                                  head %1, %2, %3
    24                                  %endmacro
    25                                  
    26                                  %macro variable 3
    27                                  head %1, %2, 0, dovar
    28                                  val_ %+ %2 dd %3
    29                                  %endmacro
    30                                  
    31                                  %define TEXTORG 0x00400000
    32                                  %define MEMSIZE 1048576
    33                                  %define TIBSIZE 80
    34                                  %define STACKSIZE 4096
    35                                  %define TIBPTR TEXTORG + MEMSIZE - TIBSIZE
    36                                  %define SP0 TIBPTR - 4
    37                                  %define RP0 SP0 - STACKSIZE
    38                                  
    39                                  BITS 32
    40                                          org     TEXTORG
    41                                  
    42                                  ehdr:                           ; Elf32_Ehdr
    43 00000000 7F454C4601010100                db   0x7F, "ELF", 1, 1, 1, 0     ; e_ident
    44 00000008 00<rept>                        times 8 db   0
    45 00000010 0200                            dw   2                  ; e_type
    46 00000012 0300                            dw   3                  ; e_machine
    47 00000014 01000000                        dd   1                  ; e_version
    48 00000018 [C3010000]                      dd   _start       ; e_entry
    49 0000001C 34000000                        dd   phdr - $$  ; e_phoff
    50 00000020 00000000                        dd   0                  ; e_shoff
    51 00000024 00000000                        dd   0                  ; e_flags
    52 00000028 3400                            dw   ehdrsize   ; e_ehsize
    53 0000002A 2000                            dw   phdrsize   ; e_phentsize
    54 0000002C 0100                            dw   1                  ; e_phnum
    55 0000002E 0000                            dw   0                  ; e_shentsize
    56 00000030 0000                            dw   0                  ; e_shnum
    57 00000032 0000                            dw   0                  ; e_shstrndx
    58                                  
    59                                  ehdrsize   equ   $ - ehdr
    60                                  
    61                                  phdr:                           ; Elf32_Phdr
    62 00000034 01000000                        dd   1                  ; p_type
    63 00000038 00000000                        dd   0                  ; p_offset
    64 0000003C [00000000]                      dd   $$                 ; p_vaddr
    65 00000040 [00000000]                      dd   $$                 ; p_paddr
    66 00000044 F3010000                        dd   filesize   ; p_filesz
    67 00000048 00001000                        dd   MEMSIZE    ; p_memsz
    68 0000004C 07000000                        dd   7                  ; p_flags
    69 00000050 00100000                        dd   0x1000             ; p_align
    70                                  
    71                                  phdrsize   equ   $ - phdr
