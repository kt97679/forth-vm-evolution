\ coreext.4 - standard words the kernel leaves out (Iteration 165, the owner):
\ the core words stay in the kernel, these load on top - first the ones the
\ Forth 2012 test suite stopped at (coreplustest at :NONAME, coreexttest at
\ 0<>, filetest at /STRING, stringtest at -TRAILING, toolstest at AHEAD),
\ then their simplest neighbours. Portable Forth: every stage, every width.
: 0<> ( x --- f )  0= 0= ;
: /STRING ( c-addr u n --- c-addr' u' )  ROT OVER + ROT ROT - ;
: -TRAILING ( c-addr u --- c-addr u' )
  BEGIN DUP WHILE 2DUP + 1- C@ BL = WHILE 1- REPEAT THEN ;
: AHEAD ( --- orig )  0 POSTPONE LITERAL POSTPONE IF ; IMMEDIATE
: ERASE ( addr u --- )  0 FILL ;
: BLANK ( c-addr u --- )  BL FILL ;
: WITHIN ( n lo hi --- f )  OVER - >R - R> U< ;
: PARSE-NAME ( "<spaces>name<space>" --- c-addr u )
\ In the input buffer, not a copy: PARSE-WORD's copy at HERE was clobbered by
\ the next word the interpreter parsed (coreexttest; Iteration 181).
  SOURCE >IN @ /STRING
  BEGIN DUP 0 > IF OVER C@ BL > 0= ELSE 0 THEN WHILE 1 /STRING REPEAT
  OVER >R
  BEGIN DUP 0 > IF OVER C@ BL > ELSE 0 THEN WHILE 1 /STRING REPEAT
  OVER R@ - >R
  DUP 0 > IF 1 /STRING THEN
  SWAP DROP SOURCE SWAP DROP SWAP - >IN !
  R> R> SWAP ;
: BUFFER: ( u "name" --- )  CREATE ALLOT ;
: CASE ( --- 0 )  0 ; IMMEDIATE
: OF ( --- of-sys )  POSTPONE OVER POSTPONE = POSTPONE IF POSTPONE DROP ; IMMEDIATE
: ENDOF ( of-sys --- endof-sys )  POSTPONE ELSE ; IMMEDIATE
: ENDCASE ( 0 endof-sys... --- )  POSTPONE DROP BEGIN DUP WHILE POSTPONE THEN REPEAT DROP ; IMMEDIATE
: .R ( n w --- )  >R DUP >R ABS 0 <# #S R> SIGN #> R> OVER - 0 MAX SPACES TYPE ;
: U.R ( u w --- )  >R 0 <# #S #> R> OVER - 0 MAX SPACES TYPE ;
\ The second wave (Iteration 167): where the suite stopped next - coreexttest
\ at UNUSED, filetest at FLUSH-FILE, toolstest at [IF], searchordertest at
\ GET-CURRENT, stringtest at SEARCH, exceptiontest at CATCH, facilitytest at
\ BEGIN-STRUCTURE. [ELSE] and SEARCH use extend.4's COMPARE: load it first.
: FALSE ( --- 0 )  0 ;
: NIP ( x1 x2 --- x2 )  SWAP DROP ;
: TUCK ( x1 x2 --- x2 x1 x2 )  SWAP OVER ;
\ Iteration 489: compiled in place, as their own words were - a call that moved its own return address kept every
\ word using them from the JIT (fcp's, brainless's); their interpretation semantics are undefined (Forth 2012).
: 2>R ( x1 x2 --- ) ( R: --- x1 x2 )  POSTPONE SWAP POSTPONE >R POSTPONE >R ; IMMEDIATE
: 2R> ( --- x1 x2 ) ( R: x1 x2 --- )  POSTPONE R> POSTPONE R> POSTPONE SWAP ; IMMEDIATE
: 2R@ ( --- x1 x2 ) ( R: x1 x2 --- x1 x2 )  POSTPONE R> POSTPONE R> POSTPONE 2DUP POSTPONE >R POSTPONE >R POSTPONE SWAP ; IMMEDIATE
: UNUSED ( --- u )  DICT-LIMIT HERE - ;   \ to the limit ALLOT keeps (Iteration 184)
: FLUSH-FILE ( fileid --- ior )  DROP 0 ;                 \ nothing is buffered
: GET-CURRENT ( --- wid )  CURRENT @ ;
: SET-CURRENT ( wid --- )  CURRENT ! ;
: [ELSE] ( --- )
  1 BEGIN
    BEGIN BL WORD COUNT DUP WHILE
      2DUP S" [IF]" COMPARE 0= IF 2DROP 1+ ELSE
      2DUP S" [ELSE]" COMPARE 0= IF 2DROP 1- DUP IF 1+ THEN ELSE
      S" [THEN]" COMPARE 0= IF 1- THEN THEN THEN
      ?DUP 0= IF EXIT THEN
    REPEAT 2DROP
  REFILL 0= UNTIL DROP ; IMMEDIATE
: [IF] ( flag --- )  0= IF POSTPONE [ELSE] THEN ; IMMEDIATE
: [THEN] ( --- ) ; IMMEDIATE
: SEARCH ( c-addr1 u1 c-addr2 u2 --- c-addr3 u3 flag )
  2>R 2DUP
  BEGIN DUP R@ < 0= WHILE
    OVER R@ 2R@ DROP R@ COMPARE 0= IF 2SWAP 2DROP 2R> 2DROP TRUE EXIT THEN
    1 /STRING
  REPEAT 2DROP 2R> 2DROP FALSE ;
\ CATCH and THROW are the kernel's (Iteration 171): its ABORT and ABORT" throw.
: BEGIN-STRUCTURE ( "name" --- struct-sys 0 )  CREATE HERE 0 0 , DOES> @ ;
: END-STRUCTURE ( struct-sys +n --- )  SWAP ! ;
: +FIELD ( n1 n2 "name" --- n3 )  CREATE OVER , + DOES> @ + ;
: FIELD: ( n1 "name" --- n2 )  ALIGNED 1 CELLS +FIELD ;
: CFIELD: ( n1 "name" --- n2 )  1 CHARS +FIELD ;
: 2CONSTANT ( x1 x2 "name" --- )  CREATE , , DOES> 2@ ;
: 2VARIABLE ( "name" --- )  CREATE 0 , 0 , ;
: 2LITERAL ( x1 x2 --- )  SWAP POSTPONE LITERAL POSTPONE LITERAL ; IMMEDIATE
\ The third wave (Iteration 167): doubletest's words, now that a point reads
\ a double.
: D- ( d1 d2 --- d3 )  DNEGATE D+ ;
: D0< ( d --- f )  NIP 0< ;
: D0= ( d --- f )  OR 0= ;
: D= ( d1 d2 --- f )  ROT = >R = R> AND ;
: D< ( d1 d2 --- f )  ROT 2DUP = IF 2DROP U< ELSE > NIP NIP THEN ;
: DU< ( ud1 ud2 --- f )  ROT 2DUP = IF 2DROP U< ELSE U> NIP NIP THEN ;
: D>S ( d --- n )  DROP ;
: D2* ( d1 --- d2 )  2DUP D+ ;
: D2/ ( d1 --- d2 )  DUP 1 AND >R 2/ SWAP 1 RSHIFT R> IF -1 1 RSHIFT INVERT OR THEN SWAP ;
: DMAX ( d1 d2 --- d3 )  2OVER 2OVER D< IF 2SWAP THEN 2DROP ;
: DMIN ( d1 d2 --- d3 )  2OVER 2OVER D< 0= IF 2SWAP THEN 2DROP ;
: M+ ( d1 n --- d2 )  S>D D+ ;
: D.R ( d n --- )  >R SWAP OVER DABS <# #S ROT SIGN #> R> OVER - 0 MAX SPACES TYPE ;
: 2ROT ( x1 x2 x3 x4 x5 x6 --- x3 x4 x5 x6 x1 x2 )  5 ROLL 5 ROLL ;
\ COMPARE as the standard has it (17.6.1.0935): -1, 0 or 1 - extend.4's gives
\ the difference of the first unequal characters, or of the lengths, and is
\ the kernel workload's, so it stays; this one serves what loads after it.
: COMPARE ( c-addr1 u1 c-addr2 u2 --- n )
  ROT 2DUP - >R MIN
  BEGIN DUP WHILE
    >R OVER C@ OVER C@ - ?DUP IF 0< IF -1 ELSE 1 THEN R> DROP R> DROP NIP NIP EXIT THEN
    1+ SWAP 1+ SWAP R> 1-
  REPEAT DROP 2DROP R> DUP IF 0< IF 1 ELSE -1 THEN THEN ;
: AGAIN ( dest --- )  0 POSTPONE LITERAL POSTPONE UNTIL ; IMMEDIATE
\ The fourth wave (Iteration 170): where the suite stopped next - coreexttest
\ at MARKER, toolstest at CS-PICK, doubletest at M*/, filetest at RESIZE-FILE,
\ stringtest at SLITERAL, searchordertest at FORTH-WORDLIST (ONLY's minimum
\ order must hold it and SET-ORDER; -1 SET-ORDER is ONLY).
: CS-PICK ( ... u --- ... x )  PICK ;   \ a control-flow item is one cell here
: CS-ROLL ( ... u --- ... )  ROLL ;
: SLITERAL ( c-addr1 u --- ) ( run time: --- c-addr2 u )   \ the string kept on the heap
  DUP ALLOCATE DROP 2DUP 2>R SWAP CMOVE 2R> POSTPONE LITERAL POSTPONE LITERAL ; IMMEDIATE
: UT* ( ud u --- ut )  TUCK UM* 2>R UM* 0 2R> D+ ;
: UT/MOD ( ut u --- rem ud )  DUP >R UM/MOD ROT ROT R> UM/MOD ROT ;
: M*/ ( d1 n1 +n2 --- d2 )   \ a three-cell product; the quotient floored, as this system's /
  >R OVER OVER XOR >R ABS >R DABS R> UT* R> R> SWAP >R UT/MOD
  R> 0< IF DNEGATE ROT IF 1. D- THEN ELSE ROT DROP THEN ;
CREATE RESIZE-BLOCK 16 ALLOT
: RESIZE-FILE ( ud fileid --- ior )   \ ftruncate: SYSCALL's block holds 64-bit arguments
  RESIZE-BLOCK 16 ERASE RESIZE-BLOCK ! DROP RESIZE-BLOCK 8 + ! RESIZE-BLOCK 77 SYSCALL 0<> ;
: WID-SAVE ( wid --- a )   \ a wordlist's count and threads, copied to the heap
  DUP @ 1+ CELLS DUP ALLOCATE DROP DUP >R SWAP CMOVE R> ;
: MARKER ( "name" --- )   \ the current wordlist's threads, LAST and HERE, as before name
  HERE LAST @ CURRENT @ DUP WID-SAVE
  CREATE , , , ,
  DOES> DUP @ OVER CELL+ @ OVER @ 1+ CELLS CMOVE
        DUP CELL+ @ CURRENT !  DUP 2 CELLS + @ LAST !  3 CELLS + @ DP ! ;
\ A word here is found while it is compiled, so a new definition that calls the
\ old takes the old one's xt first - else it calls itself.
' SET-ORDER CONSTANT 'SET-ORDER
: SET-ORDER ( widn ... wid1 n --- )   \ -1 is ONLY; 0 an empty order (extend.4's loop
  DUP -1 = IF DROP ONLY EXIT THEN       \ ran from -1 down through memory: searchordertest)
  DUP 0= IF #ORDER ! EXIT THEN  'SET-ORDER EXECUTE ;
' SET-ORDER CONSTANT 'SET-ORDER-1
GET-CURRENT ROOT-WORDLIST SET-CURRENT
: FORTH-WORDLIST ( --- wid )  [ FORTH-WORDLIST ] LITERAL ;
: SET-ORDER ( widn ... wid1 n --- )  'SET-ORDER-1 EXECUTE ;
SET-CURRENT
\ The fifth wave (Iteration 170): coreexttest at VALUE, doubletest at 2VALUE,
\ toolstest at [DEFINED], filetest at RENAME-FILE, searchordertest at C".
: VALUE ( x "name" --- )  CREATE 1 , , DOES> CELL+ @ ;          \ the kind first: TO
: 2VALUE ( x1 x2 "name" --- )  CREATE 2 , , , DOES> CELL+ 2@ ;  \ stores one cell or two
: TO ( i*x "name" --- )
  ' >BODY DUP CELL+ SWAP @ 2 =
  STATE @ IF SWAP POSTPONE LITERAL IF POSTPONE 2! ELSE POSTPONE ! THEN
          ELSE IF 2! ELSE ! THEN THEN ; IMMEDIATE
: [DEFINED] ( "name" --- flag )  BL WORD FIND NIP 0<> ; IMMEDIATE
: [UNDEFINED] ( "name" --- flag )  BL WORD FIND NIP 0= ; IMMEDIATE
: ZPLACE ( c-addr u buf --- )  2DUP + 0 SWAP C! SWAP CMOVE ;   \ zero-terminated at buf
CREATE RENAME-BLOCK 16 ALLOT  CREATE RENAME-PATHS 512 ALLOT
: RENAME-FILE ( c-addr1 u1 c-addr2 u2 --- ior )   \ rename: two paths in SYSCALL's block
  RENAME-PATHS 256 + ZPLACE RENAME-PATHS ZPLACE
  RENAME-BLOCK 16 ERASE RENAME-PATHS RENAME-BLOCK ! RENAME-PATHS 256 + RENAME-BLOCK 8 + !
  RENAME-BLOCK 82 SYSCALL 0<> ;
: C" ( "ccc<quote>" --- ) ( run time: --- c-addr )   \ the counted string kept on the heap
  34 PARSE DUP 1+ ALLOCATE DROP DUP >R 2DUP C! 1+ SWAP CMOVE R> POSTPONE LITERAL ; IMMEDIATE
\ The sixth wave (Iteration 170). RECURSE in :NONAME: the kernel's and the
\ byte compilers' RECURSE call LAST's word - a :NONAME has no header, so its
\ own xt is kept, and used while no header is newer (coreexttest).
\ :NONAME by the design's own : - an xt is what that : makes (a tag-2 design's
\ COMPILE, tells a colon xt by what its : writes; HERE alone failed
\ coreexttest's COMPILE, test on every one), and RECURSE finds it through
\ LAST like any other. A new name each time: the kernel warns on a name it
\ finds, and has no switch (Iteration 171).
CREATE NONAME-SRC 32 ALLOT  VARIABLE NONAMES  0 NONAMES !
: :NONAME ( --- xt colon-sys )
  1 NONAMES +!  S" : (NONAME" NONAME-SRC SWAP CMOVE
  NONAMES @ 0 <# [CHAR] ) HOLD #S #> TUCK NONAME-SRC 9 + SWAP CMOVE
  NONAME-SRC SWAP 9 + EVALUATE  LAST @ NAME> !CSP ;   \ : took the depth before the xt: again after it
: .( ( "ccc<paren>" --- )  [CHAR] ) PARSE TYPE ; IMMEDIATE
: .WID ( wid --- )   \ by name: a wid is an address, and differs by design
  DUP FORTH-WORDLIST = IF DROP ." FORTH " EXIT THEN ROOT-WORDLIST = IF ." ROOT " EXIT THEN ." WORDLIST " ;
: ORDER ( --- )  GET-ORDER 0 ?DO .WID LOOP CR GET-CURRENT .WID CR ;   \ searchordertest
: N>R ( xn .. x1 n --- ) ( R: --- x1 .. xn n )   \ the standard's reference design
  DUP BEGIN DUP WHILE ROT R> SWAP >R >R 1- REPEAT DROP R> SWAP >R >R ;
: NR> ( --- xn .. x1 n ) ( R: x1 .. xn n --- )
  R> R> SWAP >R DUP BEGIN DUP WHILE R> R> SWAP >R ROT ROT 1- REPEAT DROP ;
: UNESCAPE ( c-addr1 len1 c-addr2 --- c-addr2 len2 )   \ each % doubled (stringtest)
  DUP 2SWAP OVER + SWAP ?DO
    I C@ [CHAR] % = IF [CHAR] % OVER C! 1+ THEN I C@ OVER C! 1+
  LOOP OVER - ;
CREATE STAT-BLOCK 16 ALLOT  CREATE STAT-PATH 256 ALLOT  CREATE STAT-BUF 256 ALLOT
: FILE-STATUS ( c-addr u --- x ior )   \ stat: 0 and its result (filetest)
  STAT-PATH ZPLACE STAT-BLOCK 16 ERASE STAT-PATH STAT-BLOCK ! STAT-BUF STAT-BLOCK 8 + !
  0 STAT-BLOCK 4 SYSCALL 0<> ;
\ The seventh wave (Iteration 181): toolstest at SYNONYM, filetest at REQUIRED,
\ coreexttest at SAVE-INPUT.
: SYNONYM ( "newname" "oldname" --- )   \ newname does what oldname does, immediacy too
  CREATE BL WORD FIND DUP 0= ABORT" Undefined word" 1 = >R , R> IF IMMEDIATE THEN
  DOES> @ EXECUTE ;
CREATE INCLUDED-NAMES 0 ,   \ the newest record: link, then a counted name
: NAME-INCLUDED? ( c-addr u --- f )
  INCLUDED-NAMES @ BEGIN DUP WHILE
    >R 2DUP R@ CELL+ COUNT COMPARE 0= IF 2DROP R> DROP TRUE EXIT THEN R> @
  REPEAT DROP 2DROP FALSE ;
: NOTE-INCLUDED ( c-addr u --- )
  ALIGN HERE INCLUDED-NAMES @ , INCLUDED-NAMES ! DUP C, HERE SWAP DUP ALLOT CMOVE ALIGN ;
' INCLUDED CONSTANT 'INCLUDED
: INCLUDED ( i*x c-addr u --- j*x )  2DUP NOTE-INCLUDED 'INCLUDED EXECUTE ;
: REQUIRED ( i*x c-addr u --- i*x )  2DUP NAME-INCLUDED? IF 2DROP ELSE INCLUDED THEN ;
: INCLUDE ( i*x "name" --- j*x )  PARSE-NAME INCLUDED ;
: REQUIRE ( i*x "name" --- i*x )  PARSE-NAME REQUIRED ;
\ The tenth wave (Iteration 192): RESTORE-INPUT across a file's lines -
\ filetest's last tests. SAVE-INPUT on a file also keeps where the current
\ line starts: the position READ-LINE left, less the line and its end - an
\ LF, a CR LF, or none (the file's last line, or one longer than the buffer) -
\ each tried by reading the line again and comparing; the position put back.
CREATE LINE-AGAIN 256 ALLOT
CREATE LINE-P 2 CELLS ALLOT
: LINE-AT? ( ud --- f )   \ does the current line start at ud? the file left where it was
  SID @ FILE-POSITION THROW LINE-P 2!
  SID @ REPOSITION-FILE THROW
  LINE-AGAIN 256 SID @ READ-LINE THROW              ( u flag )
  SWAP DUP #SRC @ = ROT AND                         ( u f )
  IF LINE-AGAIN SWAP SOURCE COMPARE 0= ELSE DROP FALSE THEN
  SID @ FILE-POSITION THROW LINE-P 2@ ROT = >R = R> AND AND
  LINE-P 2@ SID @ REPOSITION-FILE THROW ;
: LINE-START ( --- u )   \ where the file's current line starts
  SID @ FILE-POSITION THROW DROP #SRC @             ( p n )
  2DUP 1+ U< 0= IF 2DUP 1+ - 0 LINE-AT? IF 1+ - EXIT THEN THEN     \ an LF
  2DUP 2 + U< 0= IF 2DUP 2 + - 0 LINE-AT? IF 2 + - EXIT THEN THEN  \ a CR LF
  - ;                                                               \ no end
: SAVE-INPUT ( --- xn ... x1 n )
  SID @ 0> IF LINE-START SRC @ #SRC @ >IN @ SID @ 5 EXIT THEN   \ a file: where its line starts too
  SRC @ #SRC @ >IN @ SID @ 4 ;
: RESTORE-INPUT ( xn ... x1 n --- flag )   \ the same source only: else true, nothing done
  DUP 5 = IF DROP                                   \ a file's line: read it again, from where it starts
    DUP SID @ <> IF 2DROP 2DROP DROP TRUE EXIT THEN DROP
    >R 2DROP 0 SID @ REPOSITION-FILE IF R> DROP TRUE EXIT THEN
    REFILL 0= IF R> DROP TRUE EXIT THEN
    R> >IN ! FALSE EXIT
  THEN
  DUP 4 <> IF 0 ?DO DROP LOOP TRUE EXIT THEN DROP
  DUP SID @ <> IF 2DROP 2DROP TRUE EXIT THEN DROP
  >R 2DUP #SRC @ = SWAP SRC @ = AND IF #SRC ! SRC ! R> >IN ! FALSE EXIT THEN
  2DROP R> DROP TRUE ;
\ The eighth wave (Iteration 182): coreexttest at DEFER, filetest at S\",
\ stringtest at SUBSTITUTE.
: DEFER ( "name" --- )  CREATE ['] ABORT , DOES> @ EXECUTE ;
: DEFER@ ( xt1 --- xt2 )  >BODY @ ;
: DEFER! ( xt2 xt1 --- )  >BODY ! ;
: IS ( xt "name" --- )  STATE @ IF POSTPONE ['] POSTPONE DEFER! ELSE ' DEFER! THEN ; IMMEDIATE
: ACTION-OF ( "name" --- xt )  STATE @ IF POSTPONE ['] POSTPONE DEFER@ ELSE ' DEFER@ THEN ; IMMEDIATE
CREATE S"-BUFS 512 ALLOT  VARIABLE S"-NEXT  0 S"-NEXT !
: S"-BUF ( --- c-addr )   \ two transient buffers in turn - the file wordset's S" (11.6.1.2165)
  S"-NEXT @ 256 * S"-BUFS +  S"-NEXT @ 1 XOR S"-NEXT ! ;
' S" CONSTANT 'S"
: S" ( "ccc<quote>" --- ) ( interpreted: --- c-addr u )
  STATE @ IF 'S" EXECUTE EXIT THEN
  [CHAR] " PARSE DUP >R S"-BUF DUP >R SWAP CMOVE R> R> ; IMMEDIATE
CREATE S\-BUF 256 ALLOT  VARIABLE S\-N
: S\-C, ( c --- )  S\-BUF S\-N @ + C! 1 S\-N +! ;
: S\-NEXT ( --- c )   \ the next character of the input, 0 past its end
  SOURCE >IN @ > IF >IN @ + C@ ELSE DROP 0 THEN 1 >IN +! ;
: HEXDIGIT ( c --- n )  DUP [CHAR] a [CHAR] z 1+ WITHIN IF 32 - THEN DUP [CHAR] 9 > IF 55 - ELSE [CHAR] 0 - THEN ;
: S\-PARSE ( --- )   \ the escaped text to the closing quote, into S\-BUF
  0 S\-N !
  BEGIN S\-NEXT DUP [CHAR] " <> OVER 0<> AND WHILE
    DUP [CHAR] \ = IF DROP S\-NEXT
      CASE
        [CHAR] a OF 7 S\-C, ENDOF   [CHAR] b OF 8 S\-C, ENDOF   [CHAR] e OF 27 S\-C, ENDOF
        [CHAR] f OF 12 S\-C, ENDOF  [CHAR] l OF 10 S\-C, ENDOF  [CHAR] m OF 13 S\-C, 10 S\-C, ENDOF
        [CHAR] n OF 10 S\-C, ENDOF  [CHAR] q OF 34 S\-C, ENDOF  [CHAR] r OF 13 S\-C, ENDOF
        [CHAR] t OF 9 S\-C, ENDOF   [CHAR] v OF 11 S\-C, ENDOF  [CHAR] z OF 0 S\-C, ENDOF
        [CHAR] " OF 34 S\-C, ENDOF
        [CHAR] x OF S\-NEXT HEXDIGIT 16 * S\-NEXT HEXDIGIT + S\-C, ENDOF
        DUP S\-C,
      ENDCASE
    ELSE S\-C, THEN
  REPEAT DROP ;
: S\" ( "ccc<quote>" --- ) ( run time: --- c-addr u )
  S\-PARSE S\-BUF S\-N @ STATE @ IF POSTPONE SLITERAL EXIT THEN
  DUP >R S"-BUF DUP >R SWAP CMOVE R> R> ; IMMEDIATE   \ interpreted: one of the two buffers
CREATE SUBST-LIST 0 ,   \ the newest pair: link, the name counted, the text counted
: REPLACES ( c-addr1 u1 c-addr2 u2 --- )   \ %name% (c-addr2 u2) stands for c-addr1 u1
  ALIGN HERE SUBST-LIST @ , SUBST-LIST ! DUP C, HERE SWAP DUP ALLOT CMOVE
  DUP C, HERE SWAP DUP ALLOT CMOVE ALIGN ;
: SUBST-FIND ( c-addr u --- c-addr' u' -1 | 0 )
  SUBST-LIST @ BEGIN DUP WHILE
    >R 2DUP R@ CELL+ COUNT COMPARE 0= IF 2DROP R> CELL+ COUNT + COUNT -1 EXIT THEN R> @
  REPEAT DROP 2DROP 0 ;
VARIABLE SUB-D  VARIABLE SUB-MAX  VARIABLE SUB-N  VARIABLE SUB-ERR  VARIABLE SUB-COUNT
: SUB-C, ( c --- )  SUB-N @ SUB-MAX @ < IF SUB-D @ SUB-N @ + C! 1 SUB-N +! ELSE DROP -1 SUB-ERR ! THEN ;
: SUB-S, ( c-addr u --- )  0 ?DO DUP I + C@ SUB-C, LOOP DROP ;
: CHAR-AT ( c-addr u c --- n )   \ c's index, or -1 - c on the data stack: in a
  SWAP 0 ?DO OVER I + C@ OVER = IF 2DROP I UNLOOP EXIT THEN LOOP 2DROP -1 ;   \ DO loop R@ is the loop's
: SUBSTITUTE ( c-addr1 u1 c-addr2 u2 --- c-addr2 u3 n )
  SUB-MAX ! SUB-D ! 0 SUB-N ! 0 SUB-ERR ! 0 SUB-COUNT !
  BEGIN DUP WHILE
    OVER C@ [CHAR] % <> IF OVER C@ SUB-C, 1 /STRING ELSE
      1 /STRING 2DUP [CHAR] % CHAR-AT
      DUP 0< IF DROP [CHAR] % SUB-C, ELSE
        DUP 0= IF DROP [CHAR] % SUB-C, 1 /STRING ELSE
          >R OVER R@ SUBST-FIND IF SUB-S, 1 SUB-COUNT +! ELSE [CHAR] % SUB-C, OVER R@ SUB-S, [CHAR] % SUB-C, THEN
          R> 1+ /STRING
        THEN
      THEN
    THEN
  REPEAT 2DROP SUB-D @ SUB-N @ SUB-ERR @ IF -1 ELSE SUB-COUNT @ THEN ;
: HOLDS ( c-addr u --- )  BEGIN DUP WHILE 1- 2DUP + C@ HOLD REPEAT 2DROP ;   \ coreexttest
\ The block word set (Iteration 186): blocks.fb in the working directory,
\ 1024 bytes a block; two buffers - a new block takes the one not current,
\ written back first if updated (blocktest wants two at once).
VARIABLE BLK  0 BLK !   VARIABLE SCR  0 SCR !   VARIABLE BLOCK-FID  0 BLOCK-FID !
CREATE BLK-BUFS 2048 ALLOT   CREATE BLK-NUMS 0 , 0 ,   CREATE BLK-DIRTY 0 , 0 ,
VARIABLE BLK-CUR  0 BLK-CUR !
: BUF-ADDR ( i --- a-addr )  1024 * BLK-BUFS + ;
: BUF-NUM ( i --- a-addr )  CELLS BLK-NUMS + ;
: BUF-DIRTY ( i --- a-addr )  CELLS BLK-DIRTY + ;
: BLOCK-FILE ( --- fileid )
  BLOCK-FID @ ?DUP IF EXIT THEN
  S" blocks.fb" R/W BIN OPEN-FILE IF DROP S" blocks.fb" R/W BIN CREATE-FILE THROW THEN
  DUP BLOCK-FID ! ;
: WRITE-BUF ( i --- )
  DUP BUF-DIRTY @ IF
    DUP BUF-NUM @ 1- 1024 UM* BLOCK-FILE REPOSITION-FILE DROP
    DUP BUF-ADDR 1024 BLOCK-FILE WRITE-FILE DROP  0 OVER BUF-DIRTY !
  THEN DROP ;
: FIND-BUF ( u --- i | -1 )  2 0 DO DUP I BUF-NUM @ = IF DROP I UNLOOP EXIT THEN LOOP DROP -1 ;
: GRAB-BUF ( u --- i )  BLK-CUR @ 1 XOR DUP WRITE-BUF TUCK BUF-NUM ! ;
: BUFFER ( u --- a-addr )
  DUP FIND-BUF DUP 0< IF DROP GRAB-BUF ELSE NIP THEN DUP BLK-CUR ! BUF-ADDR ;
: BLOCK ( u --- a-addr )
  DUP FIND-BUF DUP 0< 0= IF NIP DUP BLK-CUR ! BUF-ADDR EXIT THEN DROP
  DUP GRAB-BUF DUP BLK-CUR ! DUP BUF-ADDR 1024 BLANK
  SWAP 1- 1024 UM* BLOCK-FILE REPOSITION-FILE DROP
  DUP BUF-ADDR 1024 BLOCK-FILE READ-FILE 2DROP BUF-ADDR ;
: UPDATE ( --- )  -1 BLK-CUR @ BUF-DIRTY ! ;
: SAVE-BUFFERS ( --- )  2 0 DO I WRITE-BUF LOOP ;
: EMPTY-BUFFERS ( --- )  2 0 DO 0 I BUF-NUM ! 0 I BUF-DIRTY ! LOOP ;
: FLUSH ( --- )  SAVE-BUFFERS EMPTY-BUFFERS ;
: LOAD ( i*x u --- j*x )  BLK @ >R DUP BLK ! BLOCK 1024 EVALUATE R> BLK ! ;
: THRU ( i*x u1 u2 --- j*x )  1+ SWAP ?DO I LOAD LOOP ;
: LIST ( u --- )  DUP SCR ! BLOCK 16 0 DO CR I 2 .R SPACE DUP I 64 * + 64 TYPE LOOP DROP CR ;
' \ CONSTANT '\
: \ ( --- )  BLK @ IF >IN @ 63 + -64 AND >IN ! ELSE '\ EXECUTE THEN ; IMMEDIATE   \ in a block: to its line's end
\ TRAVERSE-WORDLIST and the name tokens (Iteration 186): a name token is the
\ header's nfa; NEXT-NFA8, the byte headers' own link walk, gives the one
\ before it in its thread. The walk's state in variables: the word called may
\ reach the stack below its nt.
[DEFINED] NEXT-NFA8 [IF]
VARIABLE TW-XT  VARIABLE TW-WID
: TRAVERSE-WORDLIST ( i*x xt wid --- j*x )
  TW-WID ! TW-XT !
  TW-WID @ @ 1+ 1 ?DO
    TW-WID @ I CELLS + @
    BEGIN DUP WHILE
      DUP >R TW-XT @ EXECUTE 0= IF R> DROP UNLOOP EXIT THEN R> NEXT-NFA8
    REPEAT DROP
  LOOP ;
: NAME>STRING ( nt --- c-addr u )  COUNT 31 AND ;
: NAME>INTERPRET ( nt --- xt )  NAME> ;
: NAME>COMPILE ( nt --- x xt )  DUP NAME> SWAP C@ 64 AND IF ['] EXECUTE ELSE ['] COMPILE, THEN ;
\ >NAME (Iteration 244): the name token of the word whose code is xt, looked
\ for in every word list of the search order; 0 when not there. Here, not in
\ the kernel: no compiler asks it (PRIMITIVE? and POSTPONE decide without
\ it), and with no marker byte to scan back for it walks - bytes better spent
\ only where wanted.
: >NAME ( xt --- nt | 0 )
  >R #ORDER @ BEGIN DUP WHILE 1-
    DUP CELLS CONTEXT + @  DUP @
    BEGIN DUP WHILE
      2DUP CELLS + @
      BEGIN DUP WHILE
        DUP NAME> R@ = IF >R 2DROP DROP R> R> DROP EXIT THEN
        NEXT-NFA8
      REPEAT DROP 1-
    REPEAT 2DROP
  REPEAT DROP R> DROP 0 ;
[THEN]
\ The eleventh wave (Iteration 194): the locals word set - {: (LOCAL) TO
\ ENVIRONMENT? - localstest. No kernel hook: the kernel's FIND walks the
\ search order, so the names of the definition being compiled live in a
\ wordlist of their own (LWL), searched first while it compiles; their
\ headers go into a scratch area (LNAMES), HERE, LAST and CURRENT saved and
\ restored around each, so the definition's code is not interrupted and
\ RECURSE still finds it (results/drafts/locals-plan.md). The values live on
\ a stack of their own (LP): DO loops and >R keep the return stack as they
\ find it, and a local named I or J is the local.
CREATE LSTACK 1024 CELLS ALLOT  HERE CONSTANT LSTACK-END
VARIABLE LP  LSTACK-END LP !
: (L@) ( i --- x )  CELLS LP @ + @ ;
: (L!) ( x i --- )  CELLS LP @ + ! ;
: (LEXIT) ( n --- )  CELLS LP +! ;
: (LENTER) ( x1 .. xk k n --- )   \ {:'s - n cells, 0; the k initialized popped in, the last declared from the top
  DUP CELLS NEGATE LP +!  LP @ SWAP CELLS ERASE
  BEGIN DUP WHILE 1- TUCK (L!) REPEAT DROP ;
: (LENTER-REV) ( xk .. x1 k n --- )   \ (LOCAL)'s - the first declared from the top
  DUP CELLS NEGATE LP +!  LP @ SWAP CELLS ERASE
  0 ?DO I (L!) LOOP ;
WORDLIST CONSTANT LWL
CREATE LNAMES 4096 ALLOT  VARIABLE LNP  LNAMES LNP !
VARIABLE #LOC  0 #LOC !  VARIABLE #LINIT  0 #LINIT !
VARIABLE L-SDP  VARIABLE L-SLAST  VARIABLE L-SCUR  CREATE LBUF 80 ALLOT
: LOCAL-WORD ( i "name" --- )  CREATE , IMMEDIATE DOES> @ POSTPONE LITERAL POSTPONE (L@) ;
: L-NAME ( c-addr u --- )   \ the next local, named c-addr u: an immediate word in LWL, in the scratch area
  #LOC @ 0= IF GET-ORDER LWL SWAP 1+ SET-ORDER THEN
  DUP >R LBUF 11 + SWAP CMOVE  S" LOCAL-WORD " LBUF SWAP CMOVE
  #LOC @ LBUF R> 11 +
  DP @ L-SDP !  LAST @ L-SLAST !  GET-CURRENT L-SCUR !  LNP @ DP !  LWL SET-CURRENT
  STATE @ >R POSTPONE [  EVALUATE  R> IF ] THEN
  HERE LNP !  L-SDP @ DP !  L-SLAST @ LAST !  L-SCUR @ SET-CURRENT
  1 #LOC +! ;
: LOCALS-END ( --- )   \ the scope's end: the frame dropped at run time, the names gone
  #LOC @ IF
    #LOC @ POSTPONE LITERAL POSTPONE (LEXIT)
    GET-ORDER NIP 1- SET-ORDER
    LWL DUP @ 0 ?DO 0 OVER I 1+ CELLS + ! LOOP DROP
    LNAMES LNP !  0 #LOC !  0 #LINIT !
  THEN ;
: {: ( --- )   \ {: args [| vals] [-- outs] :}
  0 >R                                     \ 0 args, 1 vals, 2 outs: the part being read
  BEGIN
    PARSE-NAME DUP 0= IF 2DROP REFILL 0= ABORT" {: without :}" FALSE
    ELSE 2DUP S" :}" COMPARE 0= IF 2DROP TRUE
    ELSE 2DUP S" |" COMPARE 0= IF 2DROP R> DROP 1 >R FALSE
    ELSE 2DUP S" --" COMPARE 0= IF 2DROP R> DROP 2 >R FALSE
    ELSE R@ 2 = IF 2DROP ELSE R@ 0= IF 1 #LINIT +! THEN L-NAME THEN FALSE
    THEN THEN THEN THEN
  UNTIL R> DROP
  #LOC @ IF #LINIT @ POSTPONE LITERAL #LOC @ POSTPONE LITERAL POSTPONE (LENTER) THEN ; IMMEDIATE
: (LOCAL) ( c-addr u --- )   \ u 0: the last - the frame's entry compiled
  DUP IF 1 #LINIT +! L-NAME
  ELSE 2DROP #LOC @ IF #LOC @ DUP POSTPONE LITERAL POSTPONE LITERAL POSTPONE (LENTER-REV) THEN THEN ;
: TO ( i*x "name" --- )   \ a local first
  STATE @ #LOC @ AND IF
    >IN @ >R PARSE-NAME LWL SEARCH-WORDLIST IF
      R> DROP >BODY @ POSTPONE LITERAL POSTPONE (L!) EXIT
    THEN R> >IN !
  THEN POSTPONE TO ; IMMEDIATE
: ENVIRONMENT? ( c-addr u --- false | i*x true )   \ #LOCALS known; anything else not
  S" #LOCALS" COMPARE 0= IF 64 TRUE ELSE FALSE THEN ;
: EXIT ( --- )  #LOC @ IF #LOC @ POSTPONE LITERAL POSTPONE (LEXIT) THEN POSTPONE EXIT ; IMMEDIATE
: DOES> ( --- )  LOCALS-END POSTPONE DOES> ; IMMEDIATE
: ; ( --- )  LOCALS-END POSTPONE ; ; IMMEDIATE
: .S ( --- )   \ the stack, bottom first, left as it was: <depth> x1 ... xn
  DEPTH DUP ." <" 0 <# #S #> TYPE ." > "  0 ?DO DEPTH I - 1- PICK . LOOP ;
