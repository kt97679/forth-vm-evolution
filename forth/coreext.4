\ coreext.4 - standard words the kernel leaves out (Iteration 165, the owner):
\ the core words stay in the kernel, these load on top - first the ones the
\ Forth 2012 test suite stopped at (coreplustest at :NONAME, coreexttest at
\ 0<>, filetest at /STRING, stringtest at -TRAILING, toolstest at AHEAD),
\ then their simplest neighbours. Portable Forth: every stage, every width.
: 0<> ( x --- f )  0= 0= ;
: /STRING ( c-addr u n --- c-addr' u' )  ROT OVER + ROT ROT - ;
: -TRAILING ( c-addr u --- c-addr u' )
  BEGIN DUP WHILE 2DUP + 1- C@ BL = WHILE 1- REPEAT THEN ;
: AHEAD ( --- orig )  0 POSTPONE LITERAL POSTPONE IF ; IMMEDIATE
: ERASE ( addr u --- )  0 FILL ;
: BLANK ( c-addr u --- )  BL FILL ;
: WITHIN ( n lo hi --- f )  OVER - >R - R> U< ;
: PARSE-NAME ( "name" --- c-addr u )  BL PARSE-WORD ;
: BUFFER: ( u "name" --- )  CREATE ALLOT ;
: CASE ( --- 0 )  0 ; IMMEDIATE
: OF ( --- of-sys )  POSTPONE OVER POSTPONE = POSTPONE IF POSTPONE DROP ; IMMEDIATE
: ENDOF ( of-sys --- endof-sys )  POSTPONE ELSE ; IMMEDIATE
: ENDCASE ( 0 endof-sys... --- )  POSTPONE DROP BEGIN DUP WHILE POSTPONE THEN REPEAT DROP ; IMMEDIATE
: .R ( n w --- )  >R DUP >R ABS 0 <# #S R> SIGN #> R> OVER - 0 MAX SPACES TYPE ;
: U.R ( u w --- )  >R 0 <# #S #> R> OVER - 0 MAX SPACES TYPE ;
\ The second wave (Iteration 167): where the suite stopped next - coreexttest
\ at UNUSED, filetest at FLUSH-FILE, toolstest at [IF], searchordertest at
\ GET-CURRENT, stringtest at SEARCH, exceptiontest at CATCH, facilitytest at
\ BEGIN-STRUCTURE. [ELSE] and SEARCH use extend.4's COMPARE: load it first.
: FALSE ( --- 0 )  0 ;
: NIP ( x1 x2 --- x2 )  SWAP DROP ;
: TUCK ( x1 x2 --- x2 x1 x2 )  SWAP OVER ;
: 2>R ( x1 x2 --- ) ( R: --- x1 x2 )  R> ROT ROT SWAP >R >R >R ;
: 2R> ( --- x1 x2 ) ( R: x1 x2 --- )  R> R> R> SWAP ROT >R ;
: 2R@ ( --- x1 x2 ) ( R: x1 x2 --- x1 x2 )  R> R> R> 2DUP >R >R SWAP ROT >R ;
: UNUSED ( --- u )  S0 @ 10000 CELLS - 4096 - HERE - ;   \ to the limit ALLOT keeps
: FLUSH-FILE ( fileid --- ior )  DROP 0 ;                 \ nothing is buffered
: GET-CURRENT ( --- wid )  CURRENT @ ;
: SET-CURRENT ( wid --- )  CURRENT ! ;
: [ELSE] ( --- )
  1 BEGIN
    BEGIN BL WORD COUNT DUP WHILE
      2DUP S" [IF]" COMPARE 0= IF 2DROP 1+ ELSE
      2DUP S" [ELSE]" COMPARE 0= IF 2DROP 1- DUP IF 1+ THEN ELSE
      S" [THEN]" COMPARE 0= IF 1- THEN THEN THEN
      ?DUP 0= IF EXIT THEN
    REPEAT 2DROP
  REFILL 0= UNTIL DROP ; IMMEDIATE
: [IF] ( flag --- )  0= IF POSTPONE [ELSE] THEN ; IMMEDIATE
: [THEN] ( --- ) ; IMMEDIATE
: SEARCH ( c-addr1 u1 c-addr2 u2 --- c-addr3 u3 flag )
  2>R 2DUP
  BEGIN DUP R@ < 0= WHILE
    OVER R@ 2R@ DROP R@ COMPARE 0= IF 2SWAP 2DROP 2R> 2DROP TRUE EXIT THEN
    1 /STRING
  REPEAT 2DROP 2R> 2DROP FALSE ;
\ CATCH and THROW are the kernel's (Iteration 171): its ABORT and ABORT" throw.
: BEGIN-STRUCTURE ( "name" --- struct-sys 0 )  CREATE HERE 0 0 , DOES> @ ;
: END-STRUCTURE ( struct-sys +n --- )  SWAP ! ;
: +FIELD ( n1 n2 "name" --- n3 )  CREATE OVER , + DOES> @ + ;
: FIELD: ( n1 "name" --- n2 )  ALIGNED 1 CELLS +FIELD ;
: CFIELD: ( n1 "name" --- n2 )  1 CHARS +FIELD ;
: 2CONSTANT ( x1 x2 "name" --- )  CREATE , , DOES> 2@ ;
: 2VARIABLE ( "name" --- )  CREATE 0 , 0 , ;
: 2LITERAL ( x1 x2 --- )  SWAP POSTPONE LITERAL POSTPONE LITERAL ; IMMEDIATE
\ The third wave (Iteration 167): doubletest's words, now that a point reads
\ a double.
: D- ( d1 d2 --- d3 )  DNEGATE D+ ;
: D0< ( d --- f )  NIP 0< ;
: D0= ( d --- f )  OR 0= ;
: D= ( d1 d2 --- f )  ROT = >R = R> AND ;
: D< ( d1 d2 --- f )  ROT 2DUP = IF 2DROP U< ELSE > NIP NIP THEN ;
: DU< ( ud1 ud2 --- f )  ROT 2DUP = IF 2DROP U< ELSE U> NIP NIP THEN ;
: D>S ( d --- n )  DROP ;
: D2* ( d1 --- d2 )  2DUP D+ ;
: D2/ ( d1 --- d2 )  DUP 1 AND >R 2/ SWAP 1 RSHIFT R> IF -1 1 RSHIFT INVERT OR THEN SWAP ;
: DMAX ( d1 d2 --- d3 )  2OVER 2OVER D< IF 2SWAP THEN 2DROP ;
: DMIN ( d1 d2 --- d3 )  2OVER 2OVER D< 0= IF 2SWAP THEN 2DROP ;
: M+ ( d1 n --- d2 )  S>D D+ ;
: D.R ( d n --- )  >R SWAP OVER DABS <# #S ROT SIGN #> R> OVER - 0 MAX SPACES TYPE ;
: 2ROT ( x1 x2 x3 x4 x5 x6 --- x3 x4 x5 x6 x1 x2 )  5 ROLL 5 ROLL ;
\ COMPARE as the standard has it (17.6.1.0935): -1, 0 or 1 - extend.4's gives
\ the difference of the first unequal characters, or of the lengths, and is
\ the kernel workload's, so it stays; this one serves what loads after it.
: COMPARE ( c-addr1 u1 c-addr2 u2 --- n )
  ROT 2DUP - >R MIN
  BEGIN DUP WHILE
    >R OVER C@ OVER C@ - ?DUP IF 0< IF -1 ELSE 1 THEN R> DROP R> DROP NIP NIP EXIT THEN
    1+ SWAP 1+ SWAP R> 1-
  REPEAT DROP 2DROP R> DUP IF 0< IF 1 ELSE -1 THEN THEN ;
: AGAIN ( dest --- )  0 POSTPONE LITERAL POSTPONE UNTIL ; IMMEDIATE
\ The fourth wave (Iteration 170): where the suite stopped next - coreexttest
\ at MARKER, toolstest at CS-PICK, doubletest at M*/, filetest at RESIZE-FILE,
\ stringtest at SLITERAL, searchordertest at FORTH-WORDLIST (ONLY's minimum
\ order must hold it and SET-ORDER; -1 SET-ORDER is ONLY).
: CS-PICK ( ... u --- ... x )  PICK ;   \ a control-flow item is one cell here
: CS-ROLL ( ... u --- ... )  ROLL ;
: SLITERAL ( c-addr1 u --- ) ( run time: --- c-addr2 u )   \ the string kept on the heap
  DUP ALLOCATE DROP 2DUP 2>R SWAP CMOVE 2R> POSTPONE LITERAL POSTPONE LITERAL ; IMMEDIATE
: UT* ( ud u --- ut )  TUCK UM* 2>R UM* 0 2R> D+ ;
: UT/MOD ( ut u --- rem ud )  DUP >R UM/MOD ROT ROT R> UM/MOD ROT ;
: M*/ ( d1 n1 +n2 --- d2 )   \ a three-cell product; the quotient floored, as this system's /
  >R OVER OVER XOR >R ABS >R DABS R> UT* R> R> SWAP >R UT/MOD
  R> 0< IF DNEGATE ROT IF 1. D- THEN ELSE ROT DROP THEN ;
CREATE RESIZE-BLOCK 16 ALLOT
: RESIZE-FILE ( ud fileid --- ior )   \ ftruncate: SYSCALL's block holds 64-bit arguments
  RESIZE-BLOCK 16 ERASE RESIZE-BLOCK ! DROP RESIZE-BLOCK 8 + ! RESIZE-BLOCK 77 SYSCALL 0<> ;
: WID-SAVE ( wid --- a )   \ a wordlist's count and threads, copied to the heap
  DUP @ 1+ CELLS DUP ALLOCATE DROP DUP >R SWAP CMOVE R> ;
: MARKER ( "name" --- )   \ the current wordlist's threads, LAST and HERE, as before name
  HERE LAST @ CURRENT @ DUP WID-SAVE
  CREATE , , , ,
  DOES> DUP @ OVER CELL+ @ OVER @ 1+ CELLS CMOVE
        DUP CELL+ @ CURRENT !  DUP 2 CELLS + @ LAST !  3 CELLS + @ DP ! ;
\ A word here is found while it is compiled, so a new definition that calls the
\ old takes the old one's xt first - else it calls itself.
' SET-ORDER CONSTANT 'SET-ORDER
: SET-ORDER ( widn ... wid1 n --- )   \ -1 is ONLY; 0 an empty order (extend.4's loop
  DUP -1 = IF DROP ONLY EXIT THEN       \ ran from -1 down through memory: searchordertest)
  DUP 0= IF #ORDER ! EXIT THEN  'SET-ORDER EXECUTE ;
' SET-ORDER CONSTANT 'SET-ORDER-1
GET-CURRENT ROOT-WORDLIST SET-CURRENT
: FORTH-WORDLIST ( --- wid )  [ FORTH-WORDLIST ] LITERAL ;
: SET-ORDER ( widn ... wid1 n --- )  'SET-ORDER-1 EXECUTE ;
SET-CURRENT
\ The fifth wave (Iteration 170): coreexttest at VALUE, doubletest at 2VALUE,
\ toolstest at [DEFINED], filetest at RENAME-FILE, searchordertest at C".
: VALUE ( x "name" --- )  CREATE 1 , , DOES> CELL+ @ ;          \ the kind first: TO
: 2VALUE ( x1 x2 "name" --- )  CREATE 2 , , , DOES> CELL+ 2@ ;  \ stores one cell or two
: TO ( i*x "name" --- )
  ' >BODY DUP CELL+ SWAP @ 2 =
  STATE @ IF SWAP POSTPONE LITERAL IF POSTPONE 2! ELSE POSTPONE ! THEN
          ELSE IF 2! ELSE ! THEN THEN ; IMMEDIATE
: [DEFINED] ( "name" --- flag )  BL WORD FIND NIP 0<> ; IMMEDIATE
: [UNDEFINED] ( "name" --- flag )  BL WORD FIND NIP 0= ; IMMEDIATE
: ZPLACE ( c-addr u buf --- )  2DUP + 0 SWAP C! SWAP CMOVE ;   \ zero-terminated at buf
CREATE RENAME-BLOCK 16 ALLOT  CREATE RENAME-PATHS 512 ALLOT
: RENAME-FILE ( c-addr1 u1 c-addr2 u2 --- ior )   \ rename: two paths in SYSCALL's block
  RENAME-PATHS 256 + ZPLACE RENAME-PATHS ZPLACE
  RENAME-BLOCK 16 ERASE RENAME-PATHS RENAME-BLOCK ! RENAME-PATHS 256 + RENAME-BLOCK 8 + !
  RENAME-BLOCK 82 SYSCALL 0<> ;
: C" ( "ccc<quote>" --- ) ( run time: --- c-addr )   \ the counted string kept on the heap
  34 PARSE DUP 1+ ALLOCATE DROP DUP >R 2DUP C! 1+ SWAP CMOVE R> POSTPONE LITERAL ; IMMEDIATE
\ The sixth wave (Iteration 170). RECURSE in :NONAME: the kernel's and the
\ byte compilers' RECURSE call LAST's word - a :NONAME has no header, so its
\ own xt is kept, and used while no header is newer (coreexttest).
\ :NONAME by the design's own : - an xt is what that : makes (a tag-2 design's
\ COMPILE, tells a colon xt by what its : writes; HERE alone failed
\ coreexttest's COMPILE, test on every one), and RECURSE finds it through
\ LAST like any other. A new name each time: the kernel warns on a name it
\ finds, and has no switch (Iteration 171).
CREATE NONAME-SRC 32 ALLOT  VARIABLE NONAMES  0 NONAMES !
: :NONAME ( --- xt colon-sys )
  1 NONAMES +!  S" : (NONAME" NONAME-SRC SWAP CMOVE
  NONAMES @ 0 <# [CHAR] ) HOLD #S #> TUCK NONAME-SRC 9 + SWAP CMOVE
  NONAME-SRC SWAP 9 + EVALUATE  LAST @ NAME> !CSP ;   \ : took the depth before the xt: again after it
: .( ( "ccc<paren>" --- )  [CHAR] ) PARSE TYPE ; IMMEDIATE
: .WID ( wid --- )   \ by name: a wid is an address, and differs by design
  DUP FORTH-WORDLIST = IF DROP ." FORTH " EXIT THEN ROOT-WORDLIST = IF ." ROOT " EXIT THEN ." WORDLIST " ;
: ORDER ( --- )  GET-ORDER 0 ?DO .WID LOOP CR GET-CURRENT .WID CR ;   \ searchordertest
: N>R ( xn .. x1 n --- ) ( R: --- x1 .. xn n )   \ the standard's reference design
  DUP BEGIN DUP WHILE ROT R> SWAP >R >R 1- REPEAT DROP R> SWAP >R >R ;
: NR> ( --- xn .. x1 n ) ( R: x1 .. xn n --- )
  R> R> SWAP >R DUP BEGIN DUP WHILE R> R> SWAP >R ROT ROT 1- REPEAT DROP ;
: UNESCAPE ( c-addr1 len1 c-addr2 --- c-addr2 len2 )   \ each % doubled (stringtest)
  DUP 2SWAP OVER + SWAP ?DO
    I C@ [CHAR] % = IF [CHAR] % OVER C! 1+ THEN I C@ OVER C! 1+
  LOOP OVER - ;
CREATE STAT-BLOCK 16 ALLOT  CREATE STAT-PATH 256 ALLOT  CREATE STAT-BUF 256 ALLOT
: FILE-STATUS ( c-addr u --- x ior )   \ stat: 0 and its result (filetest)
  STAT-PATH ZPLACE STAT-BLOCK 16 ERASE STAT-PATH STAT-BLOCK ! STAT-BUF STAT-BLOCK 8 + !
  0 STAT-BLOCK 4 SYSCALL 0<> ;
