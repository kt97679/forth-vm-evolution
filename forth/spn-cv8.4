\ spn-cv8.4 - SPN: Stencil-Patched Native, on a CV8 image.
\
\ The same translator as spn-full.4, reading CV8 byte code instead of
\ cells. Load on the SPN-CV8 engine (build/spn-cv8-64) into the byte-
\ header CV8 image. Operand sizes follow engine/vm-lab.c as built for
\ that stage; forth/spn-cv8-decode.4 has the decoder's own check.
\
\ A translated word's body starts [126][lo][hi]: SPN-ENTER and the
\ native code's offset in 16-byte units. Three bytes, so a shorter body
\ cannot be patched; words that short are inlined into native callers.
\ Working tables are allocated at start-up, not kept in the image.
\ x86-64 only.

DECIMAL
0 CONSTANT FALSE                       \ not in this kernel
1024 CONSTANT MAX-BYTES                \ the longest body SPN translates
: NIP ( x1 x2 --- x2 )  SWAP DROP ;
: 0<> ( x --- f )  0= 0= ;
: CFILL ( a-addr u-cells x --- )       \ fill whole cells
  >R CELLS OVER + SWAP
  BEGIN 2DUP > WHILE R@ OVER ! CELL+ REPEAT 2DROP R> DROP ;
1 CELLS 8 = CONSTANT X86?             \ 8-byte cells: x86-64; 4: 32-bit ARM (Iteration 31)
X86? 1 AND 2 + CONSTANT CELL-SHIFT    \ log2 of a cell's bytes: 3, or 2
: BUFFER ( bytes --- a-addr )          \ on the heap, not filled
  7 + -8 AND ALLOCATE ABORT" SPN: no memory" ;
: TABLE ( bytes --- a-addr )           \ zeroed, on the heap
  7 + -8 AND DUP ALLOCATE ABORT" SPN: no memory"
  SWAP CELL-SHIFT RSHIFT OVER SWAP 0 CFILL ;

\ ---- the engine: opcode 127 and a selector ----
: SPN-TABLE  [ 127 C, 0 C, ] ;   ( --- a-addr n )
: SPN-EXEC   [ 127 C, 1 C, ] ;   ( u --- a-addr )
: SPN-CALL   [ 127 C, 2 C, ] ;   ( i*x a-addr --- j*x )
: SPN-IO [ 127 C, 6 C, ] ;       ( --- io-helper )   \ engines with READ/WRITE stencils
: SPN-ENGINE [ 127 C, 4 C, ] ;   ( --- rp-addr helper code-base-addr )
: SPN-HOOK!  [ 127 C, 5 C, ] ;   \ ( xt --- )  the on-demand hook
: SPN-SYNC   [ 127 C, 7 C, ] ;   \ ( a u --- )  ARM only: new code made visible to instruction fetch
126 CONSTANT OP-ENTER
VARIABLE ENTRIES  VARIABLE #ENTRIES
VARIABLE M-NEXT   VARIABLE M-JUMP   VARIABLE M-CALL
VARIABLE RP-ADDR  VARIABLE INTERP-FN  VARIABLE IO-FN
: ENTRY ( i --- a-addr )  CELLS ENTRIES @ + @ ;

\ Stencils, by position in engine/spn-stencils.c's table.
 3 CONSTANT S-LIT      4 CONSTANT S-DUP      5 CONSTANT S-DROP
 6 CONSTANT S-SWAP     7 CONSTANT S-OVER     8 CONSTANT S-ROT
 9 CONSTANT S-PLUS    10 CONSTANT S-ADDI    11 CONSTANT S-EQ
12 CONSTANT S-GT      13 CONSTANT S-LT      14 CONSTANT S-XOR
15 CONSTANT S-AND     16 CONSTANT S-NEGATE  17 CONSTANT S-0BRANCH
18 CONSTANT S-BRANCH  19 CONSTANT S-CALL    20 CONSTANT S-EXIT
21 CONSTANT S-ADDI32  22 CONSTANT S-DUPLTBR 23 CONSTANT S-TOR
24 CONSTANT S-FROMR   25 CONSTANT S-RFETCH  26 CONSTANT S-FETCH
27 CONSTANT S-STORE   28 CONSTANT S-CFETCH  29 CONSTANT S-CSTORE
30 CONSTANT S-OR      31 CONSTANT S-ULT     32 CONSTANT S-LSHIFT
33 CONSTANT S-RSHIFT  34 CONSTANT S-INTERP  35 CONSTANT S-DO
36 CONSTANT S-QDO     37 CONSTANT S-LOOP    38 CONSTANT S-PLOOP
39 CONSTANT S-I       40 CONSTANT S-J       41 CONSTANT S-UNLOOP
42 CONSTANT S-LEAVE   43 CONSTANT S-PICK
\ ?BRANCH fused with what makes its flag (spn-stencils.c): 0= DUP = U< < n= - OR
44 CONSTANT S-NZBR    45 CONSTANT S-DUPBR   46 CONSTANT S-NEBR
47 CONSTANT S-UGEBR   48 CONSTANT S-GEBR    49 CONSTANT S-NEIBR
50 CONSTANT S-EQBR    51 CONSTANT S-ORBR
52 CONSTANT S-WRITE   53 CONSTANT S-READ    \ engines built with SPN_IO
64 CONSTANT MAX-STENCILS

\ ---- ARCH: x86-64, or 32-bit ARM in ARM state (Iteration 31) ----
\ Every literal fits 32 bits - x86-64's 8-byte markers are built from
\ 16-bit pieces - so a 32-bit system reads the x86-64 rules, and never
\ runs them. The markers are engine/spn-stencils.c's SPN_*_VALUE.
: 4H ( a b c d --- n )  >R >R >R 16 LSHIFT R> OR 16 LSHIFT R> OR 16 LSHIFT R> OR ;
: 2H ( a b --- n )  SWAP 16 LSHIFT OR ;
: (IMM) X86? IF 24225 60766 41453 24225 4H ELSE 24225 60673 2H THEN ;
: (RP)  X86? IF 32417 60766 41453 24183 4H ELSE 32417 60674 2H THEN ;
: (FN)  X86? IF 28321 60766 41453 24166 4H ELSE 28321 60675 2H THEN ;
: (IO)  X86? IF 20129 60766 41453 24132 4H ELSE 20129 60676 2H THEN ;
(IMM) CONSTANT IMM-MARK
(RP) CONSTANT RP-MARK
(FN) CONSTANT FN-MARK
(IO) CONSTANT IO-MARK   \ the I/O helper (READ, WRITE)
1008361079 CONSTANT IMM32-MARK
233 CONSTANT OP-JMP   195 CONSTANT OP-RET
: ENDBR? ( a --- f )
  X86? 0= IF DROP 0 EXIT THEN
  DUP C@ 243 = OVER 1+ C@ 15 = AND OVER 2 + C@ 30 = AND SWAP 3 + C@ 250 = AND ;
: L@ ( a --- u )
  DUP C@  OVER 1+ C@ 8 LSHIFT OR  OVER 2 + C@ 16 LSHIFT OR  SWAP 3 + C@ 24 LSHIFT OR ;
: SL@ ( a --- n )  L@ X86? IF DUP 1 31 LSHIFT AND IF 1 32 LSHIFT - THEN THEN ;
: L! ( u a --- )
  OVER 255 AND OVER C!  OVER 8 RSHIFT 255 AND OVER 1+ C!
  OVER 16 RSHIFT 255 AND OVER 2 + C!  SWAP 24 RSHIFT 255 AND SWAP 3 + C! ;
: REL-TO-X86? ( a target --- f )  >R DUP SL@ + 4 + R> = ;
: REL-OP-X86? ( a --- f )
  DUP 1- C@ DUP 232 = SWAP 233 = OR IF DROP TRUE EXIT THEN
  DUP 2 - C@ 15 =  SWAP 1- C@ 240 AND 128 = AND ;
\ 32-bit ARM: every instruction one little-endian word. B/BL: cond 101L
\ imm24, the target the instruction's address + 8 + imm24*4. A hole is a
\ movw then a movt to one register, 16 bits each, split imm4:imm12.
-16777216 CONSTANT HI8                 \ FF000000: cond and opcode
-516948194 CONSTANT BX-LR              \ E12FFF1E
-369098752 CONSTANT B-AL               \ EA000000: b, always
: B? ( w --- f )  234881024 AND 167772160 = ;
: B-TARGET ( a --- target )
  DUP L@ 16777215 AND  DUP 8388608 AND IF 16777216 - THEN  2 LSHIFT  + 8 + ;
: REL-TO-ARM? ( a target --- f )  OVER L@ B? IF SWAP B-TARGET = ELSE 2DROP 0 THEN ;
: IMM16 ( w --- u )  DUP 4 RSHIFT 61440 AND  SWAP 4095 AND OR ;
: MOVW? ( w --- f )  267386880 AND 50331648 = ;
: MOVT? ( w --- f )  267386880 AND 54525952 = ;
: REG-RD ( w --- r )  12 RSHIFT 15 AND ;
: PAIR? ( a u --- f )
  >R  DUP L@  SWAP 4 + L@
  OVER MOVW?  OVER MOVT? AND
  2 PICK REG-RD  2 PICK REG-RD = AND
  ROT IMM16  R@ 65535 AND = AND
  SWAP IMM16  R> 16 RSHIFT 65535 AND = AND ;
: IMM16! ( u a --- )
  >R  DUP 61440 AND 4 LSHIFT  SWAP 4095 AND OR
  R@ L@  61440 4 LSHIFT 4095 OR INVERT AND  OR  R> L! ;
: PAIR! ( v a --- )  OVER 65535 AND OVER IMM16!  SWAP 16 RSHIFT 65535 AND SWAP 4 + IMM16! ;
: REL-TO? ( a target --- f )  X86? IF REL-TO-X86? ELSE REL-TO-ARM? THEN ;
: REL-OP? ( a --- f )  X86? IF REL-OP-X86? ELSE L@ B? THEN ;
: REL! ( target a --- )
  X86? IF  DUP >R 4 + - R> L!  EXIT THEN
  >R  R@ 8 + -  2 RSHIFT 16777215 AND   R@ L@ HI8 AND OR  R> L! ;
4 X86? 1 AND + CONSTANT TAIL-LEN      \ the dropped "jmp/b NEXT": 5 bytes, or 4
: INT32? ( n --- f )  DUP -2147483648 < 0=  SWAP 2147483647 > 0= AND ;

\ ---- the working tables, allocated by SPN-INIT ----
VARIABLE ST-START VARIABLE ST-LEN VARIABLE ST-NH VARIABLE ST-HOLES VARIABLE ST-MASK
VARIABLE C-NAT  VARIABLE C-DEP  VARIABLE FIXUPS  VARIABLE TGTS  VARIABLE CALLS
VARIABLE PMAP   VARIABLE PRIMBODY
\ In the image, not on the heap: a recipe records an S-INTERP's target
\ as an image offset, and a heap address has none.
CREATE PRIMBODY-AREA 160 ALLOT
: ST@ ( i table --- n )  @ SWAP CELLS + @ ;
: ST! ( n i table --- )  @ SWAP CELLS + ! ;

\ ---- reading the stencils, once per run ----
: ST-SRC ( i --- a )  ENTRY DUP ENDBR? IF 4 + THEN ;
VARIABLE LOWER
: BOUND ( i --- a )   \ the nearest entry above; 4096 only if there is none
  ENTRY DUP LOWER !  4096 +
  #ENTRIES @ 0 DO
    I ENTRY  LOWER @ OVER <  OVER 3 PICK <  AND IF NIP ELSE DROP THEN
  LOOP ;
: BODY-END-ARM ( i --- a )
  DUP S-EXIT = IF  ST-SRC BEGIN DUP L@ BX-LR <> WHILE 4 + REPEAT 4 + EXIT  THEN
  DUP ST-SRC SWAP BOUND OVER  ROT ROT SWAP DO
    I M-NEXT @ REL-TO?  I M-JUMP @ REL-TO? OR IF DROP I 4 + THEN
  4 +LOOP ;
: BODY-END ( i --- a )
  X86? 0= IF BODY-END-ARM EXIT THEN
  DUP S-EXIT = IF  ST-SRC BEGIN DUP C@ OP-RET <> WHILE 1+ REPEAT 1+ EXIT  THEN
  DUP ST-SRC SWAP BOUND OVER  ROT ROT SWAP DO
    I C@ OP-JMP = IF
      I 1+ M-NEXT @ REL-TO?  I 1+ M-JUMP @ REL-TO? OR IF DROP I 5 + THEN
    THEN
  LOOP ;
: TAIL-NEXT? ( i --- f )
  X86? IF
    DUP BODY-END 5 -  DUP C@ OP-JMP =  SWAP 1+ M-NEXT @ REL-TO? AND
  ELSE
    DUP BODY-END 4 -  DUP L@ HI8 AND B-AL =  SWAP M-NEXT @ REL-TO? AND
  THEN SWAP S-EXIT <> AND ;
VARIABLE SI  VARIABLE SSRC  VARIABLE SLEN
: HOLE, ( offset kind --- )
  1 OVER LSHIFT SI @ ST-MASK ST@ OR SI @ ST-MASK ST!   \ which kinds it has
  SWAP 8 * +  SI @ 8 * SI @ ST-NH ST@ + CELLS ST-HOLES @ + !
  SI @ ST-NH ST@ 1+ SI @ ST-NH ST! ;
: SCAN-ARM ( --- )   \ every 4th byte: branches to the markers, and movw/movt holes
  SLEN @ 0 ?DO
    SSRC @ I +
    DUP REL-OP? IF
      DUP M-NEXT @ REL-TO? IF I 0 HOLE, THEN
      DUP M-JUMP @ REL-TO? IF I 1 HOLE, THEN
      DUP M-CALL @ REL-TO? IF I 2 HOLE, THEN
    THEN
    I 8 + SLEN @ > 0= IF
      DUP IMM-MARK   PAIR? IF I 3 HOLE, THEN
      DUP IMM32-MARK PAIR? IF I 4 HOLE, THEN
      DUP RP-MARK    PAIR? IF I 5 HOLE, THEN
      DUP FN-MARK    PAIR? IF I 6 HOLE, THEN
      DUP IO-MARK    PAIR? IF I 7 HOLE, THEN
    THEN
    DROP
  4 +LOOP ;
: SCAN-STENCIL ( i --- )
  DUP SI !  DUP ST-SRC SSRC !
  DUP BODY-END OVER ST-SRC -  OVER TAIL-NEXT? IF TAIL-LEN - THEN  SLEN !
  SSRC @ OVER ST-START ST!  SLEN @ SWAP ST-LEN ST!
  0 SI @ ST-NH ST!
  X86? 0= IF SCAN-ARM EXIT THEN
  SLEN @ 0 ?DO
    SSRC @ I +
    I 4 + SLEN @ > 0= IF
      DUP REL-OP? IF
        DUP M-NEXT @ REL-TO? IF I 0 HOLE, THEN
        DUP M-JUMP @ REL-TO? IF I 1 HOLE, THEN
        DUP M-CALL @ REL-TO? IF I 2 HOLE, THEN
      THEN
      DUP L@ IMM32-MARK = IF I 4 HOLE, THEN
    THEN
    I 8 + SLEN @ > 0= IF
      DUP @ IMM-MARK = IF I 3 HOLE, THEN
      DUP @ RP-MARK  = IF I 5 HOLE, THEN
      DUP @ FN-MARK  = IF I 6 HOLE, THEN
      DUP @ IO-MARK  = IF I 7 HOLE, THEN
    THEN
    DROP
  LOOP ;

\ ---- the code buffer ----
1048576 CONSTANT CODE-SIZE
VARIABLE CODE-BASE  VARIABLE CODE-HERE  VARIABLE CODE-LIMIT

\ ---- emitting one stencil ----
VARIABLE ARG-IMM  VARIABLE ARG-CALL  VARIABLE ARG-JUMP  VARIABLE E-DST
VARIABLE T-SRC  VARIABLE T-NAT  VARIABLE #FIX

\ ---- recipes: translation decided when the image is built ----
\ As in spn-full.4: the build translates once with RECORDING on and
\ writes each word's decisions into the image; boot replays them -
\ copying stencils and filling holes, no decoding, no validation.
\ Stencil bytes and hole offsets are still read from the running
\ engine; a signature of the hole kinds guards against a mismatch.
\
\ Per word: the xt's byte offset from START, ops, 255. An op is one
\ byte - stencil index, +64 if its literal is an image address, +128
\ if it calls its own word - then the fields its holes need: literal,
\ jump target (bytes from the word's start), callee (xt offset). 254
\ and an offset mark a branch target, so jumps to it can be resolved.
\ Every literal that is an image address is flagged where it is made,
\ never guessed from its value.
VARIABLE RECORDING  0 RECORDING !
\ The recorder is in forth/spn-cv8-build.4, loaded only to build an image
\ and not saved in it. Running code reaches it only through this hook,
\ ( x selector --- ): 0 an op, 1 a possible branch target, 2 a word's
\ start, 3 its end - so no running word calls a build-only word, and
\ the tree walk never reaches one.
VARIABLE RECORD-HOOK  0 RECORD-HOOK !
VARIABLE ALL-END  0 ALL-END !   \ if set: TRANSLATE-ALL stops at this offset
VARIABLE ARG-RELOC  0 ARG-RELOC !     \ ARG-IMM is an address in the image
VARIABLE ARG-CXT    0 ARG-CXT !       \ an S-CALL's callee xt; 0 for itself
VARIABLE RCP-OFF  0 RCP-OFF !   VARIABLE RCP-LEN  0 RCP-LEN !
VARIABLE RCP-SIG  0 RCP-SIG !
VARIABLE RD
: B@+ ( --- b )  RD @ C@  1 RD +! ;
: UV@ ( --- u )
  0 0 BEGIN B@+ DUP >R 127 AND OVER LSHIFT ROT OR SWAP 7 + R> 128 AND 0= UNTIL DROP ;
: SV@ ( --- n )  UV@ DUP 1 AND IF 1 RSHIFT INVERT ELSE 1 RSHIFT THEN ;
: FIX, ( native src --- )
  #FIX @ 256 < 0= ABORT" SPN: too many branches"
  #FIX @ 2 * CELLS FIXUPS @ +  DUP >R CELL+ !  R> !  1 #FIX +! ;
: HOLE-VALUE ( kind --- v )   \ what a hole of kind 3-7 holds
  DUP 5 = IF DROP RP-ADDR @ EXIT THEN
  DUP 6 = IF DROP INTERP-FN @ EXIT THEN
  7 = IF IO-FN @ EXIT THEN  ARG-IMM @ ;
: PATCH-HOLE ( hole --- )
  DUP 7 AND SWAP 3 RSHIFT E-DST @ +
  OVER 0 = IF NIP  E-DST @ SI @ ST-LEN ST@ +  SWAP REL! EXIT THEN
  OVER 1 = IF NIP  ARG-JUMP @ FIX, EXIT THEN
  OVER 2 = IF NIP  ARG-CALL @ SWAP REL! EXIT THEN
  X86? 0= IF SWAP HOLE-VALUE SWAP PAIR! EXIT THEN    \ ARM: every value hole a movw/movt pair
  OVER 3 = IF NIP  ARG-IMM @ SWAP ! EXIT THEN
  OVER 4 = IF NIP  ARG-IMM @ -1 32 RSHIFT AND SWAP L! EXIT THEN
  OVER 5 = IF NIP  RP-ADDR @ SWAP ! EXIT THEN
  OVER 6 = IF NIP  INTERP-FN @ SWAP ! EXIT THEN
  NIP IO-FN @ SWAP ! ;
: EMIT-ST ( i --- )
  RECORDING @ IF DUP 0 RECORD-HOOK @ EXECUTE THEN
  DUP SI !
  CODE-HERE @ OVER ST-LEN ST@ + CODE-LIMIT @ > ABORT" SPN: code buffer full"
  CODE-HERE @ E-DST !
  DUP ST-START ST@  E-DST @  ROT ST-LEN ST@  CMOVE
  SI @ ST-NH ST@ 0 ?DO
    SI @ 8 * I + CELLS ST-HOLES @ + @ PATCH-HOLE
  LOOP
  SI @ ST-LEN ST@ CODE-HERE +!
  0 ARG-RELOC !  0 ARG-CXT ! ;

\ ---- primitives: which stencil, or run it by re-entry ----
\ By the kernel's PRIMITIVE order, which CV8 keeps with ESCAPE off.
\ -1: none, re-enter a two-byte CV8 body [prim][EXIT]; -2: never.
: PM! ( stencil prim --- )  PMAP @ SWAP CELLS + ! ;
\ Unsigned, so ANY value is safe: SIMPLE-OP? computes OP-V @ PM@ for
\ every operation, literals included, and a signed 80 < let a negative
\ literal through as an index - -2147483647 read gigabytes off the table.
: PM@ ( prim --- stencil )  DUP 80 U< IF PMAP @ SWAP CELLS + @ ELSE DROP -2 THEN ;
: INIT-PMAP
  80 0 DO -1 I PM! LOOP
  S-DROP 5 PM!   S-DUP 6 PM!    S-SWAP 7 PM!   S-ROT 8 PM!    S-OVER 9 PM!
  S-CFETCH 10 PM! S-FETCH 11 PM! S-CSTORE 12 PM! S-STORE 13 PM!
  S-AND 14 PM!   S-OR 15 PM!    S-XOR 16 PM!   S-FROMR 17 PM! S-TOR 18 PM!
  S-RFETCH 19 PM! S-EQ 20 PM!   S-ULT 21 PM!   S-LT 22 PM!    S-PLUS 23 PM!
  S-NEGATE 24 PM! S-LSHIFT 25 PM! S-RSHIFT 26 PM!
  -2 33 PM! -2 34 PM! -2 35 PM! -2 36 PM!
  -2 2 PM! -2 3 PM! -2 4 PM!    \ LIT BRANCH ?BRANCH: decoded apart
  80 68 DO -2 I PM! LOOP
  #ENTRIES @ 54 = IF S-WRITE 30 PM!  S-READ 31 PM! THEN ;
: INIT-PRIMBODY   \ CV8 bodies: [prim][EXIT], two bytes each
  68 0 DO  I PRIMBODY @ I 2 * + C!  1 PRIMBODY @ I 2 * + 1+ C!  LOOP ;

\ ---- decoding CV8: one operation (see spn-cv8-decode.4) ----
 0 CONSTANT K-BAD     1 CONSTANT K-PRIM    2 CONSTANT K-LIT     3 CONSTANT K-LITX
 4 CONSTANT K-FOLD    5 CONSTANT K-BR      6 CONSTANT K-QBR     7 CONSTANT K-CALL
 8 CONSTANT K-TINY    9 CONSTANT K-ADDI   10 CONSTANT K-ADDIX  11 CONSTANT K-EQI
12 CONSTANT K-EQIX   13 CONSTANT K-VF     14 CONSTANT K-VS     15 CONSTANT K-DOVAR
16 CONSTANT K-DODOES
VARIABLE OP-K  VARIABLE OP-V
: LD16 ( a --- u )  DUP C@ SWAP 1+ C@ 8 LSHIFT OR ;
: SX8  ( u --- n )  DUP 128 AND IF 256 - THEN ;
: SX16 ( u --- n )  DUP 32768 AND IF 65536 - THEN ;
CREATE FOLDMAP
  23 , 20 , 13 , 11 , 25 , 26 , 10 , 12 , 14 , 15 , 16 ,  2 ,
  22 , 21 ,  9 ,  5 ,  6 ,  7 ,  8 , 18 , 17 , 19 , 24 ,
: SLOT@ ( a --- a' addr )
  DUP C@ 128 AND IF
    DUP C@ 127 AND 16 LSHIFT OVER 1+ C@ 8 LSHIFT OR OVER 2 + C@ OR SWAP 3 + SWAP
  ELSE
    DUP C@ 8 LSHIFT OVER 1+ C@ OR SWAP 2 + SWAP
  THEN START @ + ;
: KV ( v k --- )  OP-K ! OP-V ! ;
: DECODE ( a --- a' )
  DUP C@
  DUP 128 U< 0= IF
    DUP 64 AND IF
      63 AND 16 LSHIFT OVER 1+ C@ 8 LSHIFT OR OVER 2 + C@ OR
      START @ + K-CALL KV 3 + EXIT
    THEN
    63 AND 8 LSHIFT OVER 1+ C@ OR START @ + K-CALL KV 2 + EXIT
  THEN
  DUP 2 = IF DROP DUP 1+ LD16 K-LIT KV 3 + EXIT THEN
  DUP 3 = IF DROP DUP 1+ DUP LD16 SX16 + K-BR KV 3 + EXIT THEN
  DUP 4 = IF DROP DUP 1+ DUP LD16 SX16 + K-QBR KV 3 + EXIT THEN
  DUP 68 < IF K-PRIM KV 1+ EXIT THEN
  DUP 68 = IF DROP DUP 1+ SL@ K-LIT KV 5 + EXIT THEN
  DUP 69 = IF DROP 0 K-DOVAR KV 1+ EXIT THEN
  DUP 70 = IF DROP 0 K-DODOES KV 1+ EXIT THEN
  DUP 71 = IF DROP DUP 1+ C@ K-LIT KV 2 + EXIT THEN
  DUP 72 = IF DROP DUP 1+ C@ K-LITX KV 2 + EXIT THEN
  DUP 84 = IF DROP DUP 1+ LD16 K-LITX KV 3 + EXIT THEN
  DUP 96 < IF 73 - CELLS FOLDMAP + @ K-FOLD KV 1+ EXIT THEN
  DUP 96 = IF DROP 0 K-LIT KV 1+ EXIT THEN
  DUP 97 = IF DROP 1 K-LIT KV 1+ EXIT THEN
  DUP 98 = IF DROP -1 K-LIT KV 1+ EXIT THEN
  DUP 99 = IF DROP 1+ SLOT@ K-VF KV EXIT THEN
  DUP 100 = IF DROP 1+ SLOT@ K-VS KV EXIT THEN
  DUP 105 < IF K-BAD KV 1+ EXIT THEN
  DUP 120 < IF 105 - K-TINY KV 1+ EXIT THEN
  DUP 124 < IF 120 - >R DUP 1+ C@ SX8 R> K-ADDI + KV 2 + EXIT THEN
  DUP 124 = IF DROP DUP 1+ @ K-LIT KV 9 + EXIT THEN
  K-BAD KV 1+ ;
: EXIT-OP? ( --- f )     \ does the operation just decoded end in EXIT?
  OP-K @ K-PRIM = OP-V @ 1 = AND
  OP-K @ K-FOLD = OR  OP-K @ K-LITX = OR  OP-K @ K-ADDIX = OR  OP-K @ K-EQIX = OR ;

: IN-DICT? ( a --- f )  DUP START @ < 0=  SWAP HERE < AND ;
\ ON DEMAND. An entry [126][lo][hi] whose offset is LAZY-BASE or more is
\ a word not translated yet: the engine runs LAZY-HIT in its place. Its
\ original three bytes are kept in LZ-TAB, by index = offset - LAZY-BASE.
61440 CONSTANT LAZY-BASE
VARIABLE LZ-TAB  0 LZ-TAB !  VARIABLE LZ-N  0 LZ-N !  VARIABLE LAZY-ON  0 LAZY-ON !
VARIABLE LZ-OFF  0 LZ-OFF !  VARIABLE LZ-LEN  0 LZ-LEN !     \ the list, in the image
: LAZY? ( a --- f )   DUP C@ 126 = IF 1+ LD16 LAZY-BASE < 0= ELSE DROP FALSE THEN ;
\ Where compiled calls actually ENTER a word. CV8 pads some bodies with
\ leading NOOPs for alignment, and a call targets the first real
\ operation - HEADER's xt is 4135 but : calls 4136. Patching at the xt
\ put SPN-ENTER's address bytes exactly where every compiled call lands.
\ Patching here serves both routes: through the padding, or straight in.
: ENTRY-OF ( xt --- a )  BEGIN DUP C@ 0= WHILE 1+ REPEAT ;

\ ---- kernel words SPN must recognise, as offsets from START ----
\ ' gives the address a word had when this file was loaded; a saved
\ image lands somewhere else each run, so boot adds START back.
VARIABLE DO-XT  VARIABLE QDO-XT  VARIABLE LOOP-XT    VARIABLE PLOOP-XT
VARIABLE I-XT   VARIABLE J-XT    VARIABLE UNLOOP-XT  VARIABLE LEAVE-XT
VARIABLE PICK-XT VARIABLE SQ-XT  VARIABLE DQ-XT      VARIABLE AQ-XT
VARIABLE TYPE-XT VARIABLE AM-XT
' (DO)    START @ - CONSTANT DO-OFF      ' (?DO)   START @ - CONSTANT QDO-OFF
' (LOOP)  START @ - CONSTANT LOOP-OFF    ' (+LOOP) START @ - CONSTANT PLOOP-OFF
' I       START @ - CONSTANT I-OFF       ' J       START @ - CONSTANT J-OFF
' UNLOOP  START @ - CONSTANT UNLOOP-OFF  ' (LEAVE) START @ - CONSTANT LEAVE-OFF
' PICK    START @ - CONSTANT PICK-OFF    ' (S")    START @ - CONSTANT SQ-OFF
' (.")    START @ - CONSTANT DQ-OFF      ' (ABORT") START @ - CONSTANT AQ-OFF
' TYPE    START @ - CONSTANT TYPE-OFF
\ 0 none 1 (DO) 2 (?DO) 3 (LOOP) 4 (+LOOP) 5 I 6 J 7 UNLOOP 8 (LEAVE) 9 PICK
\ Kinds 2 3 4 8 are followed by a cell: an offset from itself to a target.
: LOOP-KIND ( xt --- k )
  DUP DO-XT @ = IF DROP 1 EXIT THEN     DUP QDO-XT @ = IF DROP 2 EXIT THEN
  DUP LOOP-XT @ = IF DROP 3 EXIT THEN   DUP PLOOP-XT @ = IF DROP 4 EXIT THEN
  DUP I-XT @ = IF DROP 5 EXIT THEN      DUP J-XT @ = IF DROP 6 EXIT THEN
  DUP UNLOOP-XT @ = IF DROP 7 EXIT THEN DUP LEAVE-XT @ = IF DROP 8 EXIT THEN
  PICK-XT @ = IF 9 ELSE 0 THEN ;
: INLINE-CELL? ( k --- f )  DUP 2 = OVER 3 = OR OVER 4 = OR SWAP 8 = OR ;
: STRING-WORD? ( xt --- f )  DUP SQ-XT @ = OVER DQ-XT @ = OR SWAP AQ-XT @ = OR ;
: PAST-STRING ( a --- a' )  DUP C@ 1+ + ALIGNED ;

\ ---- does this code read its caller's return address? ----
\ Decodes linearly: R> or R@ before any >R or exit means yes. Inline
\ operands are stepped over; an unknown opcode, or running past
\ MAX-BYTES, counts as yes - the unsafe answer.
\ A memo, one byte per image byte, alive only during boot (allocated
\ with the map of names, freed with it): whether a word is inlinable,
\ and whether it reads its caller's return address. Both are properties
\ of the word's original code, which a boot never changes - inlinable
\ words are never patched, and a patched word is caught before the
\ memo is consulted. Without it one boot decoded 21,254 operations for
\ about 320 words: every call site classified twice, each time
\ decoding the callee again.
VARIABLE MEMO  0 MEMO !  VARIABLE MEMO-N  0 MEMO-N !
: MEMO@ ( xt --- a | 0 )
  MEMO @ IF START @ - DUP MEMO-N @ U< IF MEMO @ + EXIT THEN THEN DROP 0 ;
: MEMO! ( f m known-bit true-bit --- f )   \ record f at m, return f
  >R >R OVER IF R> R> OR ELSE R> R> DROP THEN  OVER C@ OR SWAP C! ;
: R-SCAN0 ( xt --- f )
  DUP MAX-BYTES + >R
  BEGIN DUP R@ < WHILE
    DECODE
    OP-K @ K-BAD = IF DROP R> DROP TRUE EXIT THEN
    OP-K @ K-DOVAR = OP-K @ K-DODOES = OR IF DROP R> DROP FALSE EXIT THEN
    OP-K @ K-PRIM = OP-K @ K-FOLD = OR IF
      OP-V @ 17 = OP-V @ 19 = OR IF DROP R> DROP TRUE EXIT THEN
      OP-V @ 18 = IF DROP R> DROP FALSE EXIT THEN
    THEN
    EXIT-OP? IF DROP R> DROP FALSE EXIT THEN
    OP-K @ K-CALL = IF
      OP-V @ LOOP-KIND INLINE-CELL? IF CELL+ THEN
      OP-V @ STRING-WORD? IF PAST-STRING THEN
    THEN
  REPEAT DROP R> DROP TRUE ;
: R-SCAN ( xt --- f )
  DUP ENTRY-OF C@ OP-ENTER = IF DROP FALSE EXIT THEN        \ translated: validated
  DUP MEMO@ ?DUP 0= IF R-SCAN0 EXIT THEN                    ( xt m )
  DUP C@ 8 AND IF NIP C@ 16 AND 0<> EXIT THEN
  SWAP R-SCAN0 SWAP 8 16 MEMO! ;

\ ---- a callee short enough to copy into its caller ----
\ A straight line of at most six simple operations ending in an exit:
\ no calls, no branches, nothing on the return stack. Constants and
\ primitives' own entries are such words, and so is CELL+ at two bytes.
: SIMPLE-OP? ( --- f )
  OP-K @ DUP K-LIT = OVER K-TINY = OR OVER K-ADDI = OR OVER K-EQI = OR
  OVER K-VF = OR OVER K-VS = OR SWAP K-PRIM = OP-V @ PM@ -2 <> AND OR ;
: FINAL-OP? ( --- f )   \ an exit whose other half is simple
  OP-K @ DUP K-LITX = OVER K-ADDIX = OR OVER K-EQIX = OR
  OVER K-PRIM = OP-V @ 1 = AND OR
  SWAP K-FOLD = OP-V @ PM@ -2 <> AND OP-V @ 17 <> AND OP-V @ 18 <> AND
  OP-V @ 19 <> AND OR ;
: INLINABLE0? ( xt --- f )
  6 0 DO
    DECODE
    FINAL-OP? IF DROP TRUE UNLOOP EXIT THEN
    SIMPLE-OP? OP-K @ K-PRIM = OP-V @ 17 = OP-V @ 18 = OR OP-V @ 19 = OR AND 0= AND
    0= IF DROP FALSE UNLOOP EXIT THEN
  LOOP DROP FALSE ;
: INLINABLE? ( xt --- f )
  DUP MEMO@ ?DUP 0= IF INLINABLE0? EXIT THEN                ( xt m )
  DUP C@ 2 AND IF NIP C@ 4 AND 0<> EXIT THEN
  SWAP INLINABLE0? SWAP 2 4 MEMO! ;

\ ---- classifying a word a native caller wants to call ----
\ 0 native  1 a literal: a variable's address  2 re-entry  3 refuse
\ 5 inline: copy its operations
VARIABLE C-VAL
: CLASSIFY ( xt --- kind )
  DUP IN-DICT? 0= IF DROP 3 EXIT THEN
  DUP ENTRY-OF LAZY? IF C-VAL ! 2 EXIT THEN          \ not translated yet: re-enter
  DUP ENTRY-OF C@ OP-ENTER = IF ENTRY-OF 1+ LD16 4 LSHIFT CODE-BASE @ + C-VAL ! 0 EXIT THEN
  DUP C@ 69 = IF 4 + ALIGNED C-VAL ! 1 EXIT THEN          \ DOVAR: a variable
  DUP C@ 70 = IF C-VAL ! 2 EXIT THEN                      \ DODOES: interpret
  DUP INLINABLE? IF C-VAL ! 5 EXIT THEN
  DUP R-SCAN IF DROP 3 EXIT THEN
  C-VAL ! 2 ;

\ ---- validating a word ----
VARIABLE T-FAR  VARIABLE T-DEP  VARIABLE T-END  VARIABLE #TGT  VARIABLE HWM
VARIABLE WHY  VARIABLE WHY-XT  VARIABLE #CALLS
\ Return-stack depth is checked PER PATH, as a bytecode verifier does.
\ It used to be tracked linearly: after an early exit, `IF R> DROP R>
\ BASE ! 0 EXIT THEN`, the walk carried on with the exit path's depth,
\ 0, where the fall-through still had 2 - and refused NUMBER?, >NUMBER,
\ FIND, ACCEPT, MOVE and NAME=?, all balanced on every path and all on
\ the hot path of anything that reads input. Now a forward branch
\ records the depth it arrives with; code after an unconditional jump
\ or a mid-word EXIT takes that depth instead of the dead fall-through;
\ where a fall-through and a jump meet they must agree (refusal 11); and
\ a backward branch must arrive with the depth seen at its target.
VARIABLE EXP-DEP  VARIABLE EHWM  0 EHWM !  VARIABLE DEAD  VARIABLE LT
VARIABLE VA          \ the operation being validated
\ REACH is false in code that only dead code falls into - after an EXIT
\ or an unconditional jump, before any jump arrives. Such code never
\ runs, so it records no expectations and is held to no depth: in
\ ACCEPT, `IF ... R> DROP EXIT ELSE ...` leaves ELSE's branch after the
\ EXIT, and that dead branch recorded depth 0 at THEN, where every real
\ path arrives with 1. And `0 UNTIL` - LIT 0, ?BRANCH - always jumps,
\ so nothing falls through it; that holds only if no jump lands on the
\ ?BRANCH itself, which is checked when the word is done (CZ).
VARIABLE REACH  VARIABLE PREV-ZERO  VARIABLE IS-TGT   \ a jump arrived here
CREATE CZ 8 CELLS ALLOT  VARIABLE #CZ
: IDX ( a --- i )  T-SRC @ - ;
\ T-LIM bounds decoding to the word's own body. Without it the decoder
\ can run on into the next header: LIT's entry is [LIT][EXIT], LIT takes
\ two operand bytes, so EXIT and BRANCH's link tag were read as LIT's
\ operand; decoding went on through BRANCH's header until something
\ looked like an exit, the word "validated", and the patch overwrote
\ BRANCH's link tag. A failed FIND then walked that thread off the image,
\ which faulted only when the memory there was unmapped - in about one
\ run in five. In a full pass the bound is the next word's link; for a
\ word just defined it is HERE.
VARIABLE T-LIM  0 T-LIM !
: INSIDE? ( a --- f )  DUP T-LIM @ < SWAP IDX DUP 0< 0= SWAP MAX-BYTES < AND AND ;
\ More targets than fit: fine for a translation, which records C-NAT
\ at every operation; fatal for a recipe, which marks only targets.
VARIABLE TGT-OVER
: TGT, ( a --- )
  #TGT @ 128 < IF #TGT @ CELLS TGTS @ + ! 1 #TGT +! ELSE DROP TRUE TGT-OVER ! THEN ;
: CALLEE, ( xt --- )  #CALLS @ 128 < IF #CALLS @ CELLS CALLS @ + ! 1 #CALLS +! ELSE DROP THEN ;
: TARGET-IN? ( a n --- f )   \ a branch target strictly inside [a, a+n)?
  OVER + SWAP  FALSE #TGT @ 0 ?DO
    I CELLS TGTS @ + @  2 PICK OVER < SWAP 4 PICK < AND OR
  LOOP NIP NIP ;
: TARGET? ( a --- f )  FALSE #TGT @ 0 ?DO OVER I CELLS TGTS @ + @ = OR LOOP NIP ;
: LOOP-TARGET ( a' --- a' )   \ a' is the operand cell
  DUP DUP @ +  DUP LT !  DUP TGT,  T-FAR @ MAX T-FAR ! ;
: EXPECT ( target depth --- f )   \ a branch arrives at target with depth
  OVER INSIDE? 0= IF 2DROP FALSE EXIT THEN
  OVER VA @ > IF                                  \ forward: record, or agree
    SWAP IDX DUP 1+ EHWM @ MAX EHWM !  CELLS EXP-DEP @ +
    DUP @ DUP 0< IF DROP ! TRUE EXIT THEN  NIP =
  ELSE                                            \ backward: as seen there
    SWAP IDX CELLS C-DEP @ + @ =
  THEN ;
: V-LOOP ( a' k --- a'' f )
  DUP 1 = IF DROP 2 T-DEP +! TRUE EXIT THEN
  DUP 2 = IF DROP 2 T-DEP +! LOOP-TARGET LT @ T-DEP @ 2 - EXPECT
    0= IF FALSE EXIT THEN CELL+ TRUE EXIT THEN
  DUP 9 = IF DROP TRUE EXIT THEN
  DUP 6 = IF DROP T-DEP @ 4 < 0= EXIT THEN
  T-DEP @ 2 < IF DROP FALSE EXIT THEN
  DUP 5 = IF DROP TRUE EXIT THEN
  DUP 7 = IF DROP -2 T-DEP +! TRUE EXIT THEN
  DUP 8 = IF DROP LOOP-TARGET LT @ T-DEP @ 2 - EXPECT
    0= IF FALSE EXIT THEN TRUE DEAD ! CELL+ TRUE EXIT THEN
  \ LOOP, +LOOP: back to the body, which must be at this same depth
  DROP DUP DUP @ + DUP TGT, T-DEP @ EXPECT 0= IF FALSE EXIT THEN
  -2 T-DEP +!  CELL+ TRUE ;
: PRIM-DEPTH ( p --- f )   \ a primitive's effect on return-stack depth
  DUP 18 = IF DROP 1 T-DEP +! TRUE EXIT THEN
  DUP 17 = IF DROP T-DEP @ IF -1 T-DEP +! TRUE ELSE 4 WHY ! FALSE THEN EXIT THEN
  DUP 19 = IF DROP T-DEP @ 0<> DUP 0= IF 5 WHY ! THEN EXIT THEN
  PM@ -2 = IF 6 WHY ! FALSE ELSE TRUE THEN ;
\ CLASSIFY, E-CALL and E-STRING decode OTHER words - the callee, to see
\ whether it can be inlined - and so overwrite OP-K and OP-V. Without
\ this, the caller's next test of EXIT-OP? would see the callee's last
\ operation, and a caller could be judged to end where its callee does.
VARIABLE SK  VARIABLE SV
: SAVE-OP ( --- )  OP-K @ SK !  OP-V @ SV ! ;
: REST-OP ( --- )  SK @ OP-K !  SV @ OP-V ! ;
: VALIDATE ( xt --- f )
  T-LIM @ 0= IF HERE T-LIM ! THEN
  DUP T-SRC !  0 T-FAR !  0 T-DEP !  0 #TGT !  0 #CALLS !  0 WHY !  0 TGT-OVER !
  C-DEP @ HWM @ -1 CFILL  0 HWM !
  EXP-DEP @ EHWM @ -1 CFILL  0 EHWM !  FALSE DEAD !
  TRUE REACH !  FALSE PREV-ZERO !  0 #CZ !
  BEGIN
    DUP INSIDE? 0= IF DROP 1 WHY ! FALSE EXIT THEN
    \ The depth here: a jump's record after dead code, else the
    \ fall-through, which must agree with any jump arriving here.
    DEAD @ IF FALSE REACH ! THEN  FALSE DEAD !
    DUP IDX CELLS EXP-DEP @ + @  DUP 0< 0= IS-TGT !
    DUP 0< 0= IF
      REACH @ IF T-DEP @ <> IF DROP 11 WHY ! FALSE EXIT THEN
      ELSE T-DEP !  TRUE REACH ! THEN
    ELSE DROP THEN
    T-DEP @ OVER IDX CELLS C-DEP @ + !  DUP IDX 1+ HWM @ MAX HWM !
    DUP VA !  DECODE                                     ( a' )
    OP-K @ K-BAD = OP-K @ K-DOVAR = OR OP-K @ K-DODOES = OR IF
      DROP 6 WHY ! FALSE EXIT THEN
    OP-K @ K-PRIM = OP-K @ K-FOLD = OR IF
      OP-V @ 1 <> IF
        REACH @ IF OP-V @ PRIM-DEPTH 0= IF DROP FALSE EXIT THEN
        ELSE OP-V @ PM@ -2 = IF DROP 6 WHY ! FALSE EXIT THEN THEN
      THEN
    THEN
    OP-K @ K-BR = OP-K @ K-QBR = OR IF
      OP-V @ IN-DICT? 0= IF DROP 3 WHY ! FALSE EXIT THEN
      OP-V @ DUP TGT, T-FAR @ MAX T-FAR !
      REACH @ IF OP-V @ T-DEP @ EXPECT 0= IF DROP 11 WHY ! FALSE EXIT THEN THEN
      OP-K @ K-BR = IF TRUE DEAD ! THEN
      \ LIT 0 ?BRANCH always jumps - unless a jump already arrives at the
      \ ?BRANCH, as in FIND's `ELSE 0 THEN IF`, where the other path
      \ brings a real flag. Jumps arriving later are checked at the end.
      OP-K @ K-QBR = PREV-ZERO @ AND IS-TGT @ 0= AND IF
        #CZ @ 8 < 0= IF DROP 12 WHY ! FALSE EXIT THEN
        VA @ #CZ @ CELLS CZ + !  1 #CZ +!  TRUE DEAD !
      THEN
    THEN
    OP-K @ K-CALL = IF
      OP-V @ T-SRC @ <> IF
        OP-V @ IN-DICT? 0= IF DROP 7 WHY ! FALSE EXIT THEN
        OP-V @ LOOP-KIND ?DUP IF
          REACH @ IF V-LOOP ELSE DROP                 \ dead: no depth rules, but
            OP-V @ LOOP-KIND INLINE-CELL? IF LOOP-TARGET CELL+ THEN TRUE THEN  \ targets kept
          0= IF DROP 10 WHY ! FALSE EXIT THEN
        ELSE OP-V @ STRING-WORD? IF
          OP-V @ AQ-XT @ = IF DUP PAST-STRING DUP TGT, DUP T-FAR @ MAX T-FAR !
            REACH @ IF T-DEP @ EXPECT 0= IF DROP 11 WHY ! FALSE EXIT THEN ELSE DROP THEN THEN
          PAST-STRING
        ELSE
          SAVE-OP  OP-V @ DUP WHY-XT !  CLASSIFY  REST-OP
          3 = IF DROP 8 WHY ! FALSE EXIT THEN
          WHY-XT @ CALLEE,
        THEN THEN
      THEN
    THEN
    EXIT-OP? IF
      REACH @ IF T-DEP @ IF DROP 2 WHY ! FALSE EXIT THEN THEN
      VA @ T-FAR @ < 0= IF
        T-END !
        \ A constant ?BRANCH was treated as unconditional: only sound if
        \ no jump lands on it.
        #CZ @ 0 ?DO I CELLS CZ + @ TARGET? IF 12 WHY ! FALSE UNLOOP EXIT THEN LOOP
        TRUE EXIT
      THEN
      TRUE DEAD !                       \ a mid-word exit: nothing falls through
    THEN
    OP-K @ K-LIT = OP-V @ 0= AND PREV-ZERO !
  0 UNTIL ;
\ Every branch must land on a decoded operation start.
: TARGETS-OK? ( --- f )
  #TGT @ 0 ?DO
    I CELLS TGTS @ + @  DUP INSIDE? 0= IF DROP FALSE UNLOOP EXIT THEN
    IDX CELLS C-DEP @ + @ 0< IF FALSE UNLOOP EXIT THEN
  LOOP TRUE ;

\ ---- emitting ----
: E-LIT ( n --- )  ARG-IMM ! S-LIT EMIT-ST ;
: E-PRIM ( p --- )   \ a primitive with no operand
  DUP 0= IF DROP EXIT THEN
  DUP PM@ DUP 0< 0= IF NIP EMIT-ST EXIT THEN DROP
  2 * PRIMBODY @ + ARG-IMM !  TRUE ARG-RELOC !  S-INTERP EMIT-ST ;
: E-ADDR ( a --- )  TRUE ARG-RELOC ! E-LIT ;   \ an address in the image
: E-ADDI ( n --- )  DUP INT32? IF ARG-IMM ! S-ADDI32 ELSE ARG-IMM ! S-ADDI THEN EMIT-ST ;
\ The fifteen tiny-word opcodes, as sequences of stencils.
: E-TINY ( i --- )
  DUP 0 = IF DROP 0 E-LIT S-EQ EMIT-ST EXIT THEN                        \ 0=
  DUP 1 = IF DROP S-NEGATE EMIT-ST S-PLUS EMIT-ST EXIT THEN             \ -
  DUP 2 = IF DROP S-EQ EMIT-ST -1 E-LIT S-XOR EMIT-ST EXIT THEN         \ <>
  DUP 3 = IF DROP 0 E-LIT S-LT EMIT-ST EXIT THEN                        \ 0<
  DUP 4 = IF DROP S-SWAP EMIT-ST S-LT EMIT-ST EXIT THEN                 \ >
  DUP 5 = IF DROP S-OVER EMIT-ST S-OVER EMIT-ST EXIT THEN               \ 2DUP
  DUP 6 = IF DROP S-DROP EMIT-ST S-DROP EMIT-ST EXIT THEN               \ 2DROP
  DUP 7 = OVER 8 = OR IF DROP 1 E-ADDI EXIT THEN                        \ CHAR+ 1+
  DUP 9 = IF DROP 1 CELLS E-ADDI EXIT THEN                              \ CELL+ (a cell's bytes: Iteration 31)
  DUP 10 = IF DROP CELL-SHIFT E-LIT S-LSHIFT EMIT-ST EXIT THEN          \ CELLS
  DUP 11 = IF DROP -1 E-ADDI EXIT THEN                                  \ 1-
  DUP 12 = IF DROP -1 E-LIT S-XOR EMIT-ST EXIT THEN                     \ INVERT
  DUP 13 = IF DROP S-DUP EMIT-ST 1 E-ADDI S-SWAP EMIT-ST S-CFETCH EMIT-ST EXIT THEN
  DROP 1 CELLS 1- E-ADDI 1 CELLS NEGATE E-LIT S-AND EMIT-ST ;           \ ALIGNED, to a cell
\ One decoded operation that is neither control flow nor a call.
: E-SIMPLE ( --- )
  OP-K @ K-LIT = IF OP-V @ E-LIT EXIT THEN
  OP-K @ K-TINY = IF OP-V @ E-TINY EXIT THEN
  OP-K @ K-ADDI = IF OP-V @ E-ADDI EXIT THEN
  OP-K @ K-EQI = IF OP-V @ E-LIT S-EQ EMIT-ST EXIT THEN
  OP-K @ K-VF = IF OP-V @ E-ADDR S-FETCH EMIT-ST EXIT THEN
  OP-K @ K-VS = IF OP-V @ E-ADDR S-STORE EMIT-ST EXIT THEN
  OP-K @ K-PRIM = IF OP-V @ E-PRIM EXIT THEN ;
\ The operation just decoded ends in EXIT: emit the part before it.
: E-FINAL ( --- )
  OP-K @ K-LITX = IF OP-V @ E-LIT EXIT THEN
  OP-K @ K-ADDIX = IF OP-V @ E-ADDI EXIT THEN
  OP-K @ K-EQIX = IF OP-V @ E-LIT S-EQ EMIT-ST EXIT THEN
  OP-K @ K-FOLD = IF OP-V @ E-PRIM EXIT THEN ;
\ Copy an inlinable callee's operations, without its exit.
: E-INLINE ( xt --- )
  BEGIN DECODE FINAL-OP? 0= WHILE E-SIMPLE REPEAT DROP E-FINAL ;
: E-CALL ( xt --- )
  DUP T-SRC @ = IF DROP T-NAT @ ARG-CALL ! 0 ARG-CXT ! S-CALL EMIT-ST EXIT THEN
  DUP >R CLASSIFY
  DUP 0 = IF DROP C-VAL @ ARG-CALL ! R> ARG-CXT ! S-CALL EMIT-ST EXIT THEN
  R> DROP
  DUP 1 = IF DROP C-VAL @ E-ADDR EXIT THEN
  DUP 5 = IF DROP C-VAL @ E-INLINE EXIT THEN
  DROP C-VAL @ ARG-IMM ! TRUE ARG-RELOC ! S-INTERP EMIT-ST ;
: E-LOOP ( a' k --- a'' )   \ a' is just past the call
  DUP 1 = IF DROP S-DO EMIT-ST EXIT THEN
  DUP 5 = IF DROP S-I EMIT-ST EXIT THEN
  DUP 6 = IF DROP S-J EMIT-ST EXIT THEN
  DUP 7 = IF DROP S-UNLOOP EMIT-ST EXIT THEN
  DUP 9 = IF DROP S-PICK EMIT-ST EXIT THEN
  OVER DUP @ + ARG-JUMP !
  DUP 2 = IF DROP S-QDO ELSE DUP 3 = IF DROP S-LOOP ELSE
    4 = IF S-PLOOP ELSE S-LEAVE THEN THEN THEN
  EMIT-ST CELL+ ;
\ (S") (.") (ABORT"): the string's address and length are constants.
: ABORT-MSG ( c-addr --- )  COUNT TYPE SPACE HERE COUNT TYPE CR WARM ;
' ABORT-MSG START @ - CONSTANT AM-OFF
: E-STRING ( a' xt --- a'' )   \ a' is the counted string
  DUP AQ-XT @ = IF DROP
    DUP PAST-STRING ARG-JUMP !  S-0BRANCH EMIT-ST
    DUP E-ADDR  AM-XT @ E-CALL  PAST-STRING EXIT
  THEN
  OVER DUP 1+ E-ADDR C@ E-LIT
  DQ-XT @ = IF TYPE-XT @ E-CALL THEN
  PAST-STRING ;
\ DUP n < ?BRANCH - FIB's `DUP 2 < IF` - as ONE compare and branch, as
\ s7 does: S-DUPLTBR jumps if TOS > n-1, and leaves the stack as it was
\ on both paths, as the four operations do. Four operations in, one
\ stencil out: only when no branch lands on the last three, which get no
\ native address of their own. (LIT n + needs no fusing here: CV8 byte
\ code already has it, as ADDI.)
VARIABLE FZ-A  VARIABLE FZ-N  VARIABLE #FUSED  0 #FUSED !
: FZ-NEXT ( --- f )   \ decode the operation at FZ-A, unless a branch lands on it
  FZ-A @ TARGET? IF FALSE EXIT THEN  FZ-A @ DECODE FZ-A !  TRUE ;
: DUPLTBR? ( a' --- a' 0 | a'' -1 )   \ a' is just past a DUP; changes OP-K, OP-V
  DUP FZ-A !
  FZ-NEXT 0= IF FALSE EXIT THEN
  OP-K @ K-LIT <> IF FALSE EXIT THEN
  OP-V @ 1- DUP INT32? 0= IF DROP FALSE EXIT THEN  FZ-N !
  FZ-NEXT 0= IF FALSE EXIT THEN
  OP-K @ K-PRIM <> IF FALSE EXIT THEN  OP-V @ PM@ S-LT <> IF FALSE EXIT THEN
  FZ-NEXT 0= IF FALSE EXIT THEN
  OP-K @ K-QBR <> IF FALSE EXIT THEN
  DROP FZ-A @ TRUE ;
\ Any flag and the ?BRANCH that takes it, as ONE compare and conditional
\ jump - the flag never made, never tested. On the CV8 interpreter a
\ ?BRANCH is a tenth of everything dispatched, and what feeds it is 0=
\ (3% of everything), DUP, U<, =, -, n= and OR. The stencil for the
\ operation just decoded, or 0:
: BR-FUSE ( --- stencil | 0 )
  OP-K @ K-TINY = IF
    OP-V @ 0 = IF S-NZBR EXIT THEN  OP-V @ 1 = IF S-EQBR EXIT THEN  0 EXIT THEN
  OP-K @ K-EQI = IF OP-V @ INT32? IF S-NEIBR ELSE 0 THEN EXIT THEN
  OP-K @ K-PRIM <> IF 0 EXIT THEN
  OP-V @ PM@
  DUP S-DUP = IF DROP S-DUPBR EXIT THEN   DUP S-EQ = IF DROP S-NEBR EXIT THEN
  DUP S-ULT = IF DROP S-UGEBR EXIT THEN   DUP S-LT = IF DROP S-GEBR EXIT THEN
  S-OR = IF S-ORBR EXIT THEN  0 ;
\ If the next operation is a ?BRANCH no branch lands on, emit the pair as
\ one and step past it. (n= keeps its n in SV across the look ahead.)
: BR-FUSE? ( a' --- a' | a'' )
  DUP C@ 4 <> IF EXIT THEN          \ the next byte is not ?BRANCH: most operations stop here
  BR-FUSE ?DUP 0= IF EXIT THEN                         ( a' s )
  OVER TARGET? IF DROP EXIT THEN
  SAVE-OP  OVER DECODE                                 ( a' s a'' )
  OP-K @ K-QBR <> IF 2DROP REST-OP EXIT THEN
  OP-V @ ARG-JUMP !  SV @ ARG-IMM !
  SWAP EMIT-ST  NIP  1 #FUSED +!  K-BAD OP-K ! ;       ( a'' )
: EMIT-WORD ( --- )
  0 #FIX !  T-SRC @
  BEGIN
    CODE-HERE @ OVER IDX CELLS C-NAT @ + !
    RECORDING @ IF DUP 1 RECORD-HOOK @ EXECUTE THEN
    DUP VA !  DECODE                                     ( a' )
    OP-K @ K-PRIM = IF OP-V @ PM@ S-DUP = IF
      SAVE-OP  DUPLTBR? IF
        FZ-N @ ARG-IMM !  OP-V @ ARG-JUMP !  S-DUPLTBR EMIT-ST  1 #FUSED +!
        K-BAD OP-K !                     \ emitted: nothing more for this one
      ELSE REST-OP THEN
    THEN THEN
    BR-FUSE?
    OP-K @ K-BR = IF OP-V @ ARG-JUMP ! S-BRANCH EMIT-ST THEN
    OP-K @ K-QBR = IF OP-V @ ARG-JUMP ! S-0BRANCH EMIT-ST THEN
    OP-K @ K-CALL = IF
      SAVE-OP
      OP-V @ LOOP-KIND ?DUP IF E-LOOP
      ELSE OP-V @ STRING-WORD? IF OP-V @ E-STRING ELSE OP-V @ E-CALL THEN THEN
      REST-OP
    THEN
    EXIT-OP? IF
      E-FINAL S-EXIT EMIT-ST
      VA @ T-FAR @ < 0= IF DROP EXIT THEN
    ELSE
      OP-K @ K-BR <> OP-K @ K-QBR <> AND OP-K @ K-CALL <> AND IF E-SIMPLE THEN
    THEN
  0 UNTIL ;
\ ARM keeps no coherence between written code and instruction fetch:
\ each word's code, once whole, is made visible (x86 needs nothing).
: T-SYNC ( --- )  X86? 0= IF T-NAT @ CODE-HERE @ OVER - SPN-SYNC THEN ;
: RESOLVE ( --- )
  #FIX @ 0 ?DO
    I 2 * CELLS FIXUPS @ +  DUP CELL+ @ IDX CELLS C-NAT @ + @  SWAP @ REL!
  LOOP T-SYNC ;

\ ---- translating one word ----
VARIABLE #NATIVE  VARIABLE #KEPT
\ The offset goes in first and byte 0 last, with nothing but C! and
\ literals between: the word being patched may be one this code uses.
\ It WAS - written with OP-ENTER here, patching OP-ENTER wrote bytes
\ 1 and 2 and then ran the half-patched OP-ENTER for byte 0.
: PATCH-ENTRY ( xt --- )
  ENTRY-OF  T-NAT @ CODE-BASE @ - 4 RSHIFT
  DUP 255 AND 2 PICK 1+ C!  8 RSHIFT 255 AND OVER 2 + C!
  [ OP-ENTER ] LITERAL SWAP C! ;
VARIABLE SPN-READY  0 SPN-READY !
: SHAPE-OK? ( xt --- f )
  DUP IN-DICT? 0= IF DROP FALSE EXIT THEN
  DUP ENTRY-OF C@ OP-ENTER = IF DROP FALSE EXIT THEN   \ already native
  C@ DUP 69 <> SWAP 70 <> AND ;                      \ not a data word
\ Is some active call returning into the three bytes a patch would
\ overwrite? Then the patch would corrupt it; leave the word alone.
: RS-HAZARD? ( xt --- f )
  RP@ BEGIN DUP R0 @ < WHILE
    DUP @ 2 PICK - DUP 0 > SWAP 3 < AND IF 2DROP TRUE EXIT THEN
    CELL+
  REPEAT 2DROP FALSE ;
\ ---- where a word's body must end ----
\ At the next name's link - found in a map of every name, built once
\ per boot - or at HERE for a word just defined. Every decode is held
\ inside this bound, so none can run on into a following header.
\ ONE byte per dictionary byte serves three purposes, a bit each:
\   1  a name starts here (the map of names)
\   2 4 8 16  the memo: inlinable known/true, reads its caller's return
\             address known/true - keyed by entry, never a name's byte
\   32 visited by the tree walk - also keyed by entry
\ They were three tables of this size, and on demand keeps them for the
\ whole run: 102 KB of heap, more than on demand saves in native code.
VARIABLE MARKS  0 MARKS !  VARIABLE MSIZE
VARIABLE VIS  0 VIS !  VARIABLE VIS-N  0 VIS-N !
VARIABLE MARK-END   \ HERE when the map was made: recording appends recipes
: LINK-BYTES ( nfa --- n )  1- C@ DUP 128 U< IF DROP 1 ELSE 192 U< IF 2 ELSE 3 THEN THEN ;
: MARK-THREAD ( nfa --- )
  BEGIN ?DUP WHILE  DUP START @ - MARKS @ + DUP C@ 1 OR SWAP C!  NEXT-NFA8  REPEAT ;
: BUILD-MARKS ( --- )
  HERE MARK-END !
  HERE START @ - 1+ DUP MSIZE !  DUP MEMO-N !  DUP VIS-N !
  TABLE DUP MARKS !  DUP MEMO !  VIS !
  FORTH-WORDLIST @ 1+ 1 DO FORTH-WORDLIST I CELLS + @ MARK-THREAD LOOP ;
: FREE-MARKS ( --- )  MARKS @ ?DUP IF FREE DROP THEN
  0 MARKS !  0 MEMO !  0 MEMO-N !  0 VIS !  0 VIS-N ! ;
: BOUND-OF ( xt --- a )
  MARKS @ 0= IF DROP HERE EXIT THEN
  \ Past the map - a word defined after it was made - the bound is HERE.
  \ Without this, ?DO from past the end counts up until it wraps.
  START @ - 1+  DUP MSIZE @ < 0= IF DROP HERE EXIT THEN
  MSIZE @ SWAP ?DO
    MARKS @ I + C@ 1 AND IF I START @ + DUP LINK-BYTES - UNLOOP EXIT THEN
  LOOP MARK-END @ ;
: TRY-TRANSLATE ( xt --- )
  DUP BOUND-OF T-LIM !
  SPN-READY @ 0= IF DROP EXIT THEN
  DUP SHAPE-OK? 0= IF DROP EXIT THEN
  DUP VALIDATE 0= IF DROP 1 #KEPT +! EXIT THEN
  TARGETS-OK? 0= IF DROP 9 WHY ! 1 #KEPT +! EXIT THEN
  T-END @ OVER ENTRY-OF - 3 < IF DROP EXIT THEN      \ too short to patch
  \ Short straight-line words - constants among them, three bytes in CV8
  \ as LIT8 n EXIT - are inlined by native callers and run directly by
  \ interpreted ones. Patching them would only add an entry and exit.
  DUP INLINABLE? IF DROP EXIT THEN
  DUP ENTRY-OF RS-HAZARD? IF DROP EXIT THEN
  RECORDING @ TGT-OVER @ AND IF DROP 1 #KEPT +! EXIT THEN
  CODE-HERE @ 15 + -16 AND CODE-HERE !
  CODE-HERE @ T-NAT !
  RECORDING @ IF DUP 2 RECORD-HOOK @ EXECUTE THEN
  EMIT-WORD RESOLVE
  RECORDING @ IF DUP 3 RECORD-HOOK @ EXECUTE THEN
  PATCH-ENTRY  1 #NATIVE +! ;

\ ---- the whole dictionary, oldest first ----
: TRANSLATE-ALL ( --- )     \ uses the map; builds one if there is none
  MARKS @ 0= IF BUILD-MARKS THEN
  MSIZE @ ALL-END @ ?DUP IF MIN THEN 0 DO
    MARKS @ I + C@ 1 AND IF  I START @ + NAME>8 TRY-TRANSLATE  THEN
  LOOP ;

\ ---- start-up ----
\ ---- the stencils, as scanned when the image was built ----
\ Scanning every stencil for its holes took 0.44 ms of each start. The
\ build now saves the result, and boot uses it only if this is the same
\ engine: the same number of entries, the same spacing between every
\ entry - so a rebuilt or re-laid-out engine is caught before any
\ stencil byte is read - and the same bytes, by hash. Otherwise it scans,
\ as before; a layout-variant engine always does.
VARIABLE STS-OFF  0 STS-OFF !  VARIABLE STS-LEN  0 STS-LEN !
: FNV-BASIS ( --- n )  X86? IF 52210 40164 33826 8997 4H ELSE -2128831035 THEN ;
: FNV-PRIME ( --- n )  X86? IF 0 256 0 435 4H ELSE 16777619 THEN ;
: STENCIL-HASH ( --- h )   \ FNV-1a over every stencil's bytes: 64-bit, or 32-bit on ARM
  FNV-BASIS
  #ENTRIES @ 3 DO
    I ST-START ST@  I ST-LEN ST@ 0 ?DO  DUP I + C@ ROT XOR FNV-PRIME * SWAP  LOOP DROP
  LOOP ;
: LOAD-STENCILS ( --- f )   \ at boot: the build's scan, if the engine is the same
  STS-LEN @ 0= IF FALSE EXIT THEN
  STS-OFF @ START @ + RD !
  UV@ #ENTRIES @ <> IF FALSE EXIT THEN
  #ENTRIES @ 1 ?DO SV@ I ENTRY 0 ENTRY - <> IF FALSE UNLOOP EXIT THEN LOOP
  #ENTRIES @ 3 ?DO
    UV@ I ENTRY + I ST-START ST!  UV@ I ST-LEN ST!  UV@ DUP I ST-NH ST!
    0 ?DO UV@ DUP J 8 * I + CELLS ST-HOLES @ + !
          7 AND 1 SWAP LSHIFT J ST-MASK ST@ OR J ST-MASK ST! LOOP
  LOOP
  SV@ STENCIL-HASH = ;
: SPN-INIT ( --- )
  SPN-TABLE #ENTRIES ! ENTRIES !
  0 ENTRY M-NEXT !  1 ENTRY M-JUMP !  2 ENTRY M-CALL !
  SPN-ENGINE DROP INTERP-FN ! RP-ADDR !
  #ENTRIES @ 54 = IF SPN-IO IO-FN ! THEN
  MAX-STENCILS CELLS DUP TABLE ST-START !  DUP TABLE ST-LEN !  TABLE ST-NH !
  MAX-STENCILS 8 * CELLS TABLE ST-HOLES !  MAX-STENCILS CELLS TABLE ST-MASK !
  \ The big tables unfilled: nothing reads C-NAT, FIXUPS, TGTS or CALLS
  \ before writing them, and the first VALIDATE fills C-DEP and EXP-DEP -
  \ their high-water marks start at the top. With recipes, no VALIDATE
  \ runs at boot at all.
  MAX-BYTES CELLS DUP BUFFER C-NAT !  DUP BUFFER C-DEP !  BUFFER EXP-DEP !
  MAX-BYTES HWM !  MAX-BYTES EHWM !
  512 CELLS BUFFER FIXUPS !  128 CELLS DUP BUFFER TGTS !  BUFFER CALLS !
  80 CELLS TABLE PMAP !  PRIMBODY-AREA PRIMBODY !
  LOAD-STENCILS 0= IF
    ST-MASK @ MAX-STENCILS 0 CFILL          \ no stale bits from a failed load
    #ENTRIES @ 3 DO I SCAN-STENCIL LOOP
  THEN
  INIT-PMAP INIT-PRIMBODY
  DO-OFF START @ + DO-XT !         QDO-OFF START @ + QDO-XT !
  LOOP-OFF START @ + LOOP-XT !     PLOOP-OFF START @ + PLOOP-XT !
  I-OFF START @ + I-XT !           J-OFF START @ + J-XT !
  UNLOOP-OFF START @ + UNLOOP-XT ! LEAVE-OFF START @ + LEAVE-XT !
  PICK-OFF START @ + PICK-XT !     SQ-OFF START @ + SQ-XT !
  DQ-OFF START @ + DQ-XT !         AQ-OFF START @ + AQ-XT !
  TYPE-OFF START @ + TYPE-XT !     AM-OFF START @ + AM-XT !
  CODE-SIZE SPN-EXEC DUP 0= ABORT" SPN: no executable memory"
  DUP CODE-BASE ! DUP CODE-HERE !  CODE-SIZE + CODE-LIMIT !
  0 #NATIVE !  0 #KEPT !  TRUE SPN-READY ! ;

: UNMARK ( a --- )   \ put a not-yet-translated word's first three bytes back
  DUP LAZY? 0= IF DROP EXIT THEN
  DUP 1+ LD16 LAZY-BASE - CELLS LZ-TAB @ + @                 ( a bytes )
  2DUP 255 AND SWAP C!                  \ byte 0 first: no longer SPN-ENTER
  2DUP 8 RSHIFT 255 AND SWAP 1+ C!
  16 RSHIFT 255 AND SWAP 2 + C! ;
\ Callees before callers, depth first, so a word finds its callees
\ native when it is translated.
: VISITED? ( xt --- f )
  START @ - DUP VIS-N @ U< IF VIS @ + C@ 32 AND 0<> ELSE DROP TRUE THEN ;
: VISIT ( xt --- )
  START @ - DUP VIS-N @ U< IF VIS @ + DUP C@ 32 OR SWAP C! ELSE DROP THEN ;
: TRANSLATE-TREE ( xt --- )
  DUP VISITED? IF DROP EXIT THEN  DUP VISIT
  DUP ENTRY-OF UNMARK                   \ on demand: its real code, to read
  DUP SHAPE-OK? 0= IF DROP EXIT THEN
  DUP BOUND-OF T-LIM !
  DUP VALIDATE 0= IF DROP EXIT THEN
  >R  #CALLS @ DUP 0 ?DO I CELLS CALLS @ + @ SWAP LOOP
  0 ?DO RECURSE LOOP
  R> TRY-TRANSLATE ;
\ ---- replaying recipes ----
\ The format is spn-cv8-build.4's: a word's xt as a delta from the last
\ one's; relocated literals and callees as deltas from the word's own
\ xt; a branch target marked by 254 alone, and a jump naming its target
\ by rank, so C-NAT is indexed here by rank, not by source offset.
VARIABLE RP-PREV  VARIABLE #MARK
: RESOLVE-RANKS ( --- )
  #FIX @ 0 ?DO
    I 2 * CELLS FIXUPS @ +  DUP CELL+ @ CELLS C-NAT @ + @  SWAP @ REL!
  LOOP T-SYNC ;
: REPLAY-WORD ( --- )
  SV@ RP-PREV @ + DUP RP-PREV !  T-SRC !
  CODE-HERE @ 15 + -16 AND CODE-HERE !  CODE-HERE @ T-NAT !  0 #FIX !  0 #MARK !
  BEGIN B@+ DUP 255 <> WHILE
    DUP 254 = IF DROP  CODE-HERE @  #MARK @ CELLS C-NAT @ + !  1 #MARK +!
    ELSE
      DUP 63 AND SWAP  OVER ST-MASK ST@                         ( s b m )
      DUP 24 AND IF SV@ 2 PICK 64 AND IF T-SRC @ + THEN ARG-IMM ! THEN
      DUP 2 AND IF UV@ ARG-JUMP ! THEN                   \ a target's rank
      4 AND IF
        128 AND IF T-NAT @ ELSE
          SV@ T-SRC @ + ENTRY-OF
          DUP C@ OP-ENTER <> ABORT" SPN: a recipe calls a word not yet native"
          1+ LD16 4 LSHIFT CODE-BASE @ +
        THEN ARG-CALL !
      ELSE DROP THEN
      EMIT-ST
    THEN
  REPEAT DROP
  RESOLVE-RANKS
  T-SRC @ PATCH-ENTRY  1 #NATIVE +! ;
: REPLAY-ALL ( --- )
  START @ RP-PREV !
  RCP-OFF @ START @ + DUP RD !  RCP-LEN @ +
  BEGIN RD @ OVER < WHILE REPLAY-WORD REPEAT DROP ;

\ ---- on demand ----
\ The translator is made native from recipes at boot; every other word
\ that would translate is marked "not translated yet" and translated -
\ with its callees, callees first - the first time it is called. Only
\ words that run get native code, and the image carries a list of
\ entries, about two bytes a word, instead of their recipes.
VARIABLE TRANSLATING  0 TRANSLATING !
: LAZY-GO ( a --- )   \ translate a's tree; inside a translation, only restore a
  TRANSLATING @ IF UNMARK EXIT THEN
  TRUE TRANSLATING !  TRANSLATE-TREE  FALSE TRANSLATING ! ;
\ Run by the engine in place of a word not translated yet, with its entry
\ on the stack and the caller's return address on the return stack:
\ translate it, then jump into it as EXECUTE does. Refused when the image
\ is built - >R before an EXIT - so it runs interpreted, as it must.
: LAZY-HIT ( a --- )  DUP LAZY-GO >R ;
' LAZY-HIT START @ - CONSTANT LH-OFF
\ A new definition's callees first, so its native code calls them
\ natively rather than through re-entry.
: LAZY-CALLEES ( xt --- )
  LAZY-ON @ 0= IF DROP EXIT THEN
  DUP SHAPE-OK? 0= IF DROP EXIT THEN
  DUP BOUND-OF T-LIM !  VALIDATE 0= IF EXIT THEN
  #CALLS @ DUP 0 ?DO I CELLS CALLS @ + @ SWAP LOOP  0 ?DO LAZY-GO LOOP ;
\ At boot, after the translator's recipes: mark every listed word. The
\ map of names and the visited set are kept for the whole run.
: LAZY-SETUP ( --- )
  BUILD-MARKS
  LZ-N @ 1 MAX CELLS TABLE LZ-TAB !
  LZ-OFF @ START @ + RD !
  LZ-N @ 0 ?DO
    UV@ START @ +                                           ( a )
    DUP RS-HAZARD? 0= IF             \ never under a running call
      DUP C@ OVER 1+ C@ 8 LSHIFT OR OVER 2 + C@ 16 LSHIFT OR
      I CELLS LZ-TAB @ + !
      I LAZY-BASE +  DUP 255 AND 2 PICK 1+ C!  8 RSHIFT 255 AND OVER 2 + C!
      [ OP-ENTER ] LITERAL SWAP C!
    ELSE DROP THEN
  LOOP
  LH-OFF START @ + SPN-HOOK!  TRUE LAZY-ON ! ;

\ ---- start-up: replay, or translate in full ----
' CMOVE         START @ - CONSTANT CM-OFF
' EMIT-ST       START @ - CONSTANT ES-OFF
' VALIDATE      START @ - CONSTANT VA-OFF
' TRANSLATE-ALL START @ - CONSTANT TA-OFF
: TRANSLATE-BOOT ( --- )   \ the translator first, then everything
  BUILD-MARKS
  CM-OFF START @ + TRANSLATE-TREE
  ES-OFF START @ + TRANSLATE-TREE
  VA-OFF START @ + TRANSLATE-TREE
  TA-OFF START @ + TRANSLATE-TREE
  TRANSLATE-ALL  FREE-MARKS ;
\ Which hole kinds every stencil has: recipes replay only on an engine
\ whose stencils match the one they were recorded on.
: STENCIL-SIG ( --- h )  #ENTRIES @  #ENTRIES @ 3 DO 31 * I ST-MASK ST@ + LOOP ;
: SPN-BOOT ( --- )
  SPN-INIT
  RCP-LEN @ IF STENCIL-SIG RCP-SIG @ = IF
    REPLAY-ALL  LZ-LEN @ IF LAZY-SETUP THEN  EXIT
  THEN THEN
  TRANSLATE-BOOT ;

\ ---- reporting ----
: SPN-WHY? ( xt --- )
  DUP ENTRY-OF LAZY? IF DROP ." on demand" EXIT THEN
  DUP ENTRY-OF C@ OP-ENTER = IF DROP ." native" EXIT THEN
  DUP SHAPE-OK? 0= IF DROP ." data word" EXIT THEN
  DUP BOUND-OF T-LIM !
  DUP VALIDATE IF T-END @ SWAP - ." validates; body bytes " . EXIT THEN
  DROP WHY @ . ;
: SPN-WHY ( xt --- )   \ with the map of names, so the bound is exact
  MARKS @ IF SPN-WHY? EXIT THEN  BUILD-MARKS SPN-WHY? FREE-MARKS ;

\ New definitions: translate each as its ; completes.
: ;  POSTPONE ;  LAST @ NAME>8 DUP LAZY-CALLEES TRY-TRANSLATE ; IMMEDIATE
