\ spn-cv8-save.4 - saving an SPN-CV8 system as a CV8 image.
\
\ Load after spn-cv8.4 and spn-cv8-build.4, in the byte-header CV8 system.
\ It writes the dictionary only up to the mark spn-cv8-build.4 took -
\ the running part - followed by the data the recorder wrote, so neither
\ the recorder nor this saver is in the image. That system is
\ built without the pool, locals or shell, and cv8-save.4 cannot be used
\ as it stands: its scrub names 27 shell variables, and its header is
\ the layout from before the word list was hashed again - one head_nfa,
\ where the engine now reads a thread count and every thread head
\ (engine/vm-lab.c, load_image). An image it wrote would be misread
\ from the second field on.
\
\ So this is save-system.4's method - copy the dictionary, put back in
\ the copy what COLD relocates, blank live-session scratch - with the
\ header the engine reads today:
\
\     magic    8 bytes  "CV80", cell width 8, 'L', version 1, flags 0x1F
\     nthreads cell     then that many START-relative thread heads
\     ntails   cell     0: DODOES carries its target inline
\     locals   5 cells  0: no locals.4 in this system
\     the dictionary, START to HERE
\
\ The magic is the byte-header stage's, read from its image; COLD's
\ relocation (kernel.4) is DP, the nonzero thread heads, and BOOT.
\ Save BEFORE SPN-BOOT has run: a translated system's entries are
\ patched to point into a code buffer that will not exist next time.

DECIMAL
VARIABLE SV-FID  VARIABLE SV-LEN  VARIABLE SV-BUF
CREATE SV-MAGIC  67 C, 86 C, 56 C, 48 C, 8 C, 76 C, 1 C, 31 C,
: SV>COPY ( live-addr --- copy-addr )  START @ - SV-BUF @ + ;
: SV-BLANK ( live-addr u --- )  SWAP SV>COPY SWAP 0 FILL ;
: SV-CELL ( live-addr --- )  1 CELLS SV-BLANK ;
: SV-UNRELOCATE ( live-addr --- )  SV>COPY DUP @ START @ - SWAP ! ;
: SV-SCRUB ( --- )   \ as save-system.4's SS-SCRUB, less pool and locals
  TIB             1 CELLS 256 + SV-BLANK
  NAMEBUF         1 CELLS 28 +  SV-BLANK
  POCKET          1 CELLS 252 + SV-BLANK
  INCLUDE-BUFFER  1 CELLS 508 + SV-BLANK
  CONTEXT         1 CELLS 28 +  SV-BLANK
  INCLUDE-POINTER SV-CELL
  SRC SV-CELL  #SRC SV-CELL  >IN SV-CELL  SID SV-CELL
  #TIB SV-CELL  SPAN SV-CELL
  LAST SV-CELL  CURRENT SV-CELL  CSP SV-CELL  'LEAVE SV-CELL
  S0 SV-CELL  R0 SV-CELL  START SV-CELL
  \ SPN: translator scratch that can hold an absolute address after a
  \ build-time recording - always set again before use, but a saved
  \ image should not carry pointers from the session that built it.
  T-LIM SV-CELL  MARK-END SV-CELL  T-SRC SV-CELL  T-NAT SV-CELL
  C-VAL SV-CELL  WHY-XT SV-CELL  VA SV-CELL  RD SV-CELL  E-DST SV-CELL
  ARG-IMM SV-CELL  ARG-CALL SV-CELL  ARG-JUMP SV-CELL
  \ The hook holds the build-time address of the recorder, which is not
  \ saved. (This saver's own variables are above the mark, not in the
  \ copy at all - scrubbing them would write past its end.)
  RECORD-HOOK SV-CELL  ALL-END SV-CELL ;
: SV-WRITE ( a u --- )  SV-FID @ WRITE-FILE ABORT" SPN-SAVE: write failed" ;
VARIABLE SV-X
: SV-CELL, ( n --- )  SV-X !  SV-X 1 CELLS SV-WRITE ;
: SV-SHIFT ( variable shift --- )   \ a recorded offset, as it lands in the image
  OVER @ IF SWAP SV>COPY DUP @ ROT - SWAP ! ELSE 2DROP THEN ;
VARIABLE SV-KEEP  VARIABLE SV-BLOB
: SPN-SAVE ( c-addr u --- )
  SPN-READY @ ABORT" SPN-SAVE: save before SPN-BOOT, not after"
  \ The copy: the running part, START to the mark, then the recorded data.
  KEEP-END @ START @ - SV-KEEP !
  BLOB-START @ ?DUP 0= IF HERE THEN                      ( blob )
  HERE OVER - SV-BLOB !
  SV-KEEP @ SV-BLOB @ + SV-LEN !
  SV-LEN @ ALLOCATE ABORT" SPN-SAVE: out of memory" SV-BUF !
  START @ SV-BUF @ SV-KEEP @ MOVE
  SV-BUF @ SV-KEEP @ + SV-BLOB @ MOVE
  \ In the copy: the data's offsets, moved down to the mark; DP, the new
  \ end; and the word list as it was at the mark, START-relative.
  BLOB-START @ ?DUP IF KEEP-END @ -                      ( shift )
    STS-OFF OVER SV-SHIFT  RCP-OFF OVER SV-SHIFT  LZ-OFF OVER SV-SHIFT  DROP
  THEN
  SV-LEN @ DP SV>COPY !
  FORTH-WORDLIST @ 1+ 1 DO
    KEEP-HEADS @ I CELLS + @ DUP IF START @ - THEN
    FORTH-WORDLIST I CELLS + SV>COPY !
  LOOP
  SV-SCRUB
  W/O BIN CREATE-FILE ABORT" SPN-SAVE: cannot create file" SV-FID !
  SV-MAGIC 8 SV-WRITE
  FORTH-WORDLIST @ SV-CELL,
  FORTH-WORDLIST @ 1+ 1 DO FORTH-WORDLIST I CELLS + SV>COPY @ SV-CELL, LOOP
  0 SV-CELL,                                  \ ntails
  5 0 DO 0 SV-CELL, LOOP                      \ locals header
  SV-BUF @ SV-LEN @ SV-WRITE
  SV-FID @ CLOSE-FILE DROP
  SV-BUF @ FREE DROP ;
: SET-BOOT ( xt --- )  START @ - BOOT ! ;
