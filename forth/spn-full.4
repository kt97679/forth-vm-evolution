\ spn-full.4 - SPN: Stencil-Patched Native, as a whole Forth system.
\
\ FROZEN. This is s7, SPN on the cell image, superseded by s8 - SPN on
\ the CV8 image, forth/spn-cv8.4. Kept as the data point for why cells
\ were the wrong base, and still built and tested; no longer developed,
\ so fixes are not ported here. See FINDINGS-SPN.md.
\
\ Load into the cell image on the SPN engine (build/spn-64). SPN-BOOT,
\ run at every start, turns every word it can prove safe into native
\ code; everything else stays interpreted. New definitions are
\ translated as their ; completes. Details: FINDINGS-SPN.md.
\
\ HOW NATIVE AND INTERPRETED CODE MEET
\   A translated word's body becomes [SPN-ENTER][native address], so an
\   interpreted caller runs the native code without knowing. Native code
\   calls a word with no native code through the engine's re-entry
\   helper, which runs it in the interpreter and comes back. Both sides
\   share one return stack.
\
\ WHAT IS NEVER TRANSLATED OR CALLED BLIND
\   Words that read their CALLER'S return address as data - DOVAR, the
\   loop and string runtimes, DOES> code - would see the re-entry
\   sentinel instead. A word calling one of those is left interpreted,
\   except that variables and constants are inlined as literals.
\
\ x86-64 only; see ARCH.

DECIMAL
512 CONSTANT MAX-CELLS     \ the longest word, in cells, SPN translates
: NIP ( x1 x2 --- x2 )  SWAP DROP ;
\ Fill whole cells. Boot zeroes about 22 KB of tables before FILL itself
\ is translated, and FILL goes a byte at a time - a profile of boot put
\ it at 14% of everything executed. Callers round up to whole cells.
: CFILL ( a-addr u-cells x --- )
  >R CELLS OVER + SWAP
  BEGIN 2DUP > WHILE R@ OVER ! CELL+ REPEAT 2DROP R> DROP ;
\ Not in this kernel either.
0 CONSTANT FALSE

\ ---- engine primitives past the kernel's own, as raw tokens ----
: SPN-TABLE  [ 68 CELLS 1+ , ] ;   ( --- a-addr n )
: SPN-EXEC   [ 69 CELLS 1+ , ] ;   ( u --- a-addr )
: SPN-CALL   [ 70 CELLS 1+ , ] ;   ( i*x a-addr --- j*x )
: SPN-ENGINE [ 73 CELLS 1+ , ] ;   ( --- rp-addr helper-addr )
71 CELLS 1+ CONSTANT TOK-ENTER

\ ---- addresses that change every run, so are read at boot ----
VARIABLE ENTRIES  VARIABLE #ENTRIES
VARIABLE M-NEXT   VARIABLE M-JUMP   VARIABLE M-CALL
VARIABLE RP-ADDR  VARIABLE INTERP-FN
: ENTRY ( i --- a-addr )  CELLS ENTRIES @ + @ ;

\ Stencils, by position in engine/spn-stencils.c's table.
 3 CONSTANT S-LIT      4 CONSTANT S-DUP      5 CONSTANT S-DROP
 6 CONSTANT S-SWAP     7 CONSTANT S-OVER     8 CONSTANT S-ROT
 9 CONSTANT S-PLUS    10 CONSTANT S-ADDI    11 CONSTANT S-EQ
12 CONSTANT S-GT      13 CONSTANT S-LT      14 CONSTANT S-XOR
15 CONSTANT S-AND     16 CONSTANT S-NEGATE  17 CONSTANT S-0BRANCH
18 CONSTANT S-BRANCH  19 CONSTANT S-CALL    20 CONSTANT S-EXIT
21 CONSTANT S-ADDI32  22 CONSTANT S-DUPLTBR 23 CONSTANT S-TOR
24 CONSTANT S-FROMR   25 CONSTANT S-RFETCH  26 CONSTANT S-FETCH
27 CONSTANT S-STORE   28 CONSTANT S-CFETCH  29 CONSTANT S-CSTORE
30 CONSTANT S-OR      31 CONSTANT S-ULT     32 CONSTANT S-LSHIFT
33 CONSTANT S-RSHIFT  34 CONSTANT S-INTERP
35 CONSTANT S-DO      36 CONSTANT S-QDO     37 CONSTANT S-LOOP
38 CONSTANT S-PLOOP   39 CONSTANT S-I       40 CONSTANT S-J
41 CONSTANT S-UNLOOP  42 CONSTANT S-LEAVE  43 CONSTANT S-PICK
64 CONSTANT MAX-STENCILS

\ ---- ARCH: what this file knows about x86-64 ----
6818992301515038369 CONSTANT IMM-MARK   \ 5EA1ED5EA1ED5EA1: a literal
9124835310728732279 CONSTANT RP-MARK    \ 7EA1ED5EA1ED5E77: &g_rp
7971913806121885286 CONSTANT FN-MARK    \ 6EA1ED5EA1ED5E66: re-entry helper
1008361079 CONSTANT IMM32-MARK          \ 3C1A5E77: a folded literal
233 CONSTANT OP-JMP                     \ E9  jmp rel32
195 CONSTANT OP-RET                     \ C3  ret
: ENDBR? ( a --- f )                    \ F3 0F 1E FA  endbr64
  DUP C@ 243 = OVER 1+ C@ 15 = AND
  OVER 2 + C@ 30 = AND SWAP 3 + C@ 250 = AND ;
: L@ ( a --- u )
  DUP C@  OVER 1+ C@ 8 LSHIFT OR
  OVER 2 + C@ 16 LSHIFT OR  SWAP 3 + C@ 24 LSHIFT OR ;
: SL@ ( a --- n )  L@ DUP 2147483648 AND IF 4294967296 - THEN ;
: L! ( u a --- )
  OVER 255 AND OVER C!  OVER 8 RSHIFT 255 AND OVER 1+ C!
  OVER 16 RSHIFT 255 AND OVER 2 + C!  SWAP 24 RSHIFT 255 AND SWAP 3 + C! ;
: REL-TO? ( a target --- f )  >R DUP SL@ + 4 + R> = ;
\ Can a 32-bit relative field start at a? Only after call (E8), jmp (E9)
\ or a conditional jump (0F 8x) - every hole a stencil has is one of
\ those. Testing every byte position instead was most of SPN-INIT.
: REL-OP? ( a --- f )
  DUP 1- C@ DUP 232 = SWAP 233 = OR IF DROP TRUE EXIT THEN
  DUP 2 - C@ 15 =  SWAP 1- C@ 240 AND 128 = AND ;
: REL! ( target a --- )  DUP >R 4 + - R> L! ;
: INT32? ( n --- f )  DUP -2147483648 < 0=  SWAP 2147483647 > 0= AND ;

\ ---- reading the stencils, once per run ----
: ST-SRC ( i --- a )  ENTRY DUP ENDBR? IF 4 + THEN ;
VARIABLE LOWER
: BOUND ( i --- a )   \ the nearest entry above this one
  \ The default is only for a stencil with no entry above it. It was 64,
  \ and it capped EVERY stencil at 64 bytes: ?DO is 76, the first to
  \ exceed it, and lost its skip path - whose je then jumped past the
  \ end of the copied code into whatever came next.
  ENTRY DUP LOWER !  4096 +
  #ENTRIES @ 0 DO
    I ENTRY  LOWER @ OVER <  OVER 3 PICK <  AND IF NIP ELSE DROP THEN
  LOOP ;
: BODY-END ( i --- a )
  DUP S-EXIT = IF  ST-SRC BEGIN DUP C@ OP-RET <> WHILE 1+ REPEAT 1+ EXIT  THEN
  DUP ST-SRC SWAP BOUND OVER  ROT ROT SWAP DO
    I C@ OP-JMP = IF
      I 1+ M-NEXT @ REL-TO?  I 1+ M-JUMP @ REL-TO? OR IF DROP I 5 + THEN
    THEN
  LOOP ;
: TAIL-NEXT? ( i --- f )
  DUP BODY-END 5 -  DUP C@ OP-JMP =  SWAP 1+ M-NEXT @ REL-TO? AND
  SWAP S-EXIT <> AND ;

\ Per stencil: where its code starts, how many bytes to copy, and its
\ holes as offset*8+kind. Kinds: 0 next  1 jump  2 call  3 literal
\ 4 folded literal  5 return-stack pointer  6 re-entry helper.
CREATE ST-START MAX-STENCILS CELLS ALLOT
CREATE ST-LEN   MAX-STENCILS CELLS ALLOT
CREATE ST-NH    MAX-STENCILS CELLS ALLOT
CREATE ST-HOLES MAX-STENCILS 8 * CELLS ALLOT
CREATE ST-MASK  MAX-STENCILS CELLS ALLOT   \ which kinds of hole, one bit each
VARIABLE SI  VARIABLE SSRC  VARIABLE SLEN
: HOLE, ( offset kind --- )
  SWAP 8 * +  SI @ 8 * ST-NH SI @ CELLS + @ + CELLS ST-HOLES + !
  1 ST-NH SI @ CELLS + +! ;
: SCAN-STENCIL ( i --- )
  DUP SI !  DUP ST-SRC SSRC !
  DUP BODY-END OVER ST-SRC -  OVER TAIL-NEXT? IF 5 - THEN  SLEN !
  SSRC @ OVER CELLS ST-START + !   SLEN @ SWAP CELLS ST-LEN + !
  0 SI @ CELLS ST-NH + !
  SLEN @ 0 ?DO
    SSRC @ I +
    I 4 + SLEN @ > 0= IF
      DUP REL-OP? IF
        DUP M-NEXT @ REL-TO? IF I 0 HOLE, THEN
        DUP M-JUMP @ REL-TO? IF I 1 HOLE, THEN
        DUP M-CALL @ REL-TO? IF I 2 HOLE, THEN
      THEN
      DUP L@ IMM32-MARK = IF I 4 HOLE, THEN
    THEN
    I 8 + SLEN @ > 0= IF
      DUP @ IMM-MARK = IF I 3 HOLE, THEN
      DUP @ RP-MARK  = IF I 5 HOLE, THEN
      DUP @ FN-MARK  = IF I 6 HOLE, THEN
    THEN
    DROP
  LOOP ;

\ ---- the code buffer ----
1048576 CONSTANT CODE-SIZE
VARIABLE CODE-HERE  VARIABLE CODE-LIMIT

\ ---- emitting one stencil ----
VARIABLE ARG-IMM  VARIABLE ARG-CALL  VARIABLE ARG-JUMP  VARIABLE E-DST
VARIABLE T-SRC  VARIABLE T-NAT   \ the word being translated, and its native start

\ ---- recipes: translation decided when the image is built ----
\ Everything VALIDATE and the emitter decide depends only on the
\ dictionary: which words translate, which stencil each cell becomes,
\ what each hole is filled with. The build runs the boot translation
\ once with RECORDING on, writing those decisions into the image as a
\ RECIPE per word; boot replays them - copying stencils and patching
\ holes, nothing else. Stencil bytes and hole offsets are still read
\ from the running engine, since they belong to the machine.
\
\ Format, per word: xt as a cell offset from START, then ops, then 255.
\ Ops are described at RECORD-OP. 254 then a varint cell index marks a
\ branch target, so the jumps into it can be resolved.
VARIABLE RECORDING  0 RECORDING !
VARIABLE ARG-RELOC  0 ARG-RELOC !     \ ARG-IMM is an address in the image
VARIABLE ARG-CXT    0 ARG-CXT !       \ an S-CALL's callee xt; 0 for itself
VARIABLE RCP-OFF  0 RCP-OFF !   VARIABLE RCP-LEN  0 RCP-LEN !
VARIABLE RCP-SIG  0 RCP-SIG !         \ the stencil holes they were made for
: UV, ( u --- )  BEGIN DUP 127 U> WHILE DUP 127 AND 128 OR C, 7 RSHIFT REPEAT C, ;
: SV, ( n --- )  DUP 0< IF INVERT 1 LSHIFT 1+ ELSE 1 LSHIFT THEN UV, ;
\ Which kinds of hole stencil i has, one bit per kind.
: HOLE-MASK ( i --- m )
  0 SWAP  DUP CELLS ST-NH + @ 0 ?DO
    DUP 8 * I + CELLS ST-HOLES + @ 7 AND 1 SWAP LSHIFT ROT OR SWAP
  LOOP DROP ;
: STENCIL-SIG ( --- h )  #ENTRIES @  #ENTRIES @ 3 DO 31 * I CELLS ST-MASK + @ + LOOP ;
\ An op is ONE byte - the stencil index, plus 64 if its literal is an
\ address in the image, plus 128 if it calls its own word - then the
\ fields its holes need: literal, jump target, callee, in that order.
\ Which fields follow is read from the stencil's hole kinds, which the
\ recipe's signature guarantees match the engine replaying it. (A flags
\ byte per op, saying the same thing explicitly, cost 3.5 KB.)
: RECORD-OP ( i --- )
  DUP CELLS ST-MASK + @
  OVER  OVER 24 AND IF ARG-RELOC @ IF 64 OR THEN THEN
        OVER 4 AND IF ARG-CXT @ 0= IF 128 OR THEN THEN  C,
  DUP 24 AND IF ARG-IMM @  ARG-RELOC @ IF START @ - THEN  SV, THEN
  DUP 2 AND IF ARG-JUMP @ T-SRC @ - 3 RSHIFT UV, THEN
  4 AND IF ARG-CXT @ ?DUP IF START @ - 3 RSHIFT UV, THEN THEN
  DROP 0 ARG-RELOC ! ;
CREATE FIXUPS 256 2 * CELLS ALLOT  VARIABLE #FIX   \ native field, source target
: FIX, ( native src --- )
  #FIX @ 256 < 0= ABORT" SPN: too many branches"
  #FIX @ 2 * CELLS FIXUPS +  DUP >R CELL+ !  R> !  1 #FIX +! ;
: PATCH-HOLE ( hole --- )
  DUP 7 AND SWAP 3 RSHIFT E-DST @ +     ( kind at )
  OVER 0 = IF NIP  E-DST @ SI @ CELLS ST-LEN + @ +  SWAP REL! EXIT THEN
  OVER 1 = IF NIP  ARG-JUMP @ FIX, EXIT THEN
  OVER 2 = IF NIP  ARG-CALL @ SWAP REL! EXIT THEN
  OVER 3 = IF NIP  ARG-IMM @ SWAP ! EXIT THEN
  OVER 4 = IF NIP  ARG-IMM @ 4294967295 AND SWAP L! EXIT THEN
  OVER 5 = IF NIP  RP-ADDR @ SWAP ! EXIT THEN
  NIP INTERP-FN @ SWAP ! ;
: EMIT-ST ( i --- )
  RECORDING @ IF DUP RECORD-OP THEN
  DUP SI !
  CODE-HERE @ OVER CELLS ST-LEN + @ + CODE-LIMIT @ > ABORT" SPN: code buffer full"
  CODE-HERE @ E-DST !
  DUP CELLS ST-START + @  E-DST @  ROT CELLS ST-LEN + @  CMOVE
  SI @ CELLS ST-NH + @ 0 ?DO
    SI @ 8 * I + CELLS ST-HOLES + @ PATCH-HOLE
  LOOP
  SI @ CELLS ST-LEN + @ CODE-HERE +! ;

\ ---- which stencil implements which primitive ----
\ By the kernel's PRIMITIVE order. -1: none, call it by re-entry.
\ -2: never translate a word that uses it.
CREATE PMAP 80 CELLS ALLOT
: PM! ( stencil prim --- )  CELLS PMAP + ! ;
: PM@ ( prim --- stencil )  DUP 80 U< IF CELLS PMAP + @ ELSE DROP -2 THEN ;
: INIT-PMAP
  80 0 DO -1 I PM! LOOP
  S-DROP 5 PM!   S-DUP 6 PM!    S-SWAP 7 PM!   S-ROT 8 PM!    S-OVER 9 PM!
  S-CFETCH 10 PM! S-FETCH 11 PM! S-CSTORE 12 PM! S-STORE 13 PM!
  S-AND 14 PM!   S-OR 15 PM!    S-XOR 16 PM!   S-FROMR 17 PM! S-TOR 18 PM!
  S-RFETCH 19 PM! S-EQ 20 PM!   S-ULT 21 PM!   S-LT 22 PM!    S-PLUS 23 PM!
  S-NEGATE 24 PM! S-LSHIFT 25 PM! S-RSHIFT 26 PM!
  \ SP@ SP! RP@ RP! see the stack as the interpreter lays it out, which
  \ native code does not; and SPN's own primitives are not for this.
  -2 33 PM! -2 34 PM! -2 35 PM! -2 36 PM!
  80 68 DO -2 I PM! LOOP ;
: TOK ( cell --- prim )  1- 3 RSHIFT ;
: TK ( prim --- cell )  CELLS 1+ ;

\ A two-cell body [prim][EXIT] for every primitive, so a primitive with
\ no stencil can still be called by re-entry.
CREATE PRIMBODY 80 2 * CELLS ALLOT
: INIT-PRIMBODY
  80 0 DO  I TK  PRIMBODY I 2 * CELLS + !  1 TK  PRIMBODY I 2 * CELLS + CELL+ !  LOOP ;

\ ---- never follow an address that is not a cell of this dictionary ----
\ A body can hold data where code is expected - a primitive's entry is
\ [BRANCH][EXIT], and a walker that trusts it reads EXIT as an offset
\ and wanders off into the next header. Every computed address is
\ checked before anything reads through it.
: IN-DICT? ( a --- f )
  DUP START @ < 0=  OVER HERE < AND  SWAP START @ - 7 AND 0= AND ;

\ ---- classifying a word a native caller wants to call ----
\ Kernel words SPN must recognise. Set at boot from OFFSETS taken now:
\ ' and ['] give the address a word had when this file was loaded, and
\ a saved image lands somewhere else on every run - the same reason
\ SET-BOOT stores its boot vector as an offset from START.
VARIABLE DOVAR-XT  VARIABLE SQ-XT  VARIABLE DQ-XT  VARIABLE AQ-XT
VARIABLE TYPE-XT   VARIABLE AM-XT
' DOVAR    START @ - CONSTANT DOVAR-OFF
' (S")     START @ - CONSTANT SQ-OFF
' (.")     START @ - CONSTANT DQ-OFF
' (ABORT") START @ - CONSTANT AQ-OFF
' TYPE     START @ - CONSTANT TYPE-OFF

\ The DO-loop runtimes. Each reads or rewrites its CALLER'S return
\ address, so none can be called blind; all are compiled natively.
VARIABLE DO-XT  VARIABLE QDO-XT  VARIABLE LOOP-XT    VARIABLE PLOOP-XT
VARIABLE I-XT   VARIABLE J-XT    VARIABLE UNLOOP-XT  VARIABLE LEAVE-XT
' (DO)    START @ - CONSTANT DO-OFF      ' (?DO)  START @ - CONSTANT QDO-OFF
' (LOOP)  START @ - CONSTANT LOOP-OFF    ' (+LOOP) START @ - CONSTANT PLOOP-OFF
' I       START @ - CONSTANT I-OFF       ' J      START @ - CONSTANT J-OFF
' UNLOOP  START @ - CONSTANT UNLOOP-OFF  ' (LEAVE) START @ - CONSTANT LEAVE-OFF
VARIABLE PICK-XT  ' PICK START @ - CONSTANT PICK-OFF
\ 0 none  1 (DO)  2 (?DO)  3 (LOOP)  4 (+LOOP)  5 I  6 J  7 UNLOOP  8 (LEAVE)
\ 9 PICK - not a loop word, but compiled natively the same way.
\ Kinds 2 3 4 8 are followed by an inline offset cell.
: LOOP-KIND ( xt --- k )
  DUP DO-XT @ = IF DROP 1 EXIT THEN     DUP QDO-XT @ = IF DROP 2 EXIT THEN
  DUP LOOP-XT @ = IF DROP 3 EXIT THEN   DUP PLOOP-XT @ = IF DROP 4 EXIT THEN
  DUP I-XT @ = IF DROP 5 EXIT THEN      DUP J-XT @ = IF DROP 6 EXIT THEN
  DUP UNLOOP-XT @ = IF DROP 7 EXIT THEN DUP LEAVE-XT @ = IF DROP 8 EXIT THEN
  PICK-XT @ = IF 9 ELSE 0 THEN ;
: INLINE-CELL? ( k --- f )  DUP 2 = OVER 3 = OR OVER 4 = OR SWAP 8 = OR ;

\ (S") (.") (ABORT") are followed by a counted string, found through
\ their return address. A scanner must step over it rather than read
\ text as code - which is what refused EMIT-ST, whose ABORT" message
\ happened to contain a byte that looked like R>.
: STRING-WORD? ( xt --- f )  DUP SQ-XT @ = OVER DQ-XT @ = OR SWAP AQ-XT @ = OR ;
: PAST-STRING ( a --- a' )   CELL+ DUP C@ 1+ + ALIGNED ;

\ Does this CODE read its caller's return address - R> or R@ before any
\ >R? Steps over inline strings; a call to DOVAR ends the code, since a
\ variable's body is data from there on. Bounded: past MAX-CELLS, unsafe.
: R-SCAN-RAW ( a --- f )
  \ Bounded by MAX-CELLS, the longest word the translator accepts. It
  \ was 64, and any longer word was taken as unsafe to call - REPLAY-WORD
  \ among them, which cut the boot-time tree walk off at its root.
  MAX-CELLS 0 DO
    DUP @ DUP 1 AND 0= IF
      OVER CELL+ +
      DUP DOVAR-XT @ = IF 2DROP FALSE UNLOOP EXIT THEN
      DUP LOOP-KIND INLINE-CELL? IF DROP 2 CELLS + ELSE
        STRING-WORD? IF PAST-STRING ELSE CELL+ THEN
      THEN
    ELSE TOK
      DUP 17 = OVER 19 = OR IF 2DROP TRUE UNLOOP EXIT THEN
      DUP 18 = OVER 1 = OR IF 2DROP FALSE UNLOOP EXIT THEN
      DUP 2 = OVER 3 = OR SWAP 4 = OR IF 2 CELLS + ELSE CELL+ THEN
    THEN
  LOOP DROP TRUE ;
\ The scan, memoised: one byte per dictionary cell, 0 not yet known,
\ 1 false, 2 true. CLASSIFY rescanned a callee - up to 64 cells - at
\ every call site, twice (validation and emission): a word called from
\ fifty places was scanned a hundred times. Words defined after boot
\ lie past the table and are simply scanned.
\ A TRANSLATED word passed validation, which refuses R> or R@ at depth
\ zero, so it is never R-first. Without this check its patched body -
\ [SPN-ENTER][native address] - was scanned as Forth, into garbage.
VARIABLE RSC  VARIABLE RSC-N  0 RSC-N !
: R-SCAN ( xt --- f )
  DUP @ TOK-ENTER = IF DROP FALSE EXIT THEN
  DUP START @ - 3 RSHIFT DUP RSC-N @ U< IF
    RSC @ + DUP C@ ?DUP IF NIP NIP 2 = EXIT THEN
    SWAP R-SCAN-RAW DUP IF 2 ELSE 1 THEN ROT C! EXIT
  THEN DROP R-SCAN-RAW ;

\ A DATA word: its body is a call to DOVAR or to DOES> code, then data.
\ Calling one is safe - DOVAR or the DOES> code consumes the return
\ address INTO the word, not its caller's. The earlier test scanned
\ the called word's body as code, walked into its data, and so refused
\ FIND, WORD and NAME>BUF, whose first act is to name a variable.
: DATA-WORD? ( xt --- f )
  DUP @ DUP 1 AND IF 2DROP FALSE EXIT THEN
  OVER CELL+ + NIP  DUP IN-DICT? 0= IF DROP FALSE EXIT THEN
  DUP DOVAR-XT @ = IF DROP TRUE EXIT THEN
  R-SCAN ;
: R-FIRST? ( xt --- f )  DUP DATA-WORD? IF DROP FALSE ELSE R-SCAN THEN ;

\ Kinds: 0 native  1 literal (variable or constant)  2 re-entry  3 refuse
\ 4 a primitive's own entry [prim][EXIT], inlined as that primitive
VARIABLE C-VAL  VARIABLE C-RELOC  VARIABLE C-XT
\ A primitive's entry [prim][EXIT] can be inlined as the primitive -
\ unless the primitive works on the return stack. EXECUTE is >R ; and
\ there the EXIT is the whole point: it jumps to the address just
\ pushed. Inlined as a bare >R, the word never ran and the return stack
\ was left one cell deep - latent until INTERPRET, which calls EXECUTE,
\ became translatable.
: PLAIN-PRIM? ( p --- f )
  DUP 17 = OVER 18 = OR OVER 19 = OR IF DROP FALSE EXIT THEN
  DUP 4 > SWAP PM@ -2 <> AND ;
: CLASSIFY ( xt --- kind )
  DUP IN-DICT? 0= IF DROP 3 EXIT THEN
  DUP @ TOK-ENTER = IF CELL+ @ C-VAL ! 0 EXIT THEN
  DUP @ 1 AND IF DUP CELL+ @ 1 TK = IF
    DUP @ TOK DUP PLAIN-PRIM? IF C-VAL ! DROP 4 EXIT THEN DROP
  THEN THEN
  DUP @ DUP 1 AND 0= IF                      \ starts with a call:
    OVER CELL+ +  DOVAR-XT @ = IF CELL+ C-VAL ! 1 C-RELOC ! 1 EXIT THEN  \ a variable
  ELSE DROP THEN
  DUP DATA-WORD? IF C-VAL ! 2 EXIT THEN      \ a DOES> child: interpret it
  DUP @ 2 TK =  OVER 2 CELLS + @ 1 TK = AND IF CELL+ @ C-VAL ! 0 C-RELOC ! 1 EXIT THEN
  DUP R-SCAN IF DROP 3 EXIT THEN
  C-VAL ! 2 ;

\ ---- validating a word before emitting anything ----
CREATE C-NAT MAX-CELLS CELLS ALLOT     \ native address of each source cell
CREATE C-DEP MAX-CELLS CELLS ALLOT     \ return-stack depth at each cell
CREATE TGTS 128 CELLS ALLOT  VARIABLE #TGT
VARIABLE T-FAR  VARIABLE T-DEP  VARIABLE T-OK
\ How many cells of C-DEP the previous word dirtied. Clearing all 512
\ cells for every word was most of boot time - the byte-at-a-time FILL
\ again - when a typical word uses a few dozen. Everything past this
\ mark is still -1 from the last clear, so only this much needs undoing.
VARIABLE HWM
\ Why the last word was refused, for reporting (SPN-WHY). 1 ran off the
\ end  2 EXIT with the return stack unbalanced  3 branch leaves the
\ dictionary  4 R> of the caller's return address  5 R@ of it  6 a
\ primitive never translated  7 call leaves the dictionary  8 calls a
\ word that must not be called blind (WHY-XT)  9 a branch into the
\ middle of something  10 a loop word at the wrong return-stack depth.
VARIABLE WHY  VARIABLE WHY-XT
\ The words the last VALIDATE saw called, for TRANSLATE-TREE.
CREATE CALLS 128 CELLS ALLOT  VARIABLE #CALLS
: CALL, ( xt --- )  #CALLS @ 128 < IF #CALLS @ CELLS CALLS + ! 1 #CALLS +! ELSE DROP THEN ;
: IDX ( a --- i )  T-SRC @ - 3 RSHIFT ;
: INSIDE? ( a --- f )  IDX DUP 0< 0= SWAP MAX-CELLS < AND ;
: TGT, ( a --- )
  #TGT @ 128 < 0= IF DROP 0 T-OK ! EXIT THEN
  #TGT @ CELLS TGTS + !  1 #TGT +! ;
\ Is there a branch target strictly inside [a, a+n cells)?
: TARGET-IN? ( a n --- f )
  CELLS OVER + SWAP                      ( end a )
  FALSE #TGT @ 0 ?DO
    I CELLS TGTS + @  2 PICK OVER < SWAP 4 PICK < AND OR
  LOOP NIP NIP ;
\ Return-stack depth is checked PER PATH, as a bytecode verifier does -
\ ported from spn-cv8.4, which has the full account. Tracked linearly it
\ refused NUMBER?, >NUMBER, FIND, ACCEPT and MOVE, all balanced on every
\ path: after `IF R> DROP R> BASE ! 0 EXIT THEN` the walk carried the
\ exit path's depth into code the fall-through reaches with 2. A forward
\ branch records the depth it arrives with; code after an unconditional
\ jump or a mid-word EXIT takes it; a fall-through and a jump meeting
\ must agree (11); a backward branch must match the depth at its target.
\ Code only dead code falls into records nothing; `LIT 0 ?BRANCH` never
\ falls through unless a jump lands on the ?BRANCH (12 if one does
\ later). The expected depths live on the heap, allocated on first use,
\ so the image does not grow by a table.
VARIABLE EXP-DEP  0 EXP-DEP !  VARIABLE EHWM  0 EHWM !
VARIABLE DEAD  VARIABLE REACH  VARIABLE PREV-ZERO  VARIABLE ZERO-NOW
VARIABLE IS-TGT  VARIABLE VA  VARIABLE LT  VARIABLE BR-TOK
CREATE CZ 8 CELLS ALLOT  VARIABLE #CZ
: EXPECT ( target depth --- f )   \ a branch arrives at target with depth
  OVER INSIDE? 0= IF 2DROP FALSE EXIT THEN
  OVER VA @ > IF                                  \ forward: record, or agree
    SWAP IDX DUP 1+ EHWM @ MAX EHWM !  CELLS EXP-DEP @ +
    DUP @ DUP 0< IF DROP ! TRUE EXIT THEN  NIP =
  ELSE                                            \ backward: as seen there
    SWAP IDX CELLS C-DEP + @ =
  THEN ;
: CZ-OK? ( --- f )   \ no jump lands on a ?BRANCH taken as constant
  #CZ @ 0 ?DO
    FALSE #TGT @ 0 ?DO J CELLS CZ + @ I CELLS TGTS + @ = OR LOOP
    IF FALSE UNLOOP EXIT THEN
  LOOP TRUE ;
\ A loop word at a: check the return-stack depth it needs, record any
\ jump target, and step past its inline offset. ( a k --- a' ok? )
: LOOP-TARGET ( a --- a )   DUP CELL+ DUP @ +  DUP LT !  DUP TGT,  T-FAR @ MAX T-FAR ! ;
: V-LOOP ( a k --- a' f )
  DUP 1 = IF DROP 2 T-DEP +! CELL+ TRUE EXIT THEN
  DUP 2 = IF DROP 2 T-DEP +! LOOP-TARGET LT @ T-DEP @ 2 - EXPECT
    0= IF FALSE EXIT THEN 2 CELLS + TRUE EXIT THEN
  DUP 6 = IF DROP T-DEP @ 4 < IF FALSE EXIT THEN CELL+ TRUE EXIT THEN
  DUP 9 = IF DROP CELL+ TRUE EXIT THEN
  T-DEP @ 2 < IF DROP FALSE EXIT THEN
  DUP 5 = IF DROP CELL+ TRUE EXIT THEN
  DUP 7 = IF DROP -2 T-DEP +! CELL+ TRUE EXIT THEN
  DUP 8 = IF DROP LOOP-TARGET LT @ T-DEP @ 2 - EXPECT
    0= IF FALSE EXIT THEN TRUE DEAD ! 2 CELLS + TRUE EXIT THEN
  \ LOOP, +LOOP: back to the body, which must be at this same depth
  DROP LOOP-TARGET LT @ T-DEP @ EXPECT 0= IF FALSE EXIT THEN
  -2 T-DEP +! 2 CELLS + TRUE ;
: DEAD-LOOP ( a k --- a' f )   \ in dead code: no depth rules, targets kept
  INLINE-CELL? IF LOOP-TARGET 2 CELLS + ELSE CELL+ THEN TRUE ;
: VALIDATE ( xt --- f )
  DUP T-SRC !  0 T-FAR !  0 T-DEP !  0 #TGT !  TRUE T-OK !  0 #CALLS !
  C-DEP HWM @ -1 CFILL  0 HWM !
  EXP-DEP @ 0= IF MAX-CELLS CELLS ALLOCATE ABORT" SPN: no memory" EXP-DEP !
    MAX-CELLS EHWM ! THEN
  EXP-DEP @ EHWM @ -1 CFILL  0 EHWM !
  FALSE DEAD !  TRUE REACH !  FALSE ZERO-NOW !  0 #CZ !
  BEGIN
    DUP INSIDE? 0= IF DROP 1 WHY ! FALSE EXIT THEN
    DUP VA !  ZERO-NOW @ PREV-ZERO !  FALSE ZERO-NOW !
    \ The depth here: a jump's record after dead code, else the
    \ fall-through, which must agree with any jump arriving here.
    DEAD @ IF FALSE REACH ! THEN  FALSE DEAD !
    DUP IDX CELLS EXP-DEP @ + @  DUP 0< 0= IS-TGT !
    DUP 0< 0= IF
      REACH @ IF T-DEP @ <> IF DROP 11 WHY ! FALSE EXIT THEN
      ELSE T-DEP !  TRUE REACH ! THEN
    ELSE DROP THEN
    T-DEP @ OVER IDX CELLS C-DEP + !
    DUP IDX 1+ HWM @ MAX HWM !
    DUP @ DUP 1 AND IF TOK
      DUP 1 = IF DROP
        REACH @ IF T-DEP @ IF DROP 2 WHY ! FALSE EXIT THEN THEN
        DUP T-FAR @ < 0= IF DROP
          CZ-OK? 0= IF 12 WHY ! FALSE EXIT THEN  T-OK @ EXIT THEN
        TRUE DEAD !  CELL+                     \ a mid-word exit
      ELSE DUP 2 = IF DROP  DUP CELL+ @ 0= ZERO-NOW !  2 CELLS +
      ELSE DUP 3 = OVER 4 = OR IF BR-TOK !
        DUP CELL+ DUP @ +  DUP IN-DICT? 0= IF 2DROP 3 WHY ! FALSE EXIT THEN
        DUP TGT,  DUP T-FAR @ MAX T-FAR !
        REACH @ IF T-DEP @ EXPECT 0= IF DROP 11 WHY ! FALSE EXIT THEN ELSE DROP THEN
        BR-TOK @ 3 = IF TRUE DEAD ! THEN
        \ LIT 0 ?BRANCH always jumps - unless a jump already lands here.
        BR-TOK @ 4 = PREV-ZERO @ AND IS-TGT @ 0= AND IF
          #CZ @ 8 < 0= IF DROP 12 WHY ! FALSE EXIT THEN
          DUP #CZ @ CELLS CZ + !  1 #CZ +!  TRUE DEAD !
        THEN
        2 CELLS +
      ELSE DUP 18 = IF DROP REACH @ IF 1 T-DEP +! THEN CELL+
      ELSE DUP 17 = IF DROP REACH @ IF T-DEP @ 0= IF DROP 4 WHY ! FALSE EXIT THEN
        -1 T-DEP +! THEN CELL+
      ELSE DUP 19 = IF DROP REACH @ IF T-DEP @ 0= IF DROP 5 WHY ! FALSE EXIT THEN THEN CELL+
      ELSE PM@ -2 = IF DROP 6 WHY ! FALSE EXIT THEN CELL+
      THEN THEN THEN THEN THEN THEN
    ELSE                                  \ ( a cell ): a call
      OVER CELL+ +  DUP T-SRC @ = IF DROP CELL+ ELSE
        DUP IN-DICT? 0= IF 2DROP 7 WHY ! FALSE EXIT THEN
        DUP LOOP-KIND ?DUP IF NIP REACH @ IF V-LOOP ELSE DEAD-LOOP THEN
          0= IF DROP 10 WHY ! FALSE EXIT THEN
        ELSE DUP STRING-WORD? IF
          \ (ABORT") falls through only on error; otherwise it jumps
          \ past its string, which makes that a branch target.
          AQ-XT @ = IF DUP PAST-STRING DUP TGT, DUP T-FAR @ MAX T-FAR !
            REACH @ IF T-DEP @ EXPECT 0= IF DROP 11 WHY ! FALSE EXIT THEN
            ELSE DROP THEN THEN
          PAST-STRING
        ELSE
          DUP WHY-XT !  CLASSIFY 3 = IF DROP 8 WHY ! FALSE EXIT THEN
          WHY-XT @ CALL,  CELL+
        THEN THEN
      THEN
    THEN
  0 UNTIL ;
\ Every branch must land on a cell that was decoded, at the same depth.
: TARGETS-OK? ( --- f )
  #TGT @ 0 ?DO
    I CELLS TGTS + @  DUP INSIDE? 0= IF DROP FALSE UNLOOP EXIT THEN
    IDX CELLS C-DEP + @ 0< IF FALSE UNLOOP EXIT THEN
  LOOP TRUE ;

\ ---- emitting ----
VARIABLE E-DEP
: E-LIT ( n --- )  ARG-IMM ! S-LIT EMIT-ST ;
: E-CALL ( xt --- )
  DUP T-SRC @ = IF DROP T-NAT @ ARG-CALL !  0 ARG-CXT !  S-CALL EMIT-ST EXIT THEN
  DUP C-XT !  CLASSIFY
  DUP 0 = IF DROP C-VAL @ ARG-CALL !  C-XT @ ARG-CXT !  S-CALL EMIT-ST EXIT THEN
  DUP 1 = IF DROP C-RELOC @ ARG-RELOC !  C-VAL @ E-LIT EXIT THEN
  DUP 4 = IF DROP C-VAL @ DUP PM@ DUP 0< 0= IF NIP EMIT-ST EXIT THEN
    DROP 2 * CELLS PRIMBODY + ARG-IMM !  1 ARG-RELOC !  S-INTERP EMIT-ST EXIT THEN
  DROP C-VAL @ ARG-IMM !  1 ARG-RELOC !  S-INTERP EMIT-ST ;
: E-PRIM ( a prim --- a' )
  DUP 0 = IF DROP CELL+ EXIT THEN
  DUP 1 = IF DROP S-EXIT EMIT-ST CELL+ EXIT THEN
  DUP 2 = IF DROP
    DUP CELL+ @ ARG-IMM !
    DUP 2 CELLS + @ 23 TK =  ARG-IMM @ INT32? AND  OVER 3 TARGET-IN? 0= AND IF
      S-ADDI32 EMIT-ST 3 CELLS + EXIT
    THEN
    S-LIT EMIT-ST 2 CELLS + EXIT
  THEN
  DUP 3 = OVER 4 = OR IF
    3 = IF S-BRANCH ELSE S-0BRANCH THEN >R
    DUP CELL+ DUP @ + ARG-JUMP !  R> EMIT-ST  2 CELLS + EXIT
  THEN
  DUP 6 = IF                        \ DUP LIT n < ?BRANCH, fused
    OVER CELL+ @ 2 TK =  2 PICK 3 CELLS + @ 22 TK = AND
    2 PICK 4 CELLS + @ 4 TK = AND  2 PICK 2 CELLS + @ 1- INT32? AND
    2 PICK 6 TARGET-IN? 0= AND IF
      DROP DUP 2 CELLS + @ 1- ARG-IMM !
      DUP 5 CELLS + DUP @ + ARG-JUMP !  S-DUPLTBR EMIT-ST  6 CELLS + EXIT
    THEN
  THEN
  DUP PM@ DUP 0< 0= IF NIP EMIT-ST CELL+ EXIT THEN DROP
  2 * CELLS PRIMBODY + ARG-IMM !  1 ARG-RELOC !  S-INTERP EMIT-ST CELL+ ;
\ The string's address and length are constants by translation time.
\ (S") pushes them; (.") pushes them and calls TYPE; (ABORT") tests its
\ flag, jumps past on zero, and otherwise hands the counted string to
\ ABORT-MSG, which does what (ABORT") did on error.
: ABORT-MSG ( c-addr --- )  COUNT TYPE SPACE HERE COUNT TYPE CR WARM ;
' ABORT-MSG START @ - CONSTANT AM-OFF
: E-STRING ( a xt --- a' )
  DUP AQ-XT @ = IF DROP
    DUP PAST-STRING ARG-JUMP !  S-0BRANCH EMIT-ST
    DUP CELL+ 1 ARG-RELOC ! E-LIT  AM-XT @ E-CALL  PAST-STRING EXIT
  THEN
  OVER CELL+ DUP 1+ 1 ARG-RELOC ! E-LIT C@ E-LIT
  DQ-XT @ = IF TYPE-XT @ E-CALL THEN
  PAST-STRING ;
: E-LOOP ( a k --- a' )
  DUP 1 = IF DROP S-DO EMIT-ST CELL+ EXIT THEN
  DUP 5 = IF DROP S-I EMIT-ST CELL+ EXIT THEN
  DUP 6 = IF DROP S-J EMIT-ST CELL+ EXIT THEN
  DUP 7 = IF DROP S-UNLOOP EMIT-ST CELL+ EXIT THEN
  DUP 9 = IF DROP S-PICK EMIT-ST CELL+ EXIT THEN
  OVER CELL+ DUP @ + ARG-JUMP !
  DUP 2 = IF DROP S-QDO ELSE DUP 3 = IF DROP S-LOOP ELSE
    4 = IF S-PLOOP ELSE S-LEAVE THEN THEN THEN
  EMIT-ST 2 CELLS + ;
: TARGET? ( a --- f )  FALSE #TGT @ 0 ?DO OVER I CELLS TGTS + @ = OR LOOP NIP ;
: EMIT-WORD ( --- )
  0 #FIX !  T-SRC @
  BEGIN
    CODE-HERE @ OVER IDX CELLS C-NAT + !
    RECORDING @ IF DUP TARGET? IF 254 C, DUP IDX UV, THEN THEN
    DUP @ DUP 1 AND IF
      TOK DUP 1 = IF DROP DUP T-FAR @ < 0= IF S-EXIT EMIT-ST DROP EXIT THEN 1 THEN
      E-PRIM
    ELSE OVER CELL+ +  DUP LOOP-KIND ?DUP IF NIP E-LOOP ELSE
      DUP STRING-WORD? IF E-STRING ELSE E-CALL CELL+ THEN THEN THEN
  0 UNTIL ;
: RESOLVE ( --- )
  #FIX @ 0 ?DO
    I 2 * CELLS FIXUPS +  DUP CELL+ @ IDX CELLS C-NAT + @  SWAP @ REL!
  LOOP ;

\ ---- translating one word ----
VARIABLE #NATIVE  VARIABLE #KEPT
\ Nothing is translated until SPN-INIT has read this run's stencils -
\ the ; hook below is live from the moment this file loads.
VARIABLE SPN-READY  0 SPN-READY !
: SHAPE-OK? ( xt --- f )   \ worth translating, and safe to patch
  DUP IN-DICT? 0= IF DROP FALSE EXIT THEN
  DUP @ TOK-ENTER = IF DROP FALSE EXIT THEN          \ already native
  DUP @ 1 AND IF DUP CELL+ @ 1 TK = IF DROP FALSE EXIT THEN THEN \ [prim][EXIT]
  DUP DATA-WORD? IF DROP FALSE EXIT THEN             \ a variable or DOES> child
  DUP @ 1 TK = IF DROP FALSE EXIT THEN               \ just EXIT
  DUP @ 2 TK = OVER 2 CELLS + @ 1 TK = AND IF DROP FALSE EXIT THEN \ constant
  DROP TRUE ;
\ While recording, every patch is remembered so it can be undone: the
\ saved image must hold the dictionary exactly as it was, untranslated.
VARIABLE UNDO  VARIABLE #UNDO  0 #UNDO !
: UNDO, ( xt --- )
  DUP @ OVER CELL+ @  #UNDO @ 3 * CELLS UNDO @ +  >R
  R@ 2 CELLS + !  R@ CELL+ !  R> !  1 #UNDO +! ;
: UNPATCH-ALL ( --- )
  #UNDO @ 0 ?DO
    I 3 * CELLS UNDO @ +  DUP @ >R  DUP CELL+ @ R@ !  2 CELLS + @ R> CELL+ !
  LOOP  0 #UNDO ! ;
: TRY-TRANSLATE ( xt --- )
  SPN-READY @ 0= IF DROP EXIT THEN
  DUP SHAPE-OK? 0= IF DROP EXIT THEN
  DUP VALIDATE 0= IF DROP 1 #KEPT +! EXIT THEN
  TARGETS-OK? 0= IF DROP 9 WHY ! 1 #KEPT +! EXIT THEN
  CODE-HERE @ T-NAT !
  RECORDING @ IF DUP START @ - 3 RSHIFT UV, THEN
  \ C-NAT is never cleared: RESOLVE reads only branch targets, which
  \ TARGETS-OK? has checked were decoded - so EMIT-WORD wrote them.
  EMIT-WORD RESOLVE
  \ The native address goes in FIRST, and nothing is called between the
  \ two stores. The word being patched may be one this very code uses:
  \ written the other way round, patching CELL+ wrote SPN-ENTER into it
  \ and then called CELL+ - which jumped to the literal 8 still sitting
  \ where its native address was about to go.
  RECORDING @ IF 255 C,  DUP UNDO, THEN
  T-NAT @ OVER 8 + !  TOK-ENTER SWAP !  1 #NATIVE +! ;

\ ---- the whole dictionary, oldest first ----
\ Mark every name field in a byte map indexed by address, then scan the
\ map upward: that is definition order, with no sort. Callees are
\ defined before callers, so callers find them already native.
VARIABLE MARKS  VARIABLE MBASE  VARIABLE MSIZE
: MARK ( nfa --- )  MBASE @ - 3 RSHIFT MARKS @ + 1 SWAP C! ;
: MARK-THREAD ( nfa --- )
  BEGIN ?DUP WHILE
    DUP MARK  CELL- DUP @ DUP IF + ELSE 2DROP 0 THEN
  REPEAT ;
: TRANSLATE-ALL ( --- )
  START @ MBASE !  HERE MBASE @ - 3 RSHIFT 1+ 7 + -8 AND MSIZE !
  MSIZE @ ALLOCATE ABORT" SPN: no memory" MARKS !
  MARKS @ MSIZE @ 3 RSHIFT 0 CFILL
  FORTH-WORDLIST @ 1+ 1 DO FORTH-WORDLIST I CELLS + @ MARK-THREAD LOOP
  MSIZE @ 0 DO
    MARKS @ I + C@ IF  I CELLS MBASE @ + NAME> TRY-TRANSLATE  THEN
  LOOP
  MARKS @ FREE DROP ;

\ ---- reporting ----
: .NAME ( xt --- )  >NAME COUNT 31 AND TYPE ;
: SPN-WHY ( xt --- )   \ why is this word not native?
  DUP @ TOK-ENTER = IF DROP ." native" EXIT THEN
  DUP SHAPE-OK? 0= IF DROP ." not a translatable shape" EXIT THEN
  0 WHY !  DUP VALIDATE IF TARGETS-OK? 0= IF 9 WHY ! THEN ELSE THEN DROP
  WHY @ DUP . 8 = IF ." calls " WHY-XT @ .NAME THEN ;

\ ---- start-up ----
: SPN-INIT ( --- )
  SPN-TABLE #ENTRIES ! ENTRIES !
  0 ENTRY M-NEXT !  1 ENTRY M-JUMP !  2 ENTRY M-CALL !
  SPN-ENGINE INTERP-FN ! RP-ADDR !
  #ENTRIES @ 3 DO I SCAN-STENCIL LOOP
  #ENTRIES @ 3 DO I HOLE-MASK I CELLS ST-MASK + ! LOOP
  INIT-PMAP INIT-PRIMBODY
  DOVAR-OFF START @ + DOVAR-XT !   SQ-OFF START @ + SQ-XT !
  DQ-OFF START @ + DQ-XT !         AQ-OFF START @ + AQ-XT !
  TYPE-OFF START @ + TYPE-XT !     AM-OFF START @ + AM-XT !
  DO-OFF START @ + DO-XT !         QDO-OFF START @ + QDO-XT !
  LOOP-OFF START @ + LOOP-XT !     PLOOP-OFF START @ + PLOOP-XT !
  I-OFF START @ + I-XT !           J-OFF START @ + J-XT !
  UNLOOP-OFF START @ + UNLOOP-XT ! LEAVE-OFF START @ + LEAVE-XT !
  PICK-OFF START @ + PICK-XT !
  CODE-SIZE SPN-EXEC DUP 0= ABORT" SPN: no executable memory"
  DUP CODE-HERE !  CODE-SIZE + CODE-LIMIT !
  C-DEP MAX-CELLS -1 CFILL  0 HWM !
  HERE START @ - 3 RSHIFT 1+ 7 + -8 AND  DUP ALLOCATE ABORT" SPN: no memory" RSC !
  RSC @ OVER 3 RSHIFT 0 CFILL  RSC-N !
  0 #NATIVE !  0 #KEPT !  TRUE SPN-READY ! ;
\ ---- translating the translator first ----
\ The translator's own words sit at the end of the dictionary, so in
\ address order they were translated last: most of boot ran them
\ interpreted. TRANSLATE-TREE translates a word's callees before the
\ word, depth first, so helpers are native before anything calling
\ them is translated. Applied to TRANSLATE-ALL at boot, it makes the
\ translator native before it runs over the rest of the dictionary.
VARIABLE VIS  VARIABLE VIS-N  0 VIS-N !
: VISITED? ( xt --- f )
  START @ - 3 RSHIFT DUP VIS-N @ U< IF VIS @ + C@ ELSE DROP TRUE THEN ;
: VISIT ( xt --- )
  START @ - 3 RSHIFT DUP VIS-N @ U< IF VIS @ + 1 SWAP C! ELSE DROP THEN ;
: TRANSLATE-TREE ( xt --- )
  DUP VISITED? IF DROP EXIT THEN  DUP VISIT
  DUP SHAPE-OK? 0= IF DROP EXIT THEN
  DUP VALIDATE 0= IF DROP EXIT THEN
  >R  #CALLS @ DUP 0 ?DO I CELLS CALLS + @ SWAP LOOP
  0 ?DO RECURSE LOOP
  R> TRY-TRANSLATE ;
\ Seeds, in the order every translation needs them: CMOVE copies each
\ stencil's bytes, EMIT-ST places a stencil, VALIDATE checks a word.
\ Seeding VALIDATE first was measured WORSE - 1.81M interpreted cells
\ against 1.56M - because its subtree was then emitted with CMOVE still
\ interpreted, a byte at a time.
' CMOVE         START @ - CONSTANT CM-OFF
' EMIT-ST       START @ - CONSTANT ES-OFF
' VALIDATE      START @ - CONSTANT VA-OFF
' TRANSLATE-ALL START @ - CONSTANT TA-OFF
\ Set once the replayer exists (below). It seeds the walk first, so a
\ recording starts with the replayer's own words and a replay makes the
\ replayer native after its first few words, instead of running it
\ interpreted almost to the end - which is what happened, measured at
\ 1.6M interpreted cells.
VARIABLE FIRST-SEED  0 FIRST-SEED !
: TRANSLATE-BOOT ( --- )   \ the full translation, at boot or recording
  HERE START @ - 3 RSHIFT 1+ 7 + -8 AND  DUP ALLOCATE ABORT" SPN: no memory" VIS !
  VIS @ OVER 3 RSHIFT 0 CFILL  VIS-N !
  FIRST-SEED @ ?DUP IF START @ + TRANSLATE-TREE THEN
  CM-OFF START @ + TRANSLATE-TREE
  ES-OFF START @ + TRANSLATE-TREE
  VA-OFF START @ + TRANSLATE-TREE
  TA-OFF START @ + TRANSLATE-TREE
  TRANSLATE-ALL
  VIS @ FREE DROP  0 VIS-N ! ;

\ ---- replaying recipes ----
VARIABLE RD
: B@+ ( --- b )  RD @ C@  1 RD +! ;
: UV@ ( --- u )
  0 0 BEGIN B@+ DUP >R 127 AND OVER LSHIFT ROT OR SWAP 7 + R> 128 AND 0= UNTIL DROP ;
: SV@ ( --- n )  UV@ DUP 1 AND IF 1 RSHIFT INVERT ELSE 1 RSHIFT THEN ;
: REPLAY-WORD ( --- )
  UV@ CELLS START @ + T-SRC !  CODE-HERE @ T-NAT !  0 #FIX !
  BEGIN B@+ DUP 255 <> WHILE
    DUP 254 = IF DROP  CODE-HERE @  UV@ CELLS C-NAT + !
    ELSE
      DUP 63 AND SWAP  OVER CELLS ST-MASK + @         ( s b m )
      DUP 24 AND IF SV@ 2 PICK 64 AND IF START @ + THEN ARG-IMM ! THEN
      DUP 2 AND IF UV@ CELLS T-SRC @ + ARG-JUMP ! THEN
      4 AND IF
        128 AND IF T-NAT @ ELSE
          UV@ CELLS START @ +
          DUP @ TOK-ENTER <> ABORT" SPN: a recipe calls a word not yet native"
          CELL+ @
        THEN ARG-CALL !
      ELSE DROP THEN
      EMIT-ST
    THEN
  REPEAT DROP
  RESOLVE
  T-SRC @  T-NAT @ OVER 8 + !  TOK-ENTER SWAP !  1 #NATIVE +! ;
: REPLAY-ALL ( --- )
  RCP-OFF @ START @ + DUP RD !  RCP-LEN @ +
  BEGIN RD @ OVER < WHILE REPLAY-WORD REPEAT DROP ;

' REPLAY-ALL START @ - FIRST-SEED !

\ At image build time: translate once, recording, then undo every patch.
: SPN-RECORD ( --- )
  SPN-INIT
  3072 3 * CELLS ALLOCATE ABORT" SPN: no memory" UNDO !  0 #UNDO !
  HERE START @ - RCP-OFF !  TRUE RECORDING !
  TRANSLATE-BOOT
  FALSE RECORDING !
  HERE START @ - RCP-OFF @ - RCP-LEN !  STENCIL-SIG RCP-SIG !
  UNPATCH-ALL  UNDO @ FREE DROP  FALSE SPN-READY !
  EXP-DEP @ ?DUP IF FREE DROP THEN  0 EXP-DEP ! ;

\ Replay if there are recipes made for stencils with these same holes;
\ otherwise, or on any other engine, translate in full.
: SPN-BOOT ( --- )
  SPN-INIT
  RCP-LEN @ IF STENCIL-SIG RCP-SIG @ = IF REPLAY-ALL EXIT THEN THEN
  TRANSLATE-BOOT ;

\ New definitions: translate each as its ; completes.
: ;  POSTPONE ;  LAST @ NAME> TRY-TRANSLATE ; IMMEDIATE

\ For the proof-of-concept benchmarks, which translate a word by hand.
: TRANSLATE ( xt --- native )  DUP TRY-TRANSLATE CELL+ @ ;
