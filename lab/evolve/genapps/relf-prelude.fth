S" relf-extend.4" INCLUDED
: PARSE-NAME BL WORD COUNT ;
: U> SWAP U< ;
: VALUE ( x "name" --- ) CREATE , DOES> @ ;
: TO ( x "name" --- ) ' >BODY STATE @ IF POSTPONE LITERAL POSTPONE ! ELSE ! THEN ; IMMEDIATE
: CELL 1 CELLS ;  : CELL- 1 CELLS - ;  : -ROT ROT ROT ;  : 2NIP ROT DROP ROT DROP ;
: ON TRUE SWAP ! ;  : OFF 0 SWAP ! ;  : BOUNDS OVER + SWAP ;  : UNDER+ ROT + SWAP ;
: TOLOWER DUP [CHAR] A [CHAR] Z 1+ WITHIN IF 32 + THEN ;
: INCLUDE PARSE-NAME INCLUDED ;  : REQUIRE INCLUDE ;
: [DEFINED] BL WORD FIND NIP 0<> ; IMMEDIATE  : [UNDEFINED] POSTPONE [DEFINED] 0= ; IMMEDIATE
: MS DROP ;  : KEY? FALSE ;  : PAGE ;  : TIME&DATE 0 0 0 1 1 2000 ;  : UTIME 0 0 ;
VARIABLE MSC  : MS@ 1 MSC +! MSC @ ;  : COUNTER MS@ ;  : TIMER@ MS@ ;  : UNUSED 1000000 ;
: 2>R  R> ROT >R SWAP >R >R ;
: 2R>  R> R> R> SWAP ROT >R ;
: 2R@  R> R> R> 2DUP >R >R SWAP ROT >R ;
CREATE [IF]-BUF 32 ALLOT
: [IF]-UP ( c-addr u --- c-addr2 u )  31 MIN DUP >R [IF]-BUF SWAP CMOVE
  [IF]-BUF R@ 0 ?DO DUP I + DUP C@ DUP 96 > OVER 123 < AND IF 32 - THEN SWAP C! LOOP R> ;
: [ELSE] ( --- )
  1 BEGIN
    BEGIN BL WORD COUNT DUP WHILE  [IF]-UP
      2DUP S" [IF]" COMPARE 0= IF 2DROP 1+ ELSE
      2DUP S" [ELSE]" COMPARE 0= IF 2DROP 1- DUP IF 1+ THEN ELSE
      S" [THEN]" COMPARE 0= IF 1- THEN THEN THEN
      ?DUP 0= IF EXIT THEN
    REPEAT 2DROP
  REFILL 0= UNTIL DROP ; IMMEDIATE
: [IF] ( flag --- )  0= IF POSTPONE [ELSE] THEN ; IMMEDIATE
: [THEN] ( --- ) ; IMMEDIATE
: ENVIRONMENT? ( c-addr u -- false | i*x true )
  2DUP S" MAX-U" COMPARE 0= IF 2DROP -1 TRUE EXIT THEN
  2DUP S" MAX-UD" COMPARE 0= IF 2DROP -1 -1 TRUE EXIT THEN
  2DUP S" MAX-N" COMPARE 0= IF 2DROP -1 1 RSHIFT TRUE EXIT THEN
  2DROP FALSE ;
: DEFER! >BODY ! ;  : DEFER@ >BODY @ ;
: SAVE-INPUT >IN @ 1 ;  : RESTORE-INPUT DROP >IN ! FALSE ;
: D= ROT = >R = R> AND ;
: .R ( n w -- ) >R DUP ABS 0 <# #S ROT SIGN #> R> OVER - 0 MAX SPACES TYPE ;
: U.R ( u w -- ) >R 0 <# #S #> R> OVER - 0 MAX SPACES TYPE ;
: 2VARIABLE CREATE 0 , 0 , ;  : 2LITERAL SWAP POSTPONE LITERAL POSTPONE LITERAL ; IMMEDIATE
: D0= OR 0= ;  : D0< NIP 0< ;  : D2* 2DUP D+ ;  : DABS DUP 0< IF DNEGATE THEN ;
