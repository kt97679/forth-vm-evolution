S" extend.4" INCLUDED
S" coreext.4" INCLUDED
: CELL 1 CELLS ;  : CELL- 1 CELLS - ;  : -ROT ROT ROT ;  : 2NIP ROT DROP ROT DROP ;
: ON TRUE SWAP ! ;  : OFF 0 SWAP ! ;  : BOUNDS OVER + SWAP ;  : UNDER+ ROT + SWAP ;
: TOLOWER DUP [CHAR] A [CHAR] Z 1+ WITHIN IF 32 + THEN ;
: INCLUDE PARSE-NAME INCLUDED ;  : REQUIRE INCLUDE ;
: [DEFINED] BL WORD FIND NIP 0<> ; IMMEDIATE  : [UNDEFINED] POSTPONE [DEFINED] 0= ; IMMEDIATE
: MS DROP ;  : KEY? FALSE ;  : PAGE ;  : TIME&DATE 0 0 0 1 1 2000 ;  : UTIME 0 0 ;
VARIABLE MSC  : MS@ 1 MSC +! MSC @ ;  : COUNTER MS@ ;  : TIMER@ MS@ ;  : UNUSED 1000000 ;
: DEFER! >BODY ! ;  : DEFER@ >BODY @ ;  : FALIGNED ALIGNED ;  : FALIGN ALIGN ;  : FLOATS 8 * ;  : FLOAT+ 8 + ;
: ENVIRONMENT? ( c-addr u -- false | i*x true )
  2DUP S" MAX-U" COMPARE 0= IF 2DROP -1 TRUE EXIT THEN
  2DUP S" MAX-UD" COMPARE 0= IF 2DROP -1 -1 TRUE EXIT THEN
  2DUP S" MAX-N" COMPARE 0= IF 2DROP -1 1 RSHIFT TRUE EXIT THEN
  ENVIRONMENT? ;
: DFALIGNED ALIGNED ;  : DFALIGN ALIGN ;  : SFALIGNED ALIGNED ;  : SFALIGN ALIGN ;
: DFLOATS 8 * ;  : DFLOAT+ 8 + ;  : SFLOATS 4 * ;
